---
import Turtle from "./Turtle.astro";

interface Props {
  lang: "tr" | "en";
}

const { lang } = Astro.props;

const t = {
  tr: {
    eyebrow: "İletişim",
    heading: "İletişim",
    lede: "Hata bildirimleri ve katkılar GitHub üzerinden. Diğer konular için e-posta.",
    made: "Yapımcılar",
    licence: "GPL-3.0 lisansı altında yayımlanır. Debian 13 “trixie” tabanlıdır.",
    channels: [
      { key: "github", label: "GitHub", sub: "Kaynak kod, sürümler, hata kaydı" },
      { key: "youtube", label: "YouTube", sub: "Anlatım videoları" },
      { key: "instagram", label: "Instagram", sub: "Duyurular" },
      { key: "mail", label: "E-posta", sub: "Genel iletişim" },
    ],
  },
  en: {
    eyebrow: "Contact",
    heading: "Contact",
    lede: "Bug reports and contributions go through GitHub. Everything else by email.",
    made: "Built by",
    licence: "Released under the GPL-3.0 licence. Based on Debian 13 “trixie”.",
    channels: [
      { key: "github", label: "GitHub", sub: "Source, releases, issue tracker" },
      { key: "youtube", label: "YouTube", sub: "Walkthrough videos" },
      { key: "instagram", label: "Instagram", sub: "Announcements" },
      { key: "mail", label: "Email", sub: "General enquiries" },
    ],
  },
}[lang];

const urls: Record<string, { href: string; display: string }> = {
  github: {
    href: "https://github.com/MiracLight/CarotOS",
    display: "github.com/MiracLight/CarotOS",
  },
  youtube: {
    href: "https://www.youtube.com/@CarotOSproject",
    display: "youtube.com/@CarotOSproject",
  },
  instagram: {
    href: "https://www.instagram.com/carotosproject/",
    display: "instagram.com/carotosproject",
  },
  mail: {
    href: "mailto:carotosproject@gmail.com",
    display: "carotosproject@gmail.com",
  },
};

const makers = ["Yusuf Miraç Üzümcüler", "Metin Ege Boyar"];
const year = new Date().getFullYear();
---

<footer class="band band--abyss foot">
  {/* Dipte süzülen kaplumbağalar */}
  <div class="foot__swimmers" aria-hidden="true">
    <div class="foot__swimmer foot__swimmer--a">
      <Turtle shell="#ffffff" body="#ffffff" />
    </div>
    <div class="foot__swimmer foot__swimmer--b">
      <Turtle shell="#ffffff" body="#ffffff" />
    </div>
  </div>

  <div class="wrap foot__inner">
    <div class="foot__head">
      <p class="eyebrow">{t.eyebrow}</p>
      <h2>{t.heading}</h2>
      <p class="lede">{t.lede}</p>
    </div>

    <ul class="chan">
      {
        t.channels.map((c) => (
          <li>
            <a
              class="chan__link"
              href={urls[c.key].href}
              rel={c.key === "mail" ? undefined : "noopener noreferrer"}
              target={c.key === "mail" ? undefined : "_blank"}
            >
              <span class="chan__icon">
                {c.key === "github" && (
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path
                      fill="currentColor"
                      d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.21.09 1.84 1.24 1.84 1.24 1.07 1.84 2.81 1.31 3.5 1 .11-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.11-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.65 1.66.24 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.61-2.8 5.62-5.48 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58A12 12 0 0 0 24 12.5C24 5.87 18.63.5 12 .5Z"
                    />
                  </svg>
                )}
                {c.key === "youtube" && (
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path
                      fill="currentColor"
                      d="M23.5 6.2a3 3 0 0 0-2.12-2.12C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.53A3 3 0 0 0 .5 6.2C0 8.08 0 12 0 12s0 3.92.5 5.8a3 3 0 0 0 2.12 2.12c1.88.53 9.38.53 9.38.53s7.5 0 9.38-.53a3 3 0 0 0 2.12-2.12C24 15.92 24 12 24 12s0-3.92-.5-5.8ZM9.6 15.6V8.4l6.24 3.6-6.24 3.6Z"
                    />
                  </svg>
                )}
                {c.key === "instagram" && (
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <rect
                      x="2.6"
                      y="2.6"
                      width="18.8"
                      height="18.8"
                      rx="5.4"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.9"
                    />
                    <circle
                      cx="12"
                      cy="12"
                      r="4.3"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.9"
                    />
                    <circle cx="17.5" cy="6.6" r="1.3" fill="currentColor" />
                  </svg>
                )}
                {c.key === "mail" && (
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <rect
                      x="2.3"
                      y="4.6"
                      width="19.4"
                      height="14.8"
                      rx="2.8"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.9"
                    />
                    <path
                      d="M3.4 7.2 12 13.2l8.6-6"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.9"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                )}
              </span>
              <span class="chan__text">
                <span class="chan__label">{c.label}</span>
                <span class="chan__sub">{c.sub}</span>
                <span class="chan__url">{urls[c.key].display}</span>
              </span>
              <span class="chan__arrow" aria-hidden="true">
                →
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="foot__base">
      <div class="foot__makers">
        <p class="foot__makers-label">{t.made}</p>
        <p class="foot__makers-names">
          {
            makers.map((m, i) => (
              <>
                <span>{m}</span>
                {i < makers.length - 1 && <span class="foot__dot"> · </span>}
              </>
            ))
          }
        </p>
      </div>
      <p class="foot__legal">
        © {year} CarotOS. {t.licence}
      </p>
    </div>
  </div>
</footer>

<style>
  .foot {
    position: relative;
    overflow: hidden;
  }

  .foot__inner {
    position: relative;
    z-index: 1;
  }

  /* --- Dipte süzülen kaplumbağalar --- */
  .foot__swimmers {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .foot__swimmer {
    position: absolute;
    opacity: 0.05;
    line-height: 0;
  }

  .foot__swimmer :global(svg) {
    width: 100%;
    height: auto;
    display: block;
  }

  .foot__swimmer--a {
    width: 190px;
    top: 9%;
    right: -34px;
    animation: drift 22s ease-in-out infinite;
  }

  .foot__swimmer--b {
    width: 115px;
    bottom: 8%;
    left: -22px;
    animation: drift 30s ease-in-out infinite reverse;
  }

  @keyframes drift {
    0%,
    100% {
      transform: translate(0, 0) rotate(12deg);
    }
    50% {
      transform: translate(-18px, -22px) rotate(20deg);
    }
  }

  .foot__head {
    max-width: var(--w-text);
  }

  .foot__head h2 {
    margin-bottom: 0.9rem;
  }

  /* --- İletişim kanalları --- */
  .chan {
    list-style: none;
    margin: 3.2rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.9rem;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  }

  .chan__link {
    display: flex;
    align-items: center;
    gap: 1.05rem;
    padding: 1.1rem 1.3rem;
    border: 1.5px solid rgba(169, 198, 224, 0.24);
    border-radius: var(--r-md);
    text-decoration: none;
    color: var(--on-dark);
    background: rgba(255, 255, 255, 0.035);
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease,
      transform 0.2s ease;
  }

  .chan__link:hover {
    border-color: var(--kelp);
    background: rgba(169, 219, 196, 0.09);
    transform: translateY(-2px);
  }

  .chan__icon {
    flex: none;
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    border-radius: 11px;
    background: rgba(169, 219, 196, 0.14);
    color: var(--kelp);
  }

  .chan__icon svg {
    width: 22px;
    height: 22px;
    display: block;
  }

  .chan__text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .chan__label {
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.3;
  }

  .chan__sub {
    font-size: 0.85rem;
    color: var(--on-dark-soft);
    line-height: 1.4;
  }

  .chan__url {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: rgba(169, 198, 224, 0.62);
    margin-top: 0.22rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .chan__arrow {
    margin-left: auto;
    flex: none;
    color: var(--kelp);
    font-size: 1.15rem;
    opacity: 0;
    transform: translateX(-6px);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  .chan__link:hover .chan__arrow {
    opacity: 1;
    transform: translateX(0);
  }

  /* --- Yapımcılar --- */
  .foot__base {
    margin-top: 3.6rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(169, 198, 224, 0.18);
    display: flex;
    flex-wrap: wrap;
    gap: 1.6rem 2.5rem;
    align-items: flex-end;
    justify-content: space-between;
  }

  .foot__makers-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(169, 198, 224, 0.6);
    margin: 0 0 0.45rem;
  }

  .foot__makers-names {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    letter-spacing: -0.015em;
    color: var(--on-dark);
  }

  .foot__dot {
    color: var(--kelp);
  }

  .foot__legal {
    margin: 0;
    font-size: 0.82rem;
    color: rgba(169, 198, 224, 0.55);
    max-width: 44ch;
  }
</style>
