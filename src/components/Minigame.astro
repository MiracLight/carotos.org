---
/**
 * Gizli mini oyun penceresi.
 *
 * Menüde ya da sayfada görünür bir bağlantısı yoktur. data-minigame-trigger
 * özniteliği olan bir öğeye kısa sürede 5 kez tıklanınca açılır.
 * Oyun kodu ancak o zaman indirilir (dinamik import).
 */
interface Props {
  lang: "tr" | "en";
}

const { lang } = Astro.props;

const t = {
  tr: {
    label: "Gizli oyun: Denize ulaş",
    close: "Kapat",
    mute: "Sesi aç/kapat",
    level: "Bölüm",
    hint: "← → veya kaydır",
    reached: "Denize ulaşıldı!",
    variants: ["Kumsal", "Kayalık", "Sürüntü", "Gelgit Havuzu", "Mercan Kıyısı", "Gece Kumsalı", "Fırtına Kıyısı", "Atık Kıyısı", "Kumul Rüzgârı"],
    pu: { shield: "Kalkan", shieldBreak: "Kalkan korudu!", magnet: "Mıknatıs", surf: "Dalga ritmi", plastic: "Plastik: ağırlaştın" },
    introTitle: "Yumurtadan çıktı, deniz ileride.",
    introText: "Yavru kaplumbağayı engellerden kaçırarak denize ulaştır. Parlayan baloncukları topla, kırmızı kesikli halkalı plastik atıklardan kaçın. Her bölüm bir öncekinden daha uzun ve hızlı.",
    start: "Başla",
    doneTitle: (n: number) => `Bölüm ${n} tamamlandı`,
    doneLead: "Denize ulaşıldı!",
    tipLabel: "Güvenlik ipucu",
    parts: "Toplanan kabuk parçası",
    next: "Sonraki bölüm",
    overTitle: "Yavru denize ulaşamadı",
    overText: "Bütün canlar tükendi. Aynı bölümü yeniden deneyebilirsin.",
    retry: "Tekrar dene",
    best: "En iyi",
    stars: {
      aria: "3 yıldızdan {n} tanesi",
      next2: "2. yıldız için: en fazla 1 çarpma",
      next3: "3. yıldız için: hiç çarpmadan, parçaların yarısını topla",
      record: "Yeni rekor!",
      total: "Toplam yıldız",
    },
  },
  en: {
    label: "Hidden game: Reach the sea",
    close: "Close",
    mute: "Toggle sound",
    level: "Level",
    hint: "← → or swipe",
    reached: "You reached the sea!",
    variants: ["Shoreline", "Rocky Cove", "Driftwood Beach", "Tide Pools", "Coral Shore", "Moonlit Beach", "Storm Coast", "Litter Shore", "Windy Dunes"],
    pu: { shield: "Shield", shieldBreak: "Shield saved you!", magnet: "Magnet", surf: "Wave rush", plastic: "Plastic: weighed down" },
    introTitle: "Hatched. The sea is ahead.",
    introText: "Guide the hatchling past the obstacles to the sea. Collect the glowing bubbles and avoid plastic waste in the red dashed ring. Each level is longer and faster than the last.",
    start: "Start",
    doneTitle: (n: number) => `Level ${n} complete`,
    doneLead: "You reached the sea!",
    tipLabel: "Security tip",
    parts: "Shell pieces collected",
    next: "Next level",
    overTitle: "The hatchling didn't make it",
    overText: "All lives are gone. You can try the same level again.",
    retry: "Try again",
    best: "Best",
    stars: {
      aria: "{n} of 3 stars",
      next2: "Next star: at most 1 hit",
      next3: "Next star: no hits and collect half the shell pieces",
      record: "New best!",
      total: "Total stars",
    },
  },
}[lang];

// Fonksiyonlar istemciye JSON ile gidemez; metinleri düz veriye çeviriyoruz.
const veri = {
  level: t.level,
  hint: t.hint,
  reached: t.reached,
  variants: t.variants,
  pu: t.pu,
  lang,
  doneTitle: lang === "tr" ? "Bölüm {n} tamamlandı" : "Level {n} complete",
  best: t.best,
  parts: t.parts,
  stars: t.stars,
};
---

<dialog class="mg" id="mg" aria-label={t.label}>
  <div class="mg__frame">
    <button class="mg__close" type="button" id="mg-close" aria-label={t.close}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"></path>
      </svg>
    </button>

    <button class="mg__mute" type="button" id="mg-mute" aria-pressed="false" aria-label={t.mute}>
      <svg class="mg__ic-on" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M4 9.5v5h3.5L12 18.5v-13L7.5 9.5H4z" fill="currentColor"></path>
        <path d="M15.5 9a4 4 0 0 1 0 6M18 6.5a7.5 7.5 0 0 1 0 11" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
      </svg>
      <svg class="mg__ic-off" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M4 9.5v5h3.5L12 18.5v-13L7.5 9.5H4z" fill="currentColor"></path>
        <path d="M16 9.5l5 5M21 9.5l-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
      </svg>
    </button>

    <div class="mg__stage">
      <canvas class="mg__canvas" id="mg-canvas" aria-hidden="true"></canvas>

      <div class="mg__panel" id="mg-panel" data-mode="intro">
        <div class="mg__card">
          <h2 class="mg__title" id="mg-title">{t.introTitle}</h2>
          <p class="mg__text" id="mg-text">{t.introText}</p>
          <div class="mg__stars" id="mg-stars" hidden role="img">
            {[0, 1, 2].map((i) => (
              <svg class="mg__star" style={`--i:${i}`} viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 2.8l2.8 5.9 6.4.9-4.7 4.5 1.2 6.4L12 17.4 6.3 20.5l1.2-6.4L2.8 9.6l6.4-.9z" stroke-linejoin="round"></path>
              </svg>
            ))}
          </div>
          <p class="mg__starhint" id="mg-starhint" hidden></p>
          <div class="mg__tip" id="mg-tip" hidden>
            <span class="mg__tip-label">{t.tipLabel}</span>
            <span id="mg-tip-text"></span>
          </div>
          <p class="mg__meta" id="mg-meta" hidden></p>
          <button class="btn btn--solid mg__btn" type="button" id="mg-btn">{t.start}</button>
        </div>
      </div>

      <p class="visually-hidden" id="mg-live" aria-live="polite"></p>
    </div>
  </div>
</dialog>

<script
  type="application/json"
  id="mg-data"
  set:html={JSON.stringify({
    ...veri,
    start: t.start,
    next: t.next,
    retry: t.retry,
    introTitle: t.introTitle,
    introText: t.introText,
    overTitle: t.overTitle,
    overText: t.overText,
  })}
/>

<script>
  const dlg = document.getElementById("mg") as HTMLDialogElement | null;
  const triggers = document.querySelectorAll<HTMLElement>("[data-minigame-trigger]");

  if (dlg && triggers.length) {
    const data = JSON.parse(document.getElementById("mg-data")!.textContent || "{}");
    const canvas = document.getElementById("mg-canvas") as HTMLCanvasElement;
    const panel = document.getElementById("mg-panel")!;
    const title = document.getElementById("mg-title")!;
    const text = document.getElementById("mg-text")!;
    const tip = document.getElementById("mg-tip")!;
    const tipText = document.getElementById("mg-tip-text")!;
    const meta = document.getElementById("mg-meta")!;
    const btn = document.getElementById("mg-btn") as HTMLButtonElement;
    const live = document.getElementById("mg-live")!;

    const KEY = "carotos-oyun-en-iyi";
    const readBest = (): number => {
      try {
        return Number(localStorage.getItem(KEY)) || 0;
      } catch {
        return 0;
      }
    };
    const writeBest = (n: number) => {
      try {
        localStorage.setItem(KEY, String(n));
      } catch {
        /* depolama kapalı olabilir */
      }
    };

    const MKEY = "carotos-oyun-sessiz";
    let muted = false;
    try {
      muted = localStorage.getItem(MKEY) === "1";
    } catch {
      /* depolama kapalı olabilir */
    }
    const muteBtn = document.getElementById("mg-mute") as HTMLButtonElement;
    const paintMute = () => muteBtn.setAttribute("aria-pressed", String(muted));
    paintMute();
    muteBtn.addEventListener("click", () => {
      muted = !muted;
      paintMute();
      try {
        localStorage.setItem(MKEY, muted ? "1" : "0");
      } catch {
        /* yok say */
      }
      if (game) game.setMuted(muted);
      btn.focus();
    });

    // Bölüm başına en iyi yıldız sayısı
    const SKEY = "carotos-oyun-yildiz";
    const readStars = (): Record<string, number> => {
      try {
        return JSON.parse(localStorage.getItem(SKEY) || "{}") || {};
      } catch {
        return {};
      }
    };
    const writeStars = (m: Record<string, number>) => {
      try {
        localStorage.setItem(SKEY, JSON.stringify(m));
      } catch {
        /* yok say */
      }
    };
    const totalStars = () =>
      Object.values(readStars()).reduce((a, b) => a + (Number(b) || 0), 0);
    const starsEl = document.getElementById("mg-stars")!;
    const starHint = document.getElementById("mg-starhint")!;
    const paintStars = (n: number) => {
      starsEl.hidden = false;
      starsEl.setAttribute("aria-label", data.stars.aria.replace("{n}", String(n)));
      starsEl.querySelectorAll(".mg__star").forEach((el, i) => {
        el.classList.remove("on");
        // animasyonu yeniden başlatmak için bir kare bekle
        requestAnimationFrame(() => el.classList.toggle("on", i < n));
      });
      starHint.hidden = n >= 3;
      starHint.textContent = n === 1 ? data.stars.next2 : n === 2 ? data.stars.next3 : "";
    };

    let game: any = null;
    let level = 1;
    let mode: "intro" | "done" | "over" = "intro";

    const showPanel = (m: "intro" | "done" | "over", o: any = {}) => {
      mode = m;
      panel.dataset.mode = m;
      tip.hidden = m !== "done";
      starsEl.hidden = true;
      starHint.hidden = true;
      meta.hidden = true;
      if (m === "intro") {
        title.textContent = data.introTitle;
        text.textContent = data.introText;
        btn.textContent = data.start;
        const best = readBest();
        if (best > 1) {
          meta.hidden = false;
          meta.textContent = `${data.best}: ${data.level} ${best} · ${data.stars.total}: ${totalStars()}`;
        }
      } else if (m === "done") {
        title.textContent = data.doneTitle.replace("{n}", String(o.level));
        text.textContent = data.reached;
        // İpuçları ayrı bir modülde; bölüm sonunda tembel yüklenir
        tipText.textContent = "";
        tip.hidden = true;
        import("../scripts/minigame-tips.js")
          .then((m) => {
            if (mode !== "done") return;
            tipText.textContent = m.pickTip(data.lang);
            tip.hidden = false;
          })
          .catch(() => {
            /* ipucu yüklenemezse panel ipucusuz da çalışır */
          });
        const saved = readStars();
        const record = o.stars > (saved[o.level] || 0);
        if (record) {
          saved[o.level] = o.stars;
          writeStars(saved);
        }
        paintStars(o.stars);
        meta.hidden = false;
        meta.textContent = `${data.parts}: ${o.parts} / ${o.total}${record ? " · " + data.stars.record : ""}`;
        btn.textContent = data.next;
        live.textContent = `${data.doneTitle.replace("{n}", String(o.level))}. ${data.reached} ${data.stars.aria.replace("{n}", String(o.stars))}`;
      } else {
        title.textContent = data.overTitle;
        text.textContent = data.overText;
        btn.textContent = data.retry;
        live.textContent = data.overTitle;
      }
      panel.hidden = false;
      btn.focus();
    };

    const begin = (n: number) => {
      level = n;
      panel.hidden = true;
      live.textContent = `${data.level} ${n}`;
      game.start(n);
    };

    btn.addEventListener("click", () => {
      if (!game) return;
      if (mode === "intro") begin(1);
      else if (mode === "done") begin(level + 1);
      else begin(level);
    });

    const open = async () => {
      if (dlg.open) return;
      dlg.showModal();
      document.documentElement.style.overflow = "hidden";
      if (!game) {
        const mod = await import("../scripts/minigame.js");
        game = mod.createGame(canvas, {
          muted,
          strings: {
            level: data.level,
            hint: data.hint,
            reached: data.reached,
            variants: data.variants,
            pu: data.pu,
          },
          onComplete: (r: any) => {
            level = r.level;
            if (r.level + 1 > readBest()) writeBest(r.level + 1);
            showPanel("done", r);
          },
          onOver: () => showPanel("over"),
        });
      }
      game.fit();
      showPanel("intro");
    };

    const close = () => {
      if (dlg.open) dlg.close();
    };
    dlg.addEventListener("close", () => {
      document.documentElement.style.overflow = "";
      if (game) {
        game.destroy();
        game = null;
      }
    });
    document.getElementById("mg-close")!.addEventListener("click", close);
    dlg.addEventListener("click", (e) => {
      if (e.target === dlg) close();
    });

    // Gizli tetikleyici: aralıkları 1,6 sn'yi geçmeyen 5 basış.
    // Belge düzeyinde pointerdown dinlenir: kaplumbağa süzülürken fare
    // basılı/bırakılı noktalar kaysa bile ya da hızlı dokunuşlarda olay kaçmaz.
    let count = 0;
    let lastTap = 0;
    document.addEventListener(
      "pointerdown",
      (e) => {
        const hedef = e.target as Element | null;
        if (!hedef || !hedef.closest("[data-minigame-trigger]")) return;
        const now = Date.now();
        count = now - lastTap < 1600 ? count + 1 : 1;
        lastTap = now;
        if (count >= 5) {
          count = 0;
          open();
        }
      },
      { passive: true },
    );
  }
</script>

<style is:global>
  [data-minigame-trigger] {
    touch-action: manipulation;
    user-select: none;
    -webkit-user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  .mg {
    padding: 0;
    border: 0;
    background: transparent;
    max-width: none;
    max-height: none;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .mg:not([open]) {
    display: none;
  }

  .mg::backdrop {
    background: rgba(5, 22, 40, 0.82);
    backdrop-filter: blur(3px);
  }

  .mg[open] {
    display: grid;
    place-items: center;
  }

  .mg__frame {
    position: relative;
  }

  .mg__close {
    position: absolute;
    top: -14px;
    right: -14px;
    z-index: 3;
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 2px solid var(--on-dark);
    background: var(--deep);
    color: var(--on-dark);
    cursor: pointer;
  }

  .mg__mute {
    position: absolute;
    top: -14px;
    left: -14px;
    z-index: 3;
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 2px solid var(--on-dark);
    background: var(--deep);
    color: var(--on-dark);
    cursor: pointer;
  }

  .mg__mute:hover {
    background: var(--current);
  }

  .mg__mute:focus-visible {
    outline: 3px solid var(--kelp);
    outline-offset: 3px;
  }

  .mg__mute .mg__ic-off,
  .mg__mute[aria-pressed="true"] .mg__ic-on {
    display: none;
  }

  .mg__mute[aria-pressed="true"] .mg__ic-off {
    display: block;
  }

  .mg__close:hover {
    background: var(--current);
  }

  .mg__close:focus-visible,
  .mg__btn:focus-visible {
    outline: 3px solid var(--kelp);
    outline-offset: 3px;
  }

  .mg__stage {
    position: relative;
    width: min(94vw, calc(88vh * 0.5625), 405px);
    aspect-ratio: 9 / 16;
    border-radius: var(--r-lg);
    overflow: hidden;
    border: 3px solid var(--on-dark);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
    background: #ecdcae;
    touch-action: none;
  }

  .mg__canvas {
    display: block;
    width: 100%;
    height: 100%;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
  }

  .mg__panel {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 1.2rem;
    background: rgba(5, 22, 40, 0.55);
  }

  .mg__panel[hidden] {
    display: none;
  }

  .mg__card {
    width: 100%;
    background: var(--foam);
    border-radius: var(--r-md);
    padding: 1.4rem 1.3rem 1.3rem;
    text-align: center;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
  }

  .mg__title {
    margin: 0 0 0.55rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.35rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--deep);
  }

  .mg__text {
    margin: 0 0 1.1rem;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--ink-soft);
  }

  .mg__tip {
    display: grid;
    gap: 0.25rem;
    margin: 0 0 0.9rem;
    padding: 0.7rem 0.8rem;
    border-radius: var(--r-sm);
    background: var(--shallow);
    border-left: 3px solid var(--kelp-dark);
    text-align: left;
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--ink);
  }

  .mg__tip[hidden],
  .mg__meta[hidden],
  .mg__stars[hidden],
  .mg__starhint[hidden] {
    display: none;
  }

  .mg__stars {
    display: flex;
    justify-content: center;
    gap: 0.35rem;
    margin: 0 0 0.45rem;
  }

  .mg__star {
    width: 40px;
    height: 40px;
    fill: none;
    stroke: var(--ink-faint);
    stroke-width: 1.6;
    opacity: 0.55;
    transition: fill 0.2s, stroke 0.2s, opacity 0.2s;
  }

  .mg__star.on {
    fill: #f5b942;
    stroke: #c98a1c;
    opacity: 1;
    animation: mg-star-pop 0.5s cubic-bezier(0.2, 1.6, 0.4, 1) both;
    animation-delay: calc(var(--i) * 0.18s + 0.15s);
  }

  @keyframes mg-star-pop {
    0% {
      transform: scale(0.2) rotate(-40deg);
    }
    100% {
      transform: scale(1) rotate(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mg__star.on {
      animation: none;
    }
  }

  .mg__starhint {
    margin: 0 0 0.9rem;
    font-size: 0.82rem;
    line-height: 1.4;
    color: var(--ink-soft);
  }

  .mg__tip-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--kelp-dark);
  }

  .mg__meta {
    margin: 0 0 1rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink-faint);
  }

  .mg__btn {
    width: 100%;
    justify-content: center;
  }

  @media (max-width: 480px) {
    /* Küçük ekranda üst köşe canlara ait; kapat düğmesi alt köşede */
    .mg__close {
      top: auto;
      bottom: 12px;
      right: 12px;
      width: 38px;
      height: 38px;
    }

    .mg__mute {
      top: auto;
      bottom: 12px;
      left: 12px;
    }
  }
</style>
