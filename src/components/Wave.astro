---
/**
 * İki renk bandı arasındaki dalga geçişi.
 *
 * from = üstteki bandın rengi (dalganın üstünde kalan boşluk)
 * to   = alttaki bandın rengi (dalganın gövdesi)
 *
 * İki katman kullanılıyor: arkadaki soluk dalga derinlik hissi veriyor.
 */
interface Props {
  from: string;
  to: string;
}

const { from, to } = Astro.props;
---

<div class="wave-wrap" style={`background:${from}`}>
  <svg
    class="wave"
    viewBox="0 0 1440 120"
    preserveAspectRatio="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <path
      d="M0,72 C210,116 400,28 640,58 C880,88 1120,20 1440,64 L1440,120 L0,120 Z"
      fill={to}
      opacity="0.42"></path>
    <path
      d="M0,88 C260,44 460,110 720,80 C980,50 1180,104 1440,78 L1440,120 L0,120 Z"
      fill={to}></path>
  </svg>
</div>

<style>
  .wave-wrap {
    line-height: 0;
    margin-bottom: -1px;
  }
</style>
