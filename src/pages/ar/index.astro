    text: "تطبيق مضاد للفيروسات يعتمد على ClamAV. يوفر فحصاً سريعاً، وفحصاً لمجلد الصفحة الرئيسية، وفحصاً لأي مجلد تختاره. يتم نقل الملفات المصابة إلى الحجر الصحي، وتُحدث تعريفات الفيروسات من التطبيق، ويتم الاحتفاظ بسجل عمليات الفحص السابقة. لا يقوم بتثبيت أي خدمة في الخلفية ويفحص فقط عند تشغيله. تظهر النتيجة النظيفة فقط إذا انتهى الفحص دون مشاكل.",
  },
  {
    title: "CarotPot",
    icon: "/ikonlar/ikon-carotpot.webp",
    yeni: "1.3",
    text: "نظام فخ يلتقط الأنشطة المشبوهة على شبكتك المحلية. يقوم بفتح خدمات وهمية مثل SSH وTelnet وFTP وMySQL، ويسجل الأجهزة التي تتصل بها وينبهك. لا يمكن لأي شخص تسجيل الدخول فعلياً. كما ينبهك عند فتح أو تغيير ملف تمويهي، ولا يبدأ تلقائياً عند الإقلاع. يحصل كل مهاجم على درجة مخاطرة وجدول زمني؛ يمكنك حظرهم، أو حظرهم لفترة محددة، أو إضافة ملاحظة.",
  },
  {
    title: "Filenor",
    icon: "/ikonlar/ikon-filenor.webp",
    yeni: "1.3",
    text: "محول لملفات الصور، الصوت، الفيديو، المستندات، الجداول البيانات، العروض التقديمية والخطوط، وكل ذلك من واجهة واحدة. يمكنه دمج، تقسيم، تدوير، تصغير وقفل ملفات PDF وتشغيل التعرف على النصوص (OCR) على المستندات الممسوحة ضوئياً. لا يقوم أبداً بالكتابة فوق ملف موجود، وتتوفر نسخة سطر الأوامر. يأتي مثبتاً مسبقاً على CarotOS ويمكن أيضاً تحميله لأنظمة Debian وUbuntu وWindows.",
    links: [
      { label: "تحميل Filenor (.deb و Windows .exe)", url: "https://github.com/MiracLight/filenor/releases/latest" },
      { label: "الكود المصدري", url: "https://github.com/MiracLight/filenor" },
    ],
  },
  {
    title: "CarotOS Former",
    icon: "/ikonlar/ikon-former.webp",
    yeni: "1.3",
    text: "دليل يعلمك أدوات الأمن باستخدام الرسوم المتحركة. تحتوي كل أداة في Security Panel، بالإضافة إلى CarotPot و Carotene، على شرح، ورسم متحرك قابل للتشغيل، وقسم ”جربها بنفسك”. تتضمن المواضيع مسابقات CTF، و Command Explainer، والأخلاقيات، وتشفير الأقراص، والتحقق من ISO، ومنظور المدافع. يدعم النظام إحدى عشرة لغة.",
  },
  {
    title: "CarotOS GSD",
    icon: "/ikonlar/ikon-gsd.webp",
    yeni: "1.3",
    text: "قاموس النظام العام، ويحتوي على 197 مصطلحاً حول Linux، والشبكات، والأمن السيبراني، والتشفير، وعلوم الحاسوب. يمكنك البحث عن المصطلحات، ورؤية الأوامر الأمثلة، والانتقال إلى المصطلحات ذات الصلة. متاح بإحدى عشرة لغة.",
  },
];

const poligonApps = [
  {
    title: "CarotOS Poligon",
    icon: "/ikonlar/ikon-poligon-ogrenci.webp",
    screenshot: "/ekranlar/poligon-ogrenci.webp",
    alt: "تطبيق CarotOS Poligon للطلاب: خيارات الضيف، وإنشاء حساب، وتسجيل الدخول",
    text: "يمكنك استخدامه كضيف بدون حساب، أو تسجيل الدخول بحساب مستخدم. يتم حفظ التقدم للحسابات المسجلة. يمكن إكمال المهام بمفردك أو عبر الانضمام إلى غرفة الفصل الدراسي.",
  },
  {
    title: "CarotOS Poligon (المعلم)",
    icon: "/ikonlar/ikon-poligon-ogretmen.webp",
    screenshot: "/ekranlar/poligon-ogretmen.webp",
    alt: "تطبيق المعلم في CarotOS Poligon: رمز الغرفة، كلمة مرور الغرفة، قائمة الطلاب وحقل التلميح",
    text: "يتم إنشاء رمز وكلمة مرور للغرفة بنقرة واحدة. تتوفر طرق عرض الطلاب والفصول، وتأليف الأسئلة والأسئلة المحفوظة في تبويبات منفصلة. يمكن إرسال تلميح لطالب واحد أو للفصل بأكمله.",
  },
];

const securityApps = [
  {
    title: "CarotPot",
    icon: "/ikonlar/ikon-carotpot.webp",
    screenshot: "/ekranlar/carotpot.webp",
    ratio: "1280 / 820",
    alt: "لوحة تحكم CarotPot: الفخاخ قيد التشغيل، مخطط النشاط بالساعة، الأحداث لكل فخ، المهاجمون الأكثر نشاطاً وخلاصة مباشرة",
    text: "يكتشف الأجهزة على الشبكة المحلية التي تفحص هذا الكمبيوتر أو تحاول تسجيل الدخول إليه. يفتح ثماني خدمات وهمية: SSH، لوحة الويب، Telnet، FTP، VNC، RDP، MySQL و Redis. تعرض لوحة التحكم نشاط آخر 24 ساعة والمهاجمين الأكثر نشاطاً. يعرض ملف تعريف المهاجم أسماء المستخدمين التي تم تجربتها، كلمات المرور المقنعة ودرجة المخاطر. يتطلب حظر جهاز تأكيدك.",
  },
  {
    title: "Carotene",
    icon: "/ikonlar/ikon-carotene.webp",
    screenshot: "/ekranlar/carotene.webp",
    ratio: "1040 / 700",
    alt: "Carotene: نتيجة فحص مع العثور على تهديدين، عمر تعريفات الفيروسات وخيارات الفحص",
    text: "يقوم بإجراء فحص سريع لمجلدات المنزل والمجلدات المخصصة باستخدام ClamAV. أثناء الفحص، يتم تحديث عدد الملفات المفحوصة والنتائج مباشرة. يمكن وضع الملفات المكتشفة في الحجر الصحي، أو حذفها، أو تجاهلها. يتم عرض عمر تعريفات الفيروسات على الشاشة الرئيسية، ويمكن تحديثها من التطبيق. النتيجة النظيفة لا تضمن سلامة الملفات، بل تشير فقط إلى عدم العثور على أي توقيع معروف.",
  },
];

const tools = [
  { name: "nmap", job: "فحص الشبكة والمنافذ" },
  { name: "tcpdump", job: "التقاط الحزم" },
  { name: "tshark", job: "تحليل حركة المرور" },
  { name: "aircrack-ng", job: "اختبار الشبكات اللاسلكية" },
  { name: "nikto", job: "فحص خوادم الويب" },
  { name: "sqlmap", job: "اختبار حقن SQL" },
  { name: "john", job: "تحليل قوة كلمة المرور" },
  { name: "hydra", job: "اختبار المصادقة" },
  { name: "ufw", job: "جدار الحماية" },
  { name: "fail2ban", job: "منع التسلل" },
];
---

<Base
  lang="ar"
  title="CarotOS | توزيعة Linux لتعلم الأمن السيبراني"
  description="توزيعة Linux تعليمية مبنية على Debian 13، تحتوي على عشر أدوات أمنية وثلاث عشرة تطبيقات أصلية."
>
  {/* ============================================================
      HERO
      ============================================================ */}
  <section class="band band--foam hero">
    <div class="wrap hero__inner">
      <div class="hero__text">
        <p class="eyebrow">Debian 13 · XFCE · amd64</p>
        <h1>قليلة، ومُشروحة جيداً.</h1>
        <p class="lede hero__lede">
          CarotOS هي توزيعة Linux مصممة للتعليم في مجال الأمن السيبراني. تتضمن عشر أدوات أمنية وثلاث عشرة تطبيقات مكتوبة لهذا المشروع.
        </p>

        <div class="hero__actions">
          <a class="btn btn--solid" href="#download">
            <span>تحميل</span>
            <span class="hero__size">{release.size}</span>
          </a> <a class="btn btn--ghost" href="https://github.com/MiracLight/CarotOS" target="_blank" rel="noopener noreferrer">الكود المصدري</a >
        </div>
      </div>

      <div class="hero__art" aria-hidden="true">
        <span class="ripple ripple--1"></span>
        <span class="ripple ripple--2"></span>
        <span class="ripple ripple--3"></span>
        <div class="hero__turtle" data-minigame-trigger>
          <Turtle shell="#378ADA" body="#185FA5" />
        </div>
      </div>
    </div>

    <div class="wrap">
      <dl class="facts">
        {
          facts.map((f) => (
            <div class="facts__item">
              <dt class="facts__num">{f.num}</dt>
              <dd class="facts__label">{f.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <Wave from="#f4f9fd" to="#deedf8" />

  {/* ============================================================
      PHILOSOPHY
      ============================================================ */}
  <section id="philosophy" class="band band--shallow">
    <div class="wrap">
      <p class="eyebrow">المنهجية</p>
      <h2 class="sec__title">النطاق ومبادئ التصميم</h2>
      <p class="lede sec__lede">
        لا يعد CarotOS بديلاً للتوزيعات التي توفر مجموعات أدوات ضخمة. بل يضيف عشر أدوات وواجهات تشغيلها فوق تثبيت Debian. الهدف ليس زيادة عدد الأدوات، بل توفير قاعدة عمل مناسبة للفصول الدراسية.
      </p>

      <div class="grid grid--2 sec__grid">
        {
          philosophy.map((p) => (
            <article class="card">
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <Wave from="#deedf8" to="#a9cfea" />

  {/* ============================================================
      WHAT'S INSIDE
      ============================================================ */}
  <section id="inside" class="band band--tide">
    <div class="wrap">
      <p class="eyebrow">التطبيقات</p>
      <h2 class="sec__title">التطبيقات والأدوات</h2>
      <p class="lede sec__lede">
        ثلاث عشرة تطبيقاً كُتبت لهذا المشروع بلغات Python و GTK3، وموزعة تحت رخصة GPL-3.0.
      </p>

      <div class="grid grid--2 sec__grid">
        {
          apps.map((a, i) => (
            <article class="card app">
              {a.icon ? (
                <img
                  class="app__logo"
                  src={a.icon}
                  alt=""
                  width="44"
                  height="44"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <span class="app__no">{String(i + 1).padStart(2, "0")}</span>
              )}
              <div>
                <h3>
                  {a.title}
                  {a.yeni && <span class="app__tag">{a.yeni}</span>}
                </h3>
                <p>{a.text}</p>
                {a.links && (
                  <p class="app__links">
                    {a.links.map((l) => (
                      <a href={l.url} rel="noopener">{l.label}</a>
                    ))}
                  </p>
                )}
              </div>
            </article>
          ))
        }
      </div>

      <div class="tools">
        <h3 class="tools__title">الأدوات المثبتة</h3>
        <ul class="tools__list">
          {
            tools.map((t) => (
              <li class="tool">
                <span class="tool__hex" aria-hidden="true" />
                <span class="tool__name">{t.name}</span>
                <span class="tool__job">{t.job}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="gorseller">
        <h3 class="tools__title">لقطات الشاشة</h3>
        <Slayt lang="ar" slaytlar={slides} />
      </div>

      <div class="poligon">
        <h3 class="tools__title">CarotOS Poligon</h3>
        <p class="lede poligon__lede">
          بيئة اختبار اختراق معزولة وآمنة للطلاب والمعلمين. يقوم المعلم بإنشاء غرفة صفية؛ ويكمل الطلاب المهام باستخدام أدوات حقيقية على أجهزتهم الخاصة. لا توجد مكونات معرضة للشبكة، وتتم جميع العمليات على الجهاز المحلي.
        </p>
        <div class="grid grid--2 poligon__grid">
          {
            poligonApps.map((p) => (
              <article class="card poligon__card">
                <div class="poligon__head">
                  <img src={p.icon} alt="" class="poligon__ikon" width="40" height="40" />
                  <h4>{p.title}</h4>
                </div>
                <p>{p.text}</p>
                <div class="poligon__ekran-cerceve">
                  <img
                    src={p.screenshot}
                    alt={p.alt}
                    class="poligon__ekran"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              </article>
            ))
          }
        </div>
      </div>

      <div class="poligon">
        <h3 class="tools__title">CarotPot و Carotene</h3>
        <p class="lede poligon__lede">
          تطبيقان لأمن الشبكات والملفات. يقوم CarotPot باعتراض عمليات الفحص ومحاولات تسجيل الدخول على الشبكة المحلية باستخدام خدمات وهمية. يقوم Carotene بفحص الملفات باستخدام ClamAV. لا يعمل أي منهما في الخلفية إلا إذا قمت بتشغيله.
        </p>
        <div class="grid grid--2 poligon__grid">
          {
            securityApps.map((p) => (
              <article class="card poligon__card">
                <div class="poligon__head">
                  <img src={p.icon} alt="" class="poligon__ikon" width="40" height="40" />
                  <h4>{p.title}</h4>
                </div>
                <p>{p.text}</p>
                <div class="poligon__ekran-cerceve" style={`aspect-ratio: ${p.ratio}`}>
                  <img
                    src={p.screenshot}
                    alt={p.alt}
                    class="poligon__ekran"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <Wave from="#a9cfea" to="#185fa5" />

  {/* ============================================================
      DOWNLOAD
      ============================================================ */}
  <section id="download" class="band band--deep">
    <div class="wrap">
      <p class="eyebrow">تحميل</p>
      <h2 class="sec__title">Release {release.tag} “{release.codename}”</h2>
      <p class="lede sec__lede">
        يمكن التثبيت مباشرة من سطح المكتب الحي عبر أيقونة “Install CarotOS”. تم اختبار التثبيت على BIOS و UEFI. تتضمن نسخة ISO ملف shim موقعاً لدعم Secure Boot. كما تتضمن حزم البرامج الثابتة لأجهزة Wi-Fi والصوت والرسوميات.
      </p>

      <div class="dl">
        <article class="dl__card">
          <div class="dl__head">
            <div>
              <p class="dl__arch">سطح المكتب</p>
              <p class="dl__isa mono">x86_64</p>
            </div>
            <span class="dl__badge">Stable · {release.codename}</span>
          </div>

          <ul class="dl__meta">
            <li><span>File</span><span class="mono">{release.file}</span></li>
            <li><span>الحجم</span><span class="mono">{release.size}</span></li>
            <li><span>سطح المكتب</span><span>XFCE</span></li>
            <li><span>تاريخ الإصدار</span><span>{release.date}</span></li>
          </ul>

          <a class="btn btn--light dl__btn" href={release.url}>
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M12 3v13m0 0 5-5m-5 5-5-5M4 20h16"
                stroke="currentColor"
                stroke-width="2.1"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
            <span>تحميل ملف ISO</span>
          </a>

          <div class="verify">
            <p class="verify__hash">
              <span class="verify__hash-label">SHA-256</span>
              <code>{release.sha256}</code>
            </p>
            <a class="verify__link" href={release.shaUrl}
              >{release.file}.sha256</a
            >
          </div>
        </article>

        <div class="dl__yan">
          <div class="req">
            <p class="dl__soon-title">متطلبات النظام</p>
            <ul class="req__list">
              {
                requirements.map((r) => (
                  <li>
                    <span>{r.name}</span>
                    <span>{r.value}</span>
                  </li>
                ))
              }
            </ul>
            <p class="req__not">
              الحد الأدنى الموصى به لتثبيت سطح مكتب Debian 13 “trixie”. يستهلك XFCE موارد أقل من GNOME أو KDE Plasma. لا يدعم Debian 13 معمارية i386.
            </p>
          </div>

          <div class="dl__soon">
          <p class="dl__soon-title">المشاريع المخطط لها</p>

          <article class="soon">
            <div>
              <p class="soon__arch">CarotOS AUL</p>
              <p class="soon__isa mono">arm64</p>
            </div>
            <p class="soon__note">
              نسخة خفيفة الوزن تعتمد على Armbian (Armbian Ultra Light). تعمل على IceWM على لوحات arm64 مثل Orange Pi 5. استهلاك الذاكرة المستهدف في وضع الخمول هو 200 ميجابايت.
            </p>
            <span class="soon__tag">قيد التطوير</span>
          </article>

            <p class="dl__soon-foot">
              سيتبع مشروع CarotDeck، وهو مشروع أجهزة محمولة، لاحقاً.
            </p>
          </div>
        </div>
      </div>
    </div>
