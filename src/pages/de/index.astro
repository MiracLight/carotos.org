    text: "Eine Anleitung, die Sicherheitstools mit Animationen vermittelt. Jedes Tool des Sicherheitspanels sowie CarotPot und Carotene haben eine Erklärung, eine abspielbare Animation und einen Abschnitt „Probier es selbst“. Themen zum CTF-Wettbewerb, zum Befehlserklärer, zu Ethik, Festplattenverschlüsselung, ISO-Überprüfung und zur Verteidigeransicht sind enthalten. Sie funktioniert in elf Sprachen.",
  },
  {
    title: "CarotOS GSD",
    icon: "/ikonlar/ikon-gsd.webp",
    yeni: "1.3",
    text: "Das Allgemeine Systemlexikon (General System Dictionary) mit 197 Begriffen zu Linux, Netzwerken, Cybersicherheit, Kryptografie und Informatik. Du kannst die Begriffe durchsuchen, Beispielbefehle ansehen und zu verwandten Begriffen springen. Es ist in elf Sprachen verfügbar.",
  },
];

const poligonApps = [
  {
    title: "CarotOS Poligon",
    icon: "/ikonlar/ikon-poligon-ogrenci.webp",
    screenshot: "/ekranlar/poligon-ogrenci.webp",
    alt: "CarotOS-Poligon-Anwendung für Lernende: Optionen für Gast, Konto erstellen und Anmeldung",
    text: "Du kannst es als Gast ohne Konto nutzen oder dich mit einem Benutzerkonto anmelden. Der Fortschritt wird für angemeldete Konten gespeichert. Aufgaben löst du allein oder in einem Klassenraum.",
  },
  {
    title: "CarotOS Poligon Lehrkraft",
    icon: "/ikonlar/ikon-poligon-ogretmen.webp",
    screenshot: "/ekranlar/poligon-ogretmen.webp",
    alt: "CarotOS-Poligon-Anwendung für Lehrkräfte: Raumcode, Raumpasswort, Liste der Lernenden und Hinweisfeld",
    text: "Raumcode und Passwort werden mit einem Klick erzeugt. Ansichten für einzelne Lernende und die Klasse, das Verfassen von Fragen und gespeicherte Fragen liegen in getrennten Tabs. Ein Hinweis lässt sich an eine einzelne Person oder an die ganze Klasse senden.",
  },
];

const securityApps = [
  {
    title: "CarotPot",
    icon: "/ikonlar/ikon-carotpot.webp",
    screenshot: "/ekranlar/carotpot.webp",
    ratio: "1280 / 820",
    alt: "CarotPot-Dashboard: Fallen aktiv, ein Aktivitätsdiagramm pro Stunde, Ereignisse pro Falle, die aktivsten Angreifer und ein Live-Feed",
    text: "Erkennt Geräte im lokalen Netzwerk, die diesen Computer scannen oder sich bei ihm anzumelden versuchen. Es öffnet acht vorgetäuschte Dienste: SSH, Webpanel, Telnet, FTP, VNC, RDP, MySQL und Redis. Das Dashboard zeigt die Aktivität der letzten 24 Stunden und die aktivsten Angreifer. Ein Angreiferprofil listet die versuchten Benutzernamen, maskierte Passwörter und einen Risikowert auf. Das Sperren eines Geräts erfordert deine Bestätigung.",
  },
  {
    title: "Carotene",
    icon: "/ikonlar/ikon-carotene.webp",
    screenshot: "/ekranlar/carotene.webp",
    ratio: "1040 / 700",
    alt: "Carotene: ein Scanergebnis mit zwei gefundenen Bedrohungen, dem Alter der Virendefinitionen und den Scanoptionen",
    text: "Führt mit ClamAV Schnellscans, Scans des Home-Ordners und Scans eines frei gewählten Ordners aus. Während eines Scans werden die Zahl der geprüften Dateien und die Funde live aktualisiert. Gefundene Dateien lassen sich in Quarantäne verschieben, löschen oder ignorieren. Das Alter der Virendefinitionen steht auf dem Hauptbildschirm, und sie werden aus der Anwendung heraus aktualisiert. Ein sauberes Ergebnis garantiert nicht, dass Dateien sicher sind, es zeigt nur, dass keine bekannte Signatur gefunden wurde.",
  },
];

const tools = [
  { name: "nmap", job: "Netzwerk- und Portscans" },
  { name: "tcpdump", job: "Paketmitschnitt" },
  { name: "tshark", job: "Verkehrsanalyse" },
  { name: "aircrack-ng", job: "Tests von WLAN-Netzwerken" },
  { name: "nikto", job: "Scans von Webservern" },
  { name: "sqlmap", job: "Tests auf SQL-Injection" },
  { name: "john", job: "Analyse der Passwortstärke" },
  { name: "hydra", job: "Tests der Authentifizierung" },
  { name: "ufw", job: "Firewall" },
  { name: "fail2ban", job: "Einbruchsprävention" },
];
---

<Base
  lang="de"
  title="CarotOS | Eine Linux-Distribution zum Lernen von Cybersicherheit"
  description="Eine auf Debian 13 basierende, bildungsorientierte Linux-Distribution mit zehn Sicherheitstools und dreizehn eigenen Anwendungen."
>
  {/* ============================================================
      HERO
      ============================================================ */}
  <section class="band band--foam hero">
    <div class="wrap hero__inner">
      <div class="hero__text">
        <p class="eyebrow">Debian 13 · XFCE · amd64</p>
        <h1>Wenige, gut erklärt.</h1>
        <p class="lede hero__lede">
          CarotOS ist eine Linux-Distribution für die Ausbildung in
          Cybersicherheit. Sie liefert zehn Sicherheitstools und dreizehn für
          das Projekt geschriebene Anwendungen mit.
        </p>

        <div class="hero__actions">
          <a class="btn btn--solid" href="#download">
            <span>Herunterladen</span>
            <span class="hero__size">{release.size}</span>
          </a>
          <a
            class="btn btn--ghost"
            href="https://github.com/MiracLight/CarotOS"
            target="_blank"
            rel="noopener noreferrer">Quellcode</a
          >
        </div>
      </div>

      <div class="hero__art" aria-hidden="true">
        <span class="ripple ripple--1"></span>
        <span class="ripple ripple--2"></span>
        <span class="ripple ripple--3"></span>
        <div class="hero__turtle" data-minigame-trigger>
          <Turtle shell="#378ADA" body="#185FA5" />
        </div>
      </div>
    </div>

    <div class="wrap">
      <dl class="facts">
        {
          facts.map((f) => (
            <div class="facts__item">
              <dt class="facts__num">{f.num}</dt>
              <dd class="facts__label">{f.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <Wave from="#f4f9fd" to="#deedf8" />

  {/* ============================================================
      PHILOSOPHY
      ============================================================ */}
  <section id="philosophy" class="band band--shallow">
    <div class="wrap">
      <p class="eyebrow">Ansatz</p>
      <h2 class="sec__title">Umfang und Gestaltungsprinzipien</h2>
      <p class="lede sec__lede">
        CarotOS ist keine Alternative zu Distributionen mit riesigen
        Tool-Sammlungen. Es ergänzt eine Debian-Installation um zehn Tools und
        die Oberflächen, mit denen man sie bedient. Das Ziel ist nicht eine
        höhere Zahl an Tools, sondern eine Basis, die im Unterricht funktioniert.
      </p>

      <div class="grid grid--2 sec__grid">
        {
          philosophy.map((p) => (
            <article class="card">
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <Wave from="#deedf8" to="#a9cfea" />

  {/* ============================================================
      WHAT'S INSIDE
      ============================================================ */}
  <section id="inside" class="band band--tide">
    <div class="wrap">
      <p class="eyebrow">Anwendungen</p>
      <h2 class="sec__title">Anwendungen und Tools</h2>
      <p class="lede sec__lede">
        Dreizehn für dieses Projekt in Python und GTK3 geschriebene
        Anwendungen, veröffentlicht unter der GPL-3.0.
      </p>

      <div class="grid grid--2 sec__grid">
        {
          apps.map((a, i) => (
            <article class="card app">
              {a.icon ? (
                <img
                  class="app__logo"
                  src={a.icon}
                  alt=""
                  width="44"
                  height="44"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <span class="app__no">{String(i + 1).padStart(2, "0")}</span>
              )}
              <div>
                <h3>
                  {a.title}
                  {a.yeni && <span class="app__tag">{a.yeni}</span>}
                </h3>
                <p>{a.text}</p>
                {a.links && (
                  <p class="app__links">
                    {a.links.map((l) => (
                      <a href={l.url} rel="noopener">{l.label}</a>
                    ))}
                  </p>
                )}
              </div>
            </article>
          ))
        }
      </div>

      <div class="tools">
        <h3 class="tools__title">Installierte Tools</h3>
        <ul class="tools__list">
          {
            tools.map((t) => (
              <li class="tool">
                <span class="tool__hex" aria-hidden="true" />
                <span class="tool__name">{t.name}</span>
                <span class="tool__job">{t.job}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="gorseller">
        <h3 class="tools__title">Screenshots</h3>
        <Slayt lang="de" slaytlar={slides} />
      </div>

      <div class="poligon">
        <h3 class="tools__title">CarotOS Poligon</h3>
        <p class="lede poligon__lede">
          Eine abgeschottete, sichere Umgebung für Penetrationstests, für
          Lernende und Lehrkräfte. Die Lehrkraft erstellt einen Klassenraum; die
          Lernenden lösen Aufgaben mit echten Tools auf ihren eigenen Rechnern.
          Es gibt keine aus dem Netzwerk erreichbaren Komponenten. Alle Vorgänge
          laufen auf dem lokalen Rechner.
        </p>
        <div class="grid grid--2 poligon__grid">
          {
            poligonApps.map((p) => (
              <article class="card poligon__card">
                <div class="poligon__head">
                  <img src={p.icon} alt="" class="poligon__ikon" width="40" height="40" />
                  <h4>{p.title}</h4>
                </div>
                <p>{p.text}</p>
                <div class="poligon__ekran-cerceve">
                  <img
                    src={p.screenshot}
                    alt={p.alt}
                    class="poligon__ekran"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              </article>
            ))
          }
        </div>
      </div>

      <div class="poligon">
        <h3 class="tools__title">CarotPot und Carotene</h3>
        <p class="lede poligon__lede">
          Zwei Anwendungen für die Sicherheit von Netzwerk und Dateien. CarotPot
          fängt Scans und Anmeldeversuche im lokalen Netzwerk mit vorgetäuschten
          Diensten ab. Carotene prüft Dateien mit ClamAV. Keine von beiden läuft
          im Hintergrund, solange du sie nicht startest.
        </p>
        <div class="grid grid--2 poligon__grid">
          {
            securityApps.map((p) => (
              <article class="card poligon__card">
                <div class="poligon__head">
                  <img src={p.icon} alt="" class="poligon__ikon" width="40" height="40" />
                  <h4>{p.title}</h4>
                </div>
                <p>{p.text}</p>
                <div class="poligon__ekran-cerceve" style={`aspect-ratio: ${p.ratio}`}>
                  <img
                    src={p.screenshot}
                    alt={p.alt}
                    class="poligon__ekran"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <Wave from="#a9cfea" to="#185fa5" />

  {/* ============================================================
      DOWNLOAD
      ============================================================ */}
  <section id="download" class="band band--deep">
    <div class="wrap">
      <p class="eyebrow">Download</p>
      <h2 class="sec__title">Version {release.tag} „{release.codename}“</h2>
      <p class="lede sec__lede">
        Installiere direkt vom Live-Desktop mit dem Symbol „CarotOS
        installieren“. Installationen mit BIOS und mit UEFI sind beide getestet.
        Für Secure Boot liegt ein signierter Shim in der ISO. Firmware-Pakete für
        WLAN-, Audio- und Grafikhardware sind enthalten.
      </p>

      <div class="dl">
        <article class="dl__card">
          <div class="dl__head">
            <div>
              <p class="dl__arch">Desktop</p>
              <p class="dl__isa mono">x86_64</p>
            </div>
            <span class="dl__badge">Stabil · {release.codename}</span>
          </div>

          <ul class="dl__meta">
            <li><span>Datei</span><span class="mono">{release.file}</span></li>
            <li><span>Größe</span><span class="mono">{release.size}</span></li>
            <li><span>Desktop</span><span>XFCE</span></li>
            <li><span>Veröffentlicht</span><span>{release.date}</span></li>
          </ul>

          <a class="btn btn--light dl__btn" href={release.url}>
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M12 3v13m0 0 5-5m-5 5-5-5M4 20h16"
                stroke="currentColor"
                stroke-width="2.1"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
            <span>ISO herunterladen</span>
          </a>

          <div class="verify">
            <p class="verify__hash">
              <span class="verify__hash-label">SHA-256</span>
              <code>{release.sha256}</code>
            </p>
            <a class="verify__link" href={release.shaUrl}
              >{release.file}.sha256</a
            >
          </div>
        </article>

        <div class="dl__yan">
          <div class="req">
            <p class="dl__soon-title">Systemanforderungen</p>
            <ul class="req__list">
              {
                requirements.map((r) => (
                  <li>
                    <span>{r.name}</span>
                    <span>{r.value}</span>
                  </li>
                ))
              }
            </ul>
            <p class="req__not">
              Empfohlene Mindestwerte für eine Desktop-Installation von Debian 13
              „trixie“. XFCE braucht weniger Ressourcen als GNOME oder KDE
              Plasma. Debian 13 unterstützt die Architektur i386 nicht.
            </p>
          </div>

          <div class="dl__soon">
          <p class="dl__soon-title">Geplante Projekte</p>

          <article class="soon">
            <div>
              <p class="soon__arch">CarotOS AUL</p>
              <p class="soon__isa mono">arm64</p>
            </div>
            <p class="soon__note">
              Eine schlanke Variante auf Armbian-Basis (Armbian Ultra Light). Läuft mit IceWM auf arm64-Boards wie dem Orange Pi 5. Ziel ist ein Speicherverbrauch von 200 MB im Leerlauf.
            </p>
            <span class="soon__tag">In Entwicklung</span>
          </article>

            <p class="dl__soon-foot">
              CarotDeck, ein portables Hardwareprojekt, folgt später.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Wave from="#185fa5" to="#0b2e52" />

  {/* ============================================================
      RELEASES / NEWSLETTER
      ============================================================ */}
  <section id="releases" class="band band--abyss news">
    <div class="wrap">
      <p class="eyebrow">Versionen</p>
      <h2 class="sec__title">Benachrichtigungen zu neuen Versionen</h2>
      <p class="lede sec__lede">
        Die Versionshinweise erscheinen auf GitHub: neue Tools, behobene
        Fehler, nicht abwärtskompatible Änderungen.
      </p>

      <div class="news__grid">
        <div class="news__card news__card--wide">
          <h3>E-Mail-Newsletter</h3>
          <p>
            Versionshinweise per E-Mail. Die Adressen werden für keinen anderen
            Zweck verwendet.
          </p>

          <form class="sub" id="newsletter">
            <label class="visually-hidden" for="email">Deine E-Mail-Adresse</label
            >
            <input
              id="email"
              name="email"
              type="email"
              required
              placeholder="du@example.com"
              autocomplete="email"
            />
            <button class="btn btn--light" type="submit">Anmelden</button>
          </form>
          <p class="sub__note">
            „Anmelden“ öffnet das Mailprogramm mit einer vorbereiteten Nachricht.
          </p>
        </div>

        <div class="news__card">
          <h3>GitHub</h3>
          <p>
            Wenn du im Repository <strong>Watch → Custom → Releases</strong>
            auswählst, bekommst du bei jeder neuen Version eine Benachrichtigung.
          </p>
          <a
            class="btn btn--outline-light news__btn"
            href="https://github.com/MiracLight/CarotOS/releases"
            target="_blank"
            rel="noopener noreferrer">Releases</a
          >
        </div>

        <div class="news__card">
          <h3>RSS / Atom</h3>
          <p>
            Der Release-Feed lässt sich direkt in einen Reader einfügen. Keine
            Anmeldung nötig.
          </p>
          <a
            class="btn btn--outline-light news__btn"
            href="https://github.com/MiracLight/CarotOS/releases.atom"
            target="_blank"
            rel="noopener noreferrer">Feed-Adresse</a
          >
        </div>
      </div>

      <p class="news__last">
        Neueste Version <strong>{release.tag}</strong> — {release.date}
      </p>
    </div>
  </section>
  <Minigame lang="de" />
</Base>

<script>
  /* Newsletter form.
     Not wired to an email service yet; on submit it opens the visitor's
     mail app with a prepared message. Once you move to Buttondown,
     Mailchimp or similar, delete this block and give the form an
     action + method instead. */
  const form = document.getElementById("newsletter") as HTMLFormElement | null;
  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const field = document.getElementById("email") as HTMLInputElement;
    if (!field.checkValidity()) {
      field.reportValidity();
      return;
    }
    const subject = encodeURIComponent("Newsletter signup");
    const body = encodeURIComponent(
      `Hello,\n\nI'd like to join the CarotOS release newsletter.\nMy email address: ${field.value}\n`,
    );
    window.location.href = `mailto:carotosproject@gmail.com?subject=${subject}&body=${body}`;
  });
</script>
