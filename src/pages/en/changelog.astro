---
import Base from "../../layouts/Base.astro";
import Wave from "../../components/Wave.astro";

/* ------------------------------------------------------------------
   CHANGELOG

   When a new release ships, add an object to the FRONT of this array.
   Mirror the same entry in src/pages/surum-notlari.astro
   ------------------------------------------------------------------ */
const surumler = [
  {
    etiket: "1.3",
    kodAdi: "Eggshell",
    tarih: "29 October 2026",
    tarihISO: "2026-10-29",
    ozet:
      "Added Carotene, CarotPot, Filenor, CarotOS Former and CarotOS GSD. System Health and USB Inspector gained ClamAV and AppArmor checks, and the Store catalog grew to 153 applications.",
    degisiklikler: [
      { tur: "eklendi", metin: "Carotene: quick, home folder and custom scans with ClamAV, quarantine, virus-definition updates and scan history; it runs no background service" },
      { tur: "eklendi", metin: "CarotPot: fake SSH, Telnet, web panel, FTP, VNC, RDP, MySQL and Redis traps for the local network; attacker list, canary files and confirmed blocking" },
      { tur: "eklendi", metin: "Filenor: image, audio, video, document, spreadsheet, presentation and font conversion; PDF merging, splitting, rotating, shrinking and locking; OCR" },
      { tur: "eklendi", metin: "CarotOS Former: a bilingual guide that explains the security tools, CarotPot and Carotene step by step with animations" },
      { tur: "eklendi", metin: "CarotOS GSD: a searchable bilingual dictionary of 161 terms covering Linux, networking, cybersecurity, cryptography, algorithms and general computer science" },
      { tur: "eklendi", metin: "System Health: a Protection layers category (AppArmor, AppArmor profiles, virus-definition age) and detailed scans using debsums and rkhunter; checks grew from 20 to 23 and categories from six to seven" },
      { tur: "eklendi", metin: "USB Inspector: a detailed ClamAV scan that runs only when the user starts it from the window; detected files are reported and left untouched" },
      { tur: "eklendi", metin: "Welcome Wizard: pages for the new applications; the wizard now has twenty-one pages" },
      { tur: "degisti", metin: "The Store catalog grew from 51 to 153 applications and from seven to ten categories; the window title is now “CarotOS Store”" },
      { tur: "degisti", metin: "New icons for USB Inspector, System Health and the Store, used in the menu, the panel and the windows" },
      { tur: "eklendi", metin: "Carotene: when ClamAV is not installed, an \"Install ClamAV in the Store\" button opens the ClamAV page in the Store" },
      { tur: "degisti", metin: "The default host name is now \"carotos\" (user@carotos); the Welcome Wizard titles for Carotene, CarotPot and Filenor no longer carry a redundant \"CarotOS\" prefix; the Poligon image now shows the real interface" },
      { tur: "duzeltildi", metin: "Idle memory use could exceed 1 GB when the icon cache was missing or stale; the cache is now checked at every boot and rebuilt when needed" },
      { tur: "duzeltildi", metin: "The fastfetch output broke in narrow terminal windows; its lines were shortened and the terminal now opens at 100×30 by default" },
    ],
  },
  {
    etiket: "1.2",
    kodAdi: "Eggshell",
    tarih: "12 October 2026",
    tarihISO: "2026-10-12",
    ozet:
      "Added the CarotOS Store, refreshed the desktop with the Arc theme and Papirus icons, and added background selection to the welcome wizard.",
    degisiklikler: [
      { tur: "eklendi", metin: "CarotOS Store: 51 applications in seven categories, installation and removal through apt, light and dark themes, Turkish and English interface" },
      { tur: "eklendi", metin: "Welcome Wizard: a desktop background page with three options, plus USB Inspector and Store pages; the wizard now has fifteen pages" },
      { tur: "eklendi", metin: "USB Inspector: starts in the background at login" },
      { tur: "eklendi", metin: "Poligon: guest, create-account and sign-in options" },
      { tur: "eklendi", metin: "New CarotOS backgrounds for the login screen and the desktop; the boot splash shows version 1.2" },
      { tur: "degisti", metin: "The desktop theme is now Arc with Papirus icons; light or dark is chosen in the welcome wizard, and dark is the default" },
      { tur: "degisti", metin: "A fresh installation now starts with one of the new CarotOS backgrounds as the default" },
    ],
  },
  {
    etiket: "1.1",
    kodAdi: "Eggshell",
    tarih: "2 September 2026",
    tarihISO: "2026-09-02",
    ozet:
      "Added CarotOS Poligon: practice pentesting in an isolated range with student and teacher applications.",
    degisiklikler: [
      { tur: "eklendi", metin: "CarotOS Poligon: student/teacher applications for practicing with hydra, nmap, john, sqlmap and tshark" },
      { tur: "eklendi", metin: "Defense tasks in Poligon using ufw and fail2ban" },
      { tur: "duzeltildi", metin: "tshark failed with an access error under a regular user account; the wireshark group is now added automatically" },
      { tur: "duzeltildi", metin: "The username shown when booting in \"Try Live\" mode read \"Debian Live User\"" },
    ],
  },
  {
    etiket: "1.0",
    kodAdi: "Eggshell",
    tarih: "19 August 2026",
    tarihISO: "2026-08-19",
    ozet:
      "First stable release. Debian 13 “trixie” base, XFCE desktop, ten security tools and four original applications.",
    degisiklikler: [
      { tur: "eklendi", metin: "Security Panel: a graphical interface for the ten tools, with field documentation and live output" },
      { tur: "eklendi", metin: "Welcome Wizard: an eleven-page bilingual introduction with theme and language selection" },
      { tur: "eklendi", metin: "System Health: twenty checks across six categories, a health score, twelve one-click fixes" },
      { tur: "eklendi", metin: "USB Inspector: checks connected devices for autorun.inf, double extensions and hidden extensions" },
      { tur: "eklendi", metin: "BIOS and UEFI installation, with a signed shim for Secure Boot" },
      { tur: "eklendi", metin: "Full firmware set for Wi-Fi, audio and graphics hardware" },
      { tur: "eklendi", metin: "Turkish as the default language, with English available" },
      { tur: "duzeltildi", metin: "nikto did not run on an installed system; a missing dependency was added" },
      { tur: "duzeltildi", metin: "The language chosen in the wizard was not applied after the session restarted" },
      { tur: "duzeltildi", metin: "Panel and menu icons were missing under some themes" },
    ],
  },
];

const etiketler: Record<string, string> = {
  eklendi: "Added",
  duzeltildi: "Fixed",
  degisti: "Changed",
  kaldirildi: "Removed",
};
---

<Base
  lang="en"
  title="Changelog — CarotOS"
  description="What changed in each CarotOS release: tools added, bugs fixed, backwards-incompatible changes."
>
  <section class="band band--foam log__intro">
    <div class="wrap">
      <p class="eyebrow">Changelog</p>
      <h1 class="log__h1">What changed</h1>
      <p class="lede">
        Tools added, bugs fixed and backwards-incompatible changes are listed
        here for every release. The same notes are published on the GitHub
        releases page.
      </p>
      <div class="log__links">
        <a class="btn btn--ghost" href="/en#download">Download</a>
        <a
          class="btn btn--ghost"
          href="https://github.com/MiracLight/CarotOS/releases"
          target="_blank"
          rel="noopener noreferrer">GitHub releases</a
        >
      </div>
    </div>
  </section>

  <Wave from="#f4f9fd" to="#deedf8" />

  <section class="band band--shallow">
    <div class="wrap">
      {
        surumler.map((s) => (
          <article class="rel">
            <header class="rel__head">
              <h2 class="rel__tag">
                {s.etiket} <span class="rel__code">“{s.kodAdi}”</span>
              </h2>
              <time class="rel__date mono" datetime={s.tarihISO}>
                {s.tarih}
              </time>
            </header>

            <p class="rel__ozet">{s.ozet}</p>

            <ul class="rel__list">
              {s.degisiklikler.map((d) => (
                <li class="rel__item">
                  <span class={`tag tag--${d.tur}`}>{etiketler[d.tur]}</span>
                  <span class="rel__text">{d.metin}</span>
                </li>
              ))}
            </ul>
          </article>
        ))
      }

      <p class="log__son">
        No earlier releases — 1.0 is the first stable one. Intermediate builds
        from development were never published.
      </p>
    </div>
  </section>
</Base>

<style>
  .log__intro {
    padding-bottom: clamp(3rem, 6vw, 4rem);
  }

  .log__h1 {
    font-size: clamp(2.4rem, 6vw, 4rem);
    margin-bottom: 1.1rem;
  }

  .log__links {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
    margin-top: 2rem;
  }

  .rel {
    max-width: 78ch;
  }

  .rel + .rel {
    margin-top: 3.5rem;
    padding-top: 3.5rem;
    border-top: 1.5px solid rgba(24, 95, 165, 0.2);
  }

  .rel__head {
    display: flex;
    align-items: baseline;
    gap: 1rem 1.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.9rem;
  }

  .rel__tag {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    margin: 0;
  }

  .rel__code {
    color: var(--current);
    font-weight: 700;
  }

  .rel__date {
    color: var(--ink-faint);
    font-size: 0.85rem;
  }

  .rel__ozet {
    color: var(--ink-soft);
    font-size: 1.02rem;
    margin-bottom: 1.8rem;
    max-width: var(--w-text);
  }

  .rel__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.7rem;
  }

  .rel__item {
    display: grid;
    grid-template-columns: 92px 1fr;
    gap: 0.9rem;
    align-items: baseline;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid rgba(24, 95, 165, 0.13);
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-align: center;
    padding: 0.24rem 0.4rem;
    border-radius: 4px;
    white-space: nowrap;
  }

  .tag--eklendi {
    background: rgba(74, 156, 120, 0.16);
    color: #2f6f52;
  }

  .tag--duzeltildi {
    background: rgba(55, 138, 218, 0.16);
    color: var(--deep);
  }

  .tag--degisti {
    background: rgba(24, 95, 165, 0.1);
    color: var(--ink-soft);
  }

  .tag--kaldirildi {
    background: rgba(160, 90, 90, 0.14);
    color: #8a4646;
  }

  .rel__text {
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .log__son {
    margin-top: 3rem;
    font-size: 0.88rem;
    color: var(--ink-faint);
  }

  @media (max-width: 560px) {
    .rel__item {
      grid-template-columns: 1fr;
      gap: 0.3rem;
    }

    .tag {
      justify-self: start;
    }
  }
</style>
