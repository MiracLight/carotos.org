---
import Base from "../../layouts/Base.astro";
import Wave from "../../components/Wave.astro";
import Turtle from "../../components/Turtle.astro";
import Slayt from "../../components/Slayt.astro";

/* ------------------------------------------------------------------
   Release info — when a new version ships, update ONLY this block.
   Keep it in sync with src/pages/index.astro
   ------------------------------------------------------------------ */
const release = {
  tag: "1.0",
  codename: "Eggshell",
  date: "19 August 2026",
  file: "carotos-1.0-amd64.iso",
  size: "2.19 GB",
  sha256: "b79f0ceef80f91bf9cc320d68e98e5f3c482bb47709f62c142f2fd664ef16c53",
  url: "https://download.carotos.org/carotos-1.0-amd64.iso",
  shaUrl: "https://download.carotos.org/carotos-1.0-amd64.iso.sha256",
};

/* Debian 13 "trixie" amd64 installation guide, Table 3.2 —
   recommended minimums for a desktop install. */
const requirements = [
  { name: "Processor", value: "64-bit (amd64), 1 GHz" },
  { name: "Memory", value: "1 GB minimum, 2 GB recommended" },
  { name: "Disk", value: "10 GB" },
  { name: "Boot", value: "BIOS or UEFI" },
];

const slides = [
  {
    src: "/ekranlar/masaustu.webp",
    kucuk: "/ekranlar/kucuk/masaustu.webp",
    alt: "CarotOS desktop with the XFCE panel and a dock",
    grup: "System",
    baslik: "Desktop",
    aciklama: "XFCE 4, a two-panel layout and its own wallpaper.",
  },
  {
    src: "/ekranlar/karsilama-1.webp",
    kucuk: "/ekranlar/kucuk/karsilama-1.webp",
    alt: "Welcome Wizard opening page",
    grup: "Welcome Wizard",
    baslik: "CarotOS 1.0 “Eggshell”",
    aciklama: "Opens on the first session. A short introduction for first-time Linux users.",
  },
  {
    src: "/ekranlar/karsilama-2.webp",
    kucuk: "/ekranlar/kucuk/karsilama-2.webp",
    alt: "Welcome Wizard appearance and language page",
    grup: "Welcome Wizard",
    baslik: "Appearance and language",
    aciklama: "Light or dark theme and the system language, applied on exit.",
  },
  {
    src: "/ekranlar/karsilama-3.webp",
    kucuk: "/ekranlar/kucuk/karsilama-3.webp",
    alt: "Welcome Wizard page on Linux and distributions",
    grup: "Welcome Wizard",
    baslik: "Linux and distributions",
    aciklama: "What CarotOS is and what it is built on: Debian 13, Xfce and APT.",
  },
  {
    src: "/ekranlar/karsilama-4.webp",
    kucuk: "/ekranlar/kucuk/karsilama-4.webp",
    alt: "Welcome Wizard page on the desktop layout",
    grup: "Welcome Wizard",
    baslik: "The desktop",
    aciklama: "How the two-panel layout works.",
  },
  {
    src: "/ekranlar/karsilama-5.webp",
    kucuk: "/ekranlar/kucuk/karsilama-5.webp",
    alt: "Welcome Wizard page on the file system",
    grup: "Welcome Wizard",
    baslik: "The file system",
    aciklama: "Linux has no drive letters; everything sits in one tree.",
  },
  {
    src: "/ekranlar/karsilama-6.webp",
    kucuk: "/ekranlar/kucuk/karsilama-6.webp",
    alt: "Welcome Wizard page on the home folder",
    grup: "Welcome Wizard",
    baslik: "Your home folder",
    aciklama: "Where your personal files live.",
  },
  {
    src: "/ekranlar/karsilama-7.webp",
    kucuk: "/ekranlar/kucuk/karsilama-7.webp",
    alt: "Welcome Wizard page on installing software",
    grup: "Welcome Wizard",
    baslik: "Installing software",
    aciklama: "Repositories: signed, central installation. No .exe downloads.",
  },
  {
    src: "/ekranlar/karsilama-8.webp",
    kucuk: "/ekranlar/kucuk/karsilama-8.webp",
    alt: "Welcome Wizard page introducing the Security Panel",
    grup: "Welcome Wizard",
    baslik: "CarotOS Security Panel",
    aciklama: "Use the security tools without knowing the command line.",
  },
  {
    src: "/ekranlar/karsilama-9.webp",
    kucuk: "/ekranlar/kucuk/karsilama-9.webp",
    alt: "Welcome Wizard listing the installed security tools",
    grup: "Welcome Wizard",
    baslik: "Installed security tools",
    aciklama: "Ten tools, all usable from the panel.",
  },
  {
    src: "/ekranlar/guvenlik-paneli.webp",
    kucuk: "/ekranlar/kucuk/guvenlik-paneli.webp",
    alt: "CarotOS Security Panel showing the tool list and the nmap form",
    grup: "Application",
    baslik: "Security Panel",
    aciklama: "Each field documents its function; command output streams live.",
  },
  {
    src: "/ekranlar/sistem-sagligi.webp",
    kucuk: "/ekranlar/kucuk/sistem-sagligi.webp",
    alt: "CarotOS System Health showing an 88 percent score and a check list",
    grup: "Application",
    baslik: "System Health",
    aciklama: "Twenty checks across six categories, a score and one-click fixes.",
  },
];

const facts = [
  { num: "10", label: "hand-picked security tools" },
  { num: "4", label: "original applications" },
  { num: "~500 MB", label: "memory use when idle" },
  { num: "13", label: "Debian release — trixie" },
];

const philosophy = [
  {
    title: "Tool selection",
    text: "The installed tools cover network scanning, traffic analysis, web and password testing, and firewall configuration. The count is kept deliberately low; each tool needs an interface and documentation written for it.",
  },
  {
    title: "Default language",
    text: "The system installs in Turkish. English is available from the welcome wizard or the session settings. Application interfaces ship in both languages.",
  },
  {
    title: "Debian 13 base",
    text: "A current repository keeps tool versions aligned with the material people learn from. Version mismatch is one of the most common places new users get stuck.",
  },
];

const apps = [
  {
    title: "Security Panel",
    text: "A graphical interface for the ten tools. Each field documents its function, command output streams live, and privileged operations run through pkexec.",
  },
  {
    title: "Welcome Wizard",
    text: "An eleven-page bilingual introduction shown on the first session. Theme and language are selected on page two and applied to the system on exit.",
  },
  {
    title: "System Health",
    text: "Twenty checks across six categories. Produces a health score, fixes twelve issues in one click, and saves the result as a report.",
  },
  {
    title: "USB Inspector",
    text: "Inspects a connected device automatically: autorun.inf, double extensions, hidden extensions, shortcuts disguised as folders. File contents are never read; only names, extensions and locations are examined.",
  },
];

const tools = [
  { name: "nmap", job: "Network and port scanning" },
  { name: "tcpdump", job: "Packet capture" },
  { name: "tshark", job: "Traffic analysis" },
  { name: "aircrack-ng", job: "Wireless network testing" },
  { name: "nikto", job: "Web server scanning" },
  { name: "sqlmap", job: "SQL injection testing" },
  { name: "john", job: "Password strength analysis" },
  { name: "hydra", job: "Authentication testing" },
  { name: "ufw", job: "Firewall" },
  { name: "fail2ban", job: "Intrusion prevention" },
];
---

<Base
  lang="en"
  title="CarotOS — A Linux distribution for learning cybersecurity"
  description="A Debian 13 based, education-focused Linux distribution. Instead of six hundred tools, it explains ten of them well."
>
  {/* ============================================================
      HERO
      ============================================================ */}
  <section class="band band--foam hero">
    <div class="wrap hero__inner">
      <div class="hero__text">
        <p class="eyebrow">Debian 13 · XFCE · amd64</p>
        <h1>Few, explained well.</h1>
        <p class="lede hero__lede">
          CarotOS is a Linux distribution built for cybersecurity education. It
          ships ten security tools and four applications written to operate
          them.
        </p>

        <div class="hero__actions">
          <a class="btn btn--solid" href="#download">
            <span>Download</span>
            <span class="hero__size">{release.size}</span>
          </a>
          <a
            class="btn btn--ghost"
            href="https://github.com/MiracLight/CarotOS"
            target="_blank"
            rel="noopener noreferrer">Source code</a
          >
        </div>
      </div>

      <div class="hero__art" aria-hidden="true">
        <span class="ripple ripple--1"></span>
        <span class="ripple ripple--2"></span>
        <span class="ripple ripple--3"></span>
        <div class="hero__turtle">
          <Turtle shell="#378ADA" body="#185FA5" />
        </div>
      </div>
    </div>

    <div class="wrap">
      <dl class="facts">
        {
          facts.map((f) => (
            <div class="facts__item">
              <dt class="facts__num">{f.num}</dt>
              <dd class="facts__label">{f.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <Wave from="#f4f9fd" to="#deedf8" />

  {/* ============================================================
      PHILOSOPHY
      ============================================================ */}
  <section id="philosophy" class="band band--shallow">
    <div class="wrap">
      <p class="eyebrow">Approach</p>
      <h2 class="sec__title">What it is, what it isn't.</h2>
      <p class="lede sec__lede">
        CarotOS is not an alternative to distributions that ship large tool
        sets. It adds ten tools and the interfaces to operate them on top of a
        Debian install. The goal is not a higher tool count but a base that
        works in a classroom.
      </p>

      <div class="grid grid--3 sec__grid">
        {
          philosophy.map((p) => (
            <article class="card">
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <Wave from="#deedf8" to="#a9cfea" />

  {/* ============================================================
      WHAT'S INSIDE
      ============================================================ */}
  <section id="inside" class="band band--tide">
    <div class="wrap">
      <p class="eyebrow">Applications</p>
      <h2 class="sec__title">What we ship.</h2>
      <p class="lede sec__lede">
        Four applications written for this project in Python and GTK3,
        distributed under the GPL-3.0.
      </p>

      <div class="grid grid--2 sec__grid">
        {
          apps.map((a, i) => (
            <article class="card app">
              <span class="app__no">{String(i + 1).padStart(2, "0")}</span>
              <div>
                <h3>{a.title}</h3>
                <p>{a.text}</p>
              </div>
            </article>
          ))
        }
      </div>

      <div class="tools">
        <h3 class="tools__title">Installed tools</h3>
        <ul class="tools__list">
          {
            tools.map((t) => (
              <li class="tool">
                <span class="tool__hex" aria-hidden="true" />
                <span class="tool__name">{t.name}</span>
                <span class="tool__job">{t.job}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="gorseller">
        <h3 class="tools__title">Screenshots</h3>
        <Slayt lang="en" slaytlar={slides} />
      </div>
    </div>
  </section>

  <Wave from="#a9cfea" to="#185fa5" />

  {/* ============================================================
      DOWNLOAD
      ============================================================ */}
  <section id="download" class="band band--deep">
    <div class="wrap">
      <p class="eyebrow">Download</p>
      <h2 class="sec__title">Release {release.tag} “{release.codename}”</h2>
      <p class="lede sec__lede">
        BIOS and UEFI installs are both tested. A signed shim ships in the ISO
        for Secure Boot. Firmware packages for Wi-Fi, audio and graphics
        hardware are included.
      </p>

      <div class="dl">
        <article class="dl__card">
          <div class="dl__head">
            <div>
              <p class="dl__arch">Desktop</p>
              <p class="dl__isa mono">x86_64</p>
            </div>
            <span class="dl__badge">Stable · {release.codename}</span>
          </div>

          <ul class="dl__meta">
            <li><span>File</span><span class="mono">{release.file}</span></li>
            <li><span>Size</span><span class="mono">{release.size}</span></li>
            <li><span>Desktop</span><span>XFCE</span></li>
            <li><span>Released</span><span>{release.date}</span></li>
          </ul>

          <a class="btn btn--light dl__btn" href={release.url}>
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M12 3v13m0 0 5-5m-5 5-5-5M4 20h16"
                stroke="currentColor"
                stroke-width="2.1"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
            <span>Download the ISO</span>
          </a>

          <div class="verify">
            <p class="verify__hash">
              <span class="verify__hash-label">SHA-256</span>
              <code>{release.sha256}</code>
            </p>
            <a class="verify__link" href={release.shaUrl}
              >{release.file}.sha256</a
            >
          </div>
        </article>

        <div class="dl__yan">
          <div class="req">
            <p class="dl__soon-title">System requirements</p>
            <ul class="req__list">
              {
                requirements.map((r) => (
                  <li>
                    <span>{r.name}</span>
                    <span>{r.value}</span>
                  </li>
                ))
              }
            </ul>
            <p class="req__not">
              Recommended minimums for a Debian 13 “trixie” desktop install.
              XFCE uses fewer resources than GNOME or KDE Plasma. Debian 13
              does not support the i386 architecture.
            </p>
          </div>

          <div class="dl__soon">
          <p class="dl__soon-title">In progress</p>

          <article class="soon">
            <div>
              <p class="soon__arch">CarotDeck</p>
              <p class="soon__isa mono">arm64</p>
            </div>
            <p class="soon__note">
              A portable build running i3wm on the Orange Pi 4 Pro. Target idle
              memory use is 200 MB.
            </p>
            <span class="soon__tag">In development</span>
          </article>

            <p class="dl__soon-foot">
              Builds for other desktop environments are planned.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Wave from="#185fa5" to="#0b2e52" />

  {/* ============================================================
      RELEASES / NEWSLETTER
      ============================================================ */}
  <section id="releases" class="band band--abyss news">
    <div class="wrap">
      <p class="eyebrow">Releases</p>
      <h2 class="sec__title">Release notifications</h2>
      <p class="lede sec__lede">
        Release notes are published on GitHub: tools added, bugs fixed,
        backwards-incompatible changes.
      </p>

      <div class="news__grid">
        <div class="news__card news__card--wide">
          <h3>Email newsletter</h3>
          <p>
            Release notes sent by email. Addresses are not used for any other
            purpose.
          </p>

          <form class="sub" id="newsletter">
            <label class="visually-hidden" for="email">Your email address</label
            >
            <input
              id="email"
              name="email"
              type="email"
              required
              placeholder="you@example.com"
              autocomplete="email"
            />
            <button class="btn btn--light" type="submit">Join</button>
          </form>
          <p class="sub__note">
            Join opens the mail application with a prepared message.
          </p>
        </div>

        <div class="news__card">
          <h3>GitHub</h3>
          <p>
            Selecting <strong>Watch → Custom → Releases</strong> on the
            repository sends a notification for every release.
          </p>
          <a
            class="btn btn--outline-light news__btn"
            href="https://github.com/MiracLight/CarotOS/releases"
            target="_blank"
            rel="noopener noreferrer">Releases</a
          >
        </div>

        <div class="news__card">
          <h3>RSS / Atom</h3>
          <p>
            The release feed can be added to a reader directly. No sign-up
            required.
          </p>
          <a
            class="btn btn--outline-light news__btn"
            href="https://github.com/MiracLight/CarotOS/releases.atom"
            target="_blank"
            rel="noopener noreferrer">Feed address</a
          >
        </div>
      </div>

      <p class="news__last">
        Latest release <strong>{release.tag}</strong> — {release.date}
      </p>
    </div>
  </section>
</Base>

<script>
  /* Newsletter form.
     Not wired to an email service yet; on submit it opens the visitor's
     mail app with a prepared message. Once you move to Buttondown,
     Mailchimp or similar, delete this block and give the form an
     action + method instead. */
  const form = document.getElementById("newsletter") as HTMLFormElement | null;
  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const field = document.getElementById("email") as HTMLInputElement;
    if (!field.checkValidity()) {
      field.reportValidity();
      return;
    }
    const subject = encodeURIComponent("Newsletter signup");
    const body = encodeURIComponent(
      `Hello,\n\nI'd like to join the CarotOS release newsletter.\nMy email address: ${field.value}\n`,
    );
    window.location.href = `mailto:carotosproject@gmail.com?subject=${subject}&body=${body}`;
  });
</script>

<style>
  /* Stiller Türkçe sayfayla birebir aynı.
     Astro stilleri bileşen bazlı kapsamlandırdığı için tekrar gerekiyor. */

  .hero {
    padding-bottom: clamp(3rem, 6vw, 4.5rem);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .hero__text h1 {
    margin-bottom: 1.4rem;
  }

  .hero__lede {
    max-width: 46ch;
  }

  .hero__lede strong {
    color: var(--deep);
    font-weight: 600;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2.2rem;
  }

  .hero__size {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    opacity: 0.72;
    padding-left: 0.6rem;
    margin-left: 0.15rem;
    border-left: 1px solid rgba(255, 255, 255, 0.32);
  }

  .hero__art {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 320px;
  }

  .hero__turtle {
    position: relative;
    width: min(100%, 330px);
    z-index: 1;
    line-height: 0;
    animation: bob 7s ease-in-out infinite;
  }

  .hero__turtle :global(svg) {
    width: 100%;
    height: auto;
    display: block;
  }

  @keyframes bob {
    0%,
    100% {
      transform: translateY(0) rotate(-2deg);
    }
    50% {
      transform: translateY(-14px) rotate(2deg);
    }
  }

  .ripple {
    position: absolute;
    border-radius: 50%;
    border: 1.5px solid var(--current);
    opacity: 0;
    animation: spread 6s ease-out infinite;
  }

  .ripple--1 {
    width: 300px;
    height: 300px;
    animation-delay: 0s;
  }
  .ripple--2 {
    width: 300px;
    height: 300px;
    animation-delay: 2s;
  }
  .ripple--3 {
    width: 300px;
    height: 300px;
    animation-delay: 4s;
  }

  @keyframes spread {
    0% {
      transform: scale(0.55);
      opacity: 0.42;
    }
    100% {
      transform: scale(1.65);
      opacity: 0;
    }
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 1.5rem;
    margin: clamp(3rem, 6vw, 4.5rem) 0 0;
    padding-top: 2.2rem;
    border-top: 1.5px solid rgba(24, 95, 165, 0.16);
  }

  .facts__item {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .facts__num {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.7rem, 3.4vw, 2.4rem);
    letter-spacing: -0.03em;
    color: var(--deep);
    line-height: 1.1;
  }

  .facts__label {
    margin: 0;
    font-size: 0.88rem;
    color: var(--ink-soft);
    line-height: 1.4;
  }

  .sec__title {
    margin-bottom: 1.2rem;
  }

  .sec__lede strong {
    font-weight: 600;
  }

  .band--shallow .sec__lede strong {
    color: var(--deep);
  }

  .sec__grid {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }

  .app {
    display: flex;
    gap: 1.15rem;
    align-items: flex-start;
    background: rgba(255, 255, 255, 0.72);
  }

  .app__no {
    flex: none;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--deep);
    background: rgba(255, 255, 255, 0.85);
    width: 38px;
    height: 42px;
    display: grid;
    place-items: center;
    clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);
  }

  .tools {
    margin-top: clamp(3rem, 6vw, 4.5rem);
    padding-top: 2.4rem;
    border-top: 1.5px solid rgba(24, 95, 165, 0.2);
  }

  .tools__title {
    margin-bottom: 1.6rem;
  }

  .tools__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 0.9rem 1.6rem;
  }

  .tool {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto auto;
    column-gap: 0.7rem;
    align-items: center;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid rgba(24, 95, 165, 0.16);
  }

  .tool__hex {
    grid-row: 1 / 3;
    width: 12px;
    height: 13.5px;
    background: var(--deep);
    clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);
  }

  .tool__name {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.95rem;
    color: var(--ink);
  }

  .tool__job {
    font-size: 0.83rem;
    color: var(--ink-soft);
    line-height: 1.35;
  }

  .gorseller {
    margin-top: clamp(3rem, 6vw, 4.5rem);
    padding-top: 2.4rem;
    border-top: 1.5px solid rgba(24, 95, 165, 0.2);
  }

  .dl__yan {
    display: grid;
    gap: var(--gap);
    align-content: start;
  }

  .req {
    background: rgba(255, 255, 255, 0.06);
    border: 1.5px solid rgba(169, 198, 224, 0.24);
    border-radius: var(--r-lg);
    padding: clamp(1.4rem, 2.5vw, 1.9rem);
  }

  .req__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }

  .req__list li {
    display: flex;
    justify-content: space-between;
    gap: 0.9rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(169, 198, 224, 0.14);
    font-size: 0.88rem;
  }

  .req__list li span:first-child {
    color: var(--on-dark-soft);
    flex: none;
  }

  .req__list li span:last-child {
    color: var(--on-dark);
