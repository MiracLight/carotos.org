    degisiklikler: [
      { tur: "eklendi", metin: "Instalación desde el escritorio en vivo: el icono «Instalar CarotOS» del escritorio abre el instalador Calamares; turco e inglés, cifrado de disco (LUKS), instalación sin conexión desde la ISO y diapositivas de CarotOS durante la instalación. El instalador anterior sigue en el menú de arranque como alternativa" },
      { tur: "eklendi", metin: "Recuperación: guarda el estado actual del sistema como punto de restauración y vuelve a él si algo se rompe; disponible en el panel superior y en el panel lateral de Carot Sleek" },
