      "Primera versión estable. Base Debian 13 «trixie», escritorio XFCE, diez herramientas de seguridad y cuatro aplicaciones propias.",
    degisiklikler: [
      { tur: "eklendi", metin: "Panel de seguridad: una interfaz gráfica para las diez herramientas, con documentación de los campos y salida en vivo" },
      { tur: "eklendi", metin: "Asistente de bienvenida: una introducción bilingüe de once páginas con selección de tema e idioma" },
      { tur: "eklendi", metin: "Salud del sistema: veinte comprobaciones en seis categorías, una puntuación de salud y doce correcciones con un clic" },
      { tur: "eklendi", metin: "Revisión de USB: comprueba los dispositivos conectados en busca de autorun.inf, dobles extensiones y extensiones ocultas" },
      { tur: "eklendi", metin: "Instalación en BIOS y UEFI, con un shim firmado para el arranque seguro (Secure Boot)" },
      { tur: "eklendi", metin: "Conjunto completo de firmware para hardware de Wi-Fi, audio y gráficos" },
      { tur: "eklendi", metin: "Turco como idioma predeterminado, con el inglés disponible" },
      { tur: "duzeltildi", metin: "nikto no se ejecutaba en un sistema instalado; se añadió una dependencia que faltaba" },
      { tur: "duzeltildi", metin: "El idioma elegido en el asistente no se aplicaba tras reiniciar la sesión" },
      { tur: "duzeltildi", metin: "Faltaban iconos del panel y del menú con algunos temas" },
    ],
  },
];

const etiketler: Record<string, string> = {
  eklendi: "Añadido",
  duzeltildi: "Corregido",
  degisti: "Cambiado",
  kaldirildi: "Eliminado",
};
---

<Base
  lang="es"
  title="Registro de cambios — CarotOS"
  description="Qué cambió en cada versión de CarotOS: herramientas añadidas, errores corregidos y cambios que rompen la compatibilidad."
>
  <section class="band band--foam log__intro">
    <div class="wrap">
      <p class="eyebrow">Registro de cambios</p>
      <h1 class="log__h1">Qué ha cambiado</h1>
      <p class="lede">
        Aquí se listan, para cada versión, las herramientas añadidas, los
        errores corregidos y los cambios que rompen la compatibilidad. Las
        mismas notas se publican en la página de versiones de GitHub.
      </p>
      <div class="log__links">
        <a class="btn btn--ghost" href="/es#download">Descargar</a>
        <a
          class="btn btn--ghost"
          href="https://github.com/MiracLight/CarotOS/releases"
          target="_blank"
          rel="noopener noreferrer">Versiones en GitHub</a
        >
      </div>
    </div>
  </section>

  <Wave from="#f4f9fd" to="#deedf8" />

  <section class="band band--shallow">
    <div class="wrap">
      {
        surumler.map((s) => (
          <article class="rel">
            <header class="rel__head">
              <h2 class="rel__tag">
                {s.etiket} <span class="rel__code">“{s.kodAdi}”</span>
              </h2>
              <time class="rel__date mono" datetime={s.tarihISO}>
                {s.tarih}
              </time>
            </header>

            <p class="rel__ozet">{s.ozet}</p>

            <ul class="rel__list">
              {s.degisiklikler.map((d) => (
                <li class="rel__item">
                  <span class={`tag tag--${d.tur}`}>{etiketler[d.tur]}</span>
                  <span class="rel__text">{d.metin}</span>
                </li>
              ))}
            </ul>
          </article>
        ))
      }

      <p class="log__son">
        No hay versiones anteriores: la 1.0 es la primera estable. Las
        compilaciones intermedias del desarrollo nunca se publicaron.
      </p>
    </div>
  </section>
</Base>

<style>
  .log__intro {
    padding-bottom: clamp(3rem, 6vw, 4rem);
  }

  .log__h1 {
    font-size: clamp(2.4rem, 6vw, 4rem);
    margin-bottom: 1.1rem;
  }

  .log__links {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
    margin-top: 2rem;
  }

  .rel {
    max-width: 78ch;
  }

  .rel + .rel {
    margin-top: 3.5rem;
    padding-top: 3.5rem;
    border-top: 1.5px solid rgba(24, 95, 165, 0.2);
  }

  .rel__head {
    display: flex;
    align-items: baseline;
    gap: 1rem 1.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.9rem;
  }

  .rel__tag {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    margin: 0;
  }

  .rel__code {
    color: var(--current);
    font-weight: 700;
  }

  .rel__date {
    color: var(--ink-faint);
    font-size: 0.85rem;
  }

  .rel__ozet {
    color: var(--ink-soft);
    font-size: 1.02rem;
    margin-bottom: 1.8rem;
    max-width: var(--w-text);
  }

  .rel__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.7rem;
  }

  .rel__item {
    display: grid;
    grid-template-columns: 92px 1fr;
    gap: 0.9rem;
    align-items: baseline;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid rgba(24, 95, 165, 0.13);
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-align: center;
    padding: 0.24rem 0.4rem;
    border-radius: 4px;
    white-space: nowrap;
  }

  .tag--eklendi {
    background: rgba(74, 156, 120, 0.16);
    color: #2f6f52;
  }

  .tag--duzeltildi {
    background: rgba(55, 138, 218, 0.16);
    color: var(--deep);
  }

  .tag--degisti {
    background: rgba(24, 95, 165, 0.1);
    color: var(--ink-soft);
  }

  .tag--kaldirildi {
    background: rgba(160, 90, 90, 0.14);
    color: #8a4646;
  }

  .rel__text {
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .log__son {
    margin-top: 3rem;
    font-size: 0.88rem;
    color: var(--ink-faint);
  }

  @media (max-width: 560px) {
    .rel__item {
      grid-template-columns: 1fr;
      gap: 0.3rem;
    }

    .tag {
      justify-self: start;
    }
  }
</style>
