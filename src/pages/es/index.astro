const poligonApps = [
  {
    title: "CarotOS Poligon",
    icon: "/ikonlar/ikon-poligon-ogrenci.webp",
    screenshot: "/ekranlar/poligon-ogrenci.webp",
    alt: "Aplicación de estudiante de CarotOS Poligon: opciones de invitado, crear cuenta e iniciar sesión",
    text: "Puedes usarlo como invitado, sin cuenta, o iniciar sesión con una cuenta de usuario. El progreso se guarda en las cuentas con sesión iniciada. Las tareas se completan en solitario o uniéndose a una sala de clase.",
  },
  {
    title: "CarotOS Poligon — Profesor",
    icon: "/ikonlar/ikon-poligon-ogretmen.webp",
    screenshot: "/ekranlar/poligon-ogretmen.webp",
    alt: "Aplicación de profesor de CarotOS Poligon: código de sala, contraseña de sala, lista de estudiantes y campo de pistas",
    text: "El código y la contraseña de la sala se generan con un clic. Las vistas de estudiantes y de clase, la redacción de preguntas y las preguntas guardadas están en pestañas separadas. Se puede enviar una pista a un estudiante o a toda la clase.",
  },
];

const securityApps = [
  {
    title: "CarotPot",
    icon: "/ikonlar/ikon-carotpot.webp",
    screenshot: "/ekranlar/carotpot.webp",
    ratio: "1280 / 820",
    alt: "Panel de CarotPot: trampas activadas, un gráfico de actividad por horas, eventos por trampa, los atacantes más activos y una actividad en vivo",
    text: "Detecta los dispositivos de la red local que analizan este equipo o intentan iniciar sesión en él. Abre ocho servicios falsos: SSH, panel web, Telnet, FTP, VNC, RDP, MySQL y Redis. El panel muestra la actividad de las últimas 24 horas y los atacantes más activos. El perfil de un atacante lista los usuarios probados, las contraseñas enmascaradas y una puntuación de riesgo. Bloquear un dispositivo pide tu confirmación.",
  },
  {
    title: "Carotene",
    icon: "/ikonlar/ikon-carotene.webp",
    screenshot: "/ekranlar/carotene.webp",
    ratio: "1040 / 700",
    alt: "Carotene: el resultado de un análisis con dos amenazas encontradas, la antigüedad de las definiciones de virus y las opciones de análisis",
    text: "Realiza análisis rápidos, de la carpeta personal y de carpetas a tu elección con ClamAV. Mientras se ejecuta un análisis, el número de archivos analizados y los hallazgos se actualizan en vivo. Los archivos detectados se pueden poner en cuarentena, eliminar o ignorar. La antigüedad de las definiciones de virus aparece en la pantalla principal y se actualizan desde la aplicación. Un resultado limpio no garantiza que los archivos sean seguros, solo indica que no se encontró ninguna firma conocida.",
  },
];

const tools = [
  { name: "nmap", job: "Análisis de red y de puertos" },
  { name: "tcpdump", job: "Captura de paquetes" },
  { name: "tshark", job: "Análisis de tráfico" },
  { name: "aircrack-ng", job: "Pruebas de redes inalámbricas" },
  { name: "nikto", job: "Análisis de servidores web" },
  { name: "sqlmap", job: "Pruebas de inyección SQL" },
  { name: "john", job: "Análisis de la fortaleza de contraseñas" },
  { name: "hydra", job: "Pruebas de autenticación" },
  { name: "ufw", job: "Cortafuegos" },
  { name: "fail2ban", job: "Prevención de intrusiones" },
];
---

<Base
  lang="es"
  title="CarotOS | Una distribución de Linux para aprender ciberseguridad"
  description="Una distribución de Linux basada en Debian 13 y orientada a la enseñanza, con diez herramientas de seguridad y trece aplicaciones propias."
>
  {/* ============================================================
      HERO
      ============================================================ */}
  <section class="band band--foam hero">
    <div class="wrap hero__inner">
      <div class="hero__text">
        <p class="eyebrow">Debian 13 · XFCE · amd64</p>
        <h1>Pocas, bien explicadas.</h1>
        <p class="lede hero__lede">
          CarotOS es una distribución de Linux creada para la enseñanza de la
          ciberseguridad. Incluye diez herramientas de seguridad y trece
          aplicaciones escritas para el proyecto.
        </p>

        <div class="hero__actions">
          <a class="btn btn--solid" href="#download">
            <span>Descargar</span>
            <span class="hero__size">{release.size}</span>
          </a>
          <a
            class="btn btn--ghost"
            href="https://github.com/MiracLight/CarotOS"
            target="_blank"
            rel="noopener noreferrer">Código fuente</a
          >
        </div>
      </div>

      <div class="hero__art" aria-hidden="true">
        <span class="ripple ripple--1"></span>
        <span class="ripple ripple--2"></span>
        <span class="ripple ripple--3"></span>
        <div class="hero__turtle" data-minigame-trigger>
          <Turtle shell="#378ADA" body="#185FA5" />
        </div>
      </div>
    </div>

    <div class="wrap">
      <dl class="facts">
        {
          facts.map((f) => (
            <div class="facts__item">
              <dt class="facts__num">{f.num}</dt>
              <dd class="facts__label">{f.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <Wave from="#f4f9fd" to="#deedf8" />

  {/* ============================================================
      PHILOSOPHY
      ============================================================ */}
  <section id="philosophy" class="band band--shallow">
    <div class="wrap">
      <p class="eyebrow">Enfoque</p>
      <h2 class="sec__title">Alcance y principios de diseño</h2>
      <p class="lede sec__lede">
        CarotOS no es una alternativa a las distribuciones que incluyen enormes
        colecciones de herramientas. Añade diez herramientas y las interfaces
        para manejarlas sobre una instalación de Debian. El objetivo no es
        tener más herramientas, sino una base que funcione en un aula.
      </p>

      <div class="grid grid--2 sec__grid">
        {
          philosophy.map((p) => (
            <article class="card">
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <Wave from="#deedf8" to="#a9cfea" />

  {/* ============================================================
      WHAT'S INSIDE
      ============================================================ */}
  <section id="inside" class="band band--tide">
    <div class="wrap">
      <p class="eyebrow">Aplicaciones</p>
      <h2 class="sec__title">Aplicaciones y herramientas</h2>
      <p class="lede sec__lede">
        Trece aplicaciones escritas para este proyecto en Python y GTK3,
        distribuidas bajo la GPL-3.0.
      </p>

      <div class="grid grid--2 sec__grid">
        {
          apps.map((a, i) => (
            <article class="card app">
              {a.icon ? (
                <img
                  class="app__logo"
                  src={a.icon}
                  alt=""
                  width="44"
                  height="44"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <span class="app__no">{String(i + 1).padStart(2, "0")}</span>
              )}
              <div>
                <h3>
                  {a.title}
                  {a.yeni && <span class="app__tag">{a.yeni}</span>}
                </h3>
                <p>{a.text}</p>
                {a.links && (
                  <p class="app__links">
                    {a.links.map((l) => (
                      <a href={l.url} rel="noopener">{l.label}</a>
                    ))}
                  </p>
                )}
              </div>
            </article>
          ))
        }
      </div>

      <div class="tools">
        <h3 class="tools__title">Herramientas instaladas</h3>
        <ul class="tools__list">
          {
            tools.map((t) => (
              <li class="tool">
                <span class="tool__hex" aria-hidden="true" />
                <span class="tool__name">{t.name}</span>
                <span class="tool__job">{t.job}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="gorseller">
        <h3 class="tools__title">Capturas de pantalla</h3>
        <Slayt lang="es" slaytlar={slides} />
      </div>

      <div class="poligon">
        <h3 class="tools__title">CarotOS Poligon</h3>
        <p class="lede poligon__lede">
          Un entorno de pruebas de penetración aislado y seguro para estudiantes
          y profesorado. El profesor crea una sala de clase; los estudiantes
          completan las tareas con herramientas reales en sus propios equipos.
          No hay componentes expuestos a la red. Todas las operaciones se
          ejecutan en el equipo local.
        </p>
        <div class="grid grid--2 poligon__grid">
          {
            poligonApps.map((p) => (
              <article class="card poligon__card">
                <div class="poligon__head">
                  <img src={p.icon} alt="" class="poligon__ikon" width="40" height="40" />
                  <h4>{p.title}</h4>
                </div>
                <p>{p.text}</p>
                <div class="poligon__ekran-cerceve">
                  <img
                    src={p.screenshot}
                    alt={p.alt}
                    class="poligon__ekran"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              </article>
            ))
          }
        </div>
      </div>

      <div class="poligon">
        <h3 class="tools__title">CarotPot y Carotene</h3>
        <p class="lede poligon__lede">
          Dos aplicaciones para la seguridad de la red y de los archivos.
          CarotPot detecta análisis e intentos de inicio de sesión en la red
          local mediante servicios falsos. Carotene analiza archivos con
          ClamAV. Ninguna de las dos se ejecuta en segundo plano si tú no la
          inicias.
        </p>
        <div class="grid grid--2 poligon__grid">
          {
            securityApps.map((p) => (
              <article class="card poligon__card">
                <div class="poligon__head">
                  <img src={p.icon} alt="" class="poligon__ikon" width="40" height="40" />
                  <h4>{p.title}</h4>
                </div>
                <p>{p.text}</p>
                <div class="poligon__ekran-cerceve" style={`aspect-ratio: ${p.ratio}`}>
                  <img
                    src={p.screenshot}
                    alt={p.alt}
                    class="poligon__ekran"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <Wave from="#a9cfea" to="#185fa5" />

  {/* ============================================================
      DOWNLOAD
      ============================================================ */}
  <section id="download" class="band band--deep">
    <div class="wrap">
      <p class="eyebrow">Descarga</p>
      <h2 class="sec__title">Versión {release.tag} “{release.codename}”</h2>
      <p class="lede sec__lede">
        Instala directamente desde el escritorio en vivo con el icono «Instalar
        CarotOS». Se han probado las instalaciones tanto en BIOS como en UEFI.
        La ISO incluye un shim firmado para el arranque seguro (Secure Boot).
        Se incluyen los paquetes de firmware para el hardware de Wi-Fi, audio y
        gráficos.
      </p>

      <div class="dl">
        <article class="dl__card">
          <div class="dl__head">
            <div>
              <p class="dl__arch">Escritorio</p>
              <p class="dl__isa mono">x86_64</p>
            </div>
            <span class="dl__badge">Estable · {release.codename}</span>
          </div>

          <ul class="dl__meta">
            <li><span>Archivo</span><span class="mono">{release.file}</span></li>
            <li><span>Tamaño</span><span class="mono">{release.size}</span></li>
            <li><span>Escritorio</span><span>XFCE</span></li>
            <li><span>Publicada</span><span>{release.date}</span></li>
          </ul>

          <a class="btn btn--light dl__btn" href={release.url}>
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M12 3v13m0 0 5-5m-5 5-5-5M4 20h16"
                stroke="currentColor"
                stroke-width="2.1"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
            <span>Descargar la ISO</span>
          </a>

          <div class="verify">
            <p class="verify__hash">
              <span class="verify__hash-label">SHA-256</span>
              <code>{release.sha256}</code>
            </p>
            <a class="verify__link" href={release.shaUrl}
              >{release.file}.sha256</a
            >
          </div>
        </article>

        <div class="dl__yan">
          <div class="req">
            <p class="dl__soon-title">Requisitos del sistema</p>
            <ul class="req__list">
              {
                requirements.map((r) => (
                  <li>
                    <span>{r.name}</span>
                    <span>{r.value}</span>
                  </li>
                ))
              }
            </ul>
            <p class="req__not">
              Mínimos recomendados para una instalación de escritorio de
              Debian 13 «trixie». XFCE consume menos recursos que GNOME o KDE
              Plasma. Debian 13 no admite la arquitectura i386.
            </p>
          </div>

          <div class="dl__soon">
          <p class="dl__soon-title">Proyectos previstos</p>

          <article class="soon">
            <div>
              <p class="soon__arch">CarotOS AUL</p>
              <p class="soon__isa mono">arm64</p>
            </div>
            <p class="soon__note">
              Una versión ligera basada en Armbian (Armbian Ultra Light). Funciona con IceWM en placas arm64 como la Orange Pi 5. El consumo de memoria en reposo previsto es de 200 MB.
            </p>
            <span class="soon__tag">En desarrollo</span>
          </article>

            <p class="dl__soon-foot">
              CarotDeck, un proyecto de hardware portátil, llegará más adelante.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Wave from="#185fa5" to="#0b2e52" />

  {/* ============================================================
      RELEASES / NEWSLETTER
      ============================================================ */}
  <section id="releases" class="band band--abyss news">
    <div class="wrap">
      <p class="eyebrow">Versiones</p>
      <h2 class="sec__title">Avisos de nuevas versiones</h2>
      <p class="lede sec__lede">
        Las notas de cada versión se publican en GitHub: herramientas
        añadidas, errores corregidos y cambios que rompen la compatibilidad.
      </p>

      <div class="news__grid">
        <div class="news__card news__card--wide">
          <h3>Boletín por correo</h3>
          <p>
            Las notas de cada versión llegan por correo. Las direcciones no se
            usan para ningún otro fin.
          </p>

          <div class="sub__frame">
            <iframe
              src="https://67633d94.sibforms.com/v2/serve/MUIFAGmcZ6uZ8ACuV_vY5RZNYRnoRnMLIWTNt8PXoCujQnM0CA3Uf1SLr7wMqEJeSE78095pYIsM1mixN7-ftp9CVz4JEgXivRME_UO6L_0MSsc13UC0SCaD33HOpUUWlRCV-F-mHG0Y1Qug40xaa3yI0V5_S0aLMdzqXrzlXVQzY_uarxTztLRgaX_9d1MPCyOlHgaUFnaVYrSxtQ=="
              title="Suscripción al boletín"
              loading="lazy"
              scrolling="no"
              frameborder="0"></iframe>
          </div>
          <p class="sub__note">Tu dirección se usa solo para noticias de las versiones. El registro se completa al hacer clic en el enlace del correo que recibes; cada correo incluye un enlace para darte de baja. El envío se hace con Brevo.</p>
        </div>

        <div class="news__card">
          <h3>GitHub</h3>
          <p>
            Si en el repositorio eliges <strong>Watch → Custom → Releases</strong>,
            recibirás una notificación con cada versión.
          </p>
          <a
            class="btn btn--outline-light news__btn"
            href="https://github.com/MiracLight/CarotOS/releases"
            target="_blank"
            rel="noopener noreferrer">Versiones</a
          >
        </div>

        <div class="news__card">
          <h3>RSS / Atom</h3>
          <p>
            El canal de versiones se puede añadir directamente a un lector. No
            hace falta registrarse.
          </p>
          <a
            class="btn btn--outline-light news__btn"
            href="https://github.com/MiracLight/CarotOS/releases.atom"
            target="_blank"
            rel="noopener noreferrer">Dirección del canal</a
          >
        </div>
      </div>

      <p class="news__last">
        Última versión <strong>{release.tag}</strong> — {release.date}
      </p>
    </div>
  </section>
  <Minigame lang="es" />
</Base>
