    icon: "/ikonlar/ikon-poligon-ogrenci.webp",
    screenshot: "/ekranlar/poligon-ogrenci.webp",
    alt: "Application élève de CarotOS Poligon : options invité, création de compte et connexion",
    text: "Vous pouvez l’utiliser en invité, sans compte, ou vous connecter avec un compte utilisateur. La progression est enregistrée pour les comptes connectés. Les exercices se font seul ou en rejoignant une salle de classe.",
  },
  {
    title: "CarotOS Poligon Enseignant",
    icon: "/ikonlar/ikon-poligon-ogretmen.webp",
    screenshot: "/ekranlar/poligon-ogretmen.webp",
    alt: "Application enseignant de CarotOS Poligon : code de la salle, mot de passe de la salle, liste des élèves et champ d’indice",
    text: "Un code et un mot de passe de salle sont générés en un clic. Les vues par élève et par classe, la rédaction de questions et les questions enregistrées se trouvent dans des onglets distincts. Un indice peut être envoyé à un seul élève ou à toute la classe.",
  },
];

const securityApps = [
  {
    title: "CarotPot",
    icon: "/ikonlar/ikon-carotpot.webp",
    screenshot: "/ekranlar/carotpot.webp",
    ratio: "1280 / 820",
    alt: "Tableau de bord de CarotPot : pièges activés, graphique d’activité horaire, événements par piège, attaquants les plus actifs et flux en direct",
    text: "Détecte les appareils du réseau local qui analysent cet ordinateur ou essaient de s’y connecter. Il ouvre huit faux services : SSH, panneau web, Telnet, FTP, VNC, RDP, MySQL et Redis. Le tableau de bord montre l’activité des dernières 24 heures et les attaquants les plus actifs. Un profil d’attaquant liste les noms d’utilisateur essayés, les mots de passe masqués et un score de risque. Bloquer un appareil demande votre confirmation.",
  },
  {
    title: "Carotene",
    icon: "/ikonlar/ikon-carotene.webp",
    screenshot: "/ekranlar/carotene.webp",
    ratio: "1040 / 700",
    alt: "Carotene : un résultat d’analyse avec deux menaces trouvées, l’ancienneté des définitions antivirus et les options d’analyse",
    text: "Lance avec ClamAV des analyses rapide, du dossier personnel et d’un dossier au choix. Pendant l’analyse, le nombre de fichiers analysés et les résultats se mettent à jour en direct. Les fichiers détectés peuvent être mis en quarantaine, supprimés ou ignorés. L’ancienneté des définitions antivirus est affichée sur l’écran principal, et elles se mettent à jour depuis l’application. Un résultat « propre » ne garantit pas que les fichiers sont sûrs : il montre seulement qu’aucune signature connue n’a été trouvée.",
  },
];

const tools = [
  { name: "nmap", job: "Analyse du réseau et des ports" },
  { name: "tcpdump", job: "Capture de paquets" },
  { name: "tshark", job: "Analyse du trafic" },
  { name: "aircrack-ng", job: "Tests de réseaux sans fil" },
  { name: "nikto", job: "Analyse de serveurs web" },
  { name: "sqlmap", job: "Tests d’injection SQL" },
  { name: "john", job: "Analyse de la robustesse des mots de passe" },
  { name: "hydra", job: "Tests d’authentification" },
  { name: "ufw", job: "Pare-feu" },
  { name: "fail2ban", job: "Prévention des intrusions" },
];
---

<Base
  lang="fr"
  title="CarotOS | Une distribution Linux pour apprendre la cybersécurité"
  description="Une distribution Linux basée sur Debian 13 et axée sur l’enseignement, avec dix outils de sécurité et treize applications originales."
>
  {/* ============================================================
      HERO
      ============================================================ */}
  <section class="band band--foam hero">
    <div class="wrap hero__inner">
      <div class="hero__text">
        <p class="eyebrow">Debian 13 · XFCE · amd64</p>
        <h1>Peu d’outils, bien expliqués.</h1>
        <p class="lede hero__lede">
          CarotOS est une distribution Linux conçue pour l’enseignement de la
          cybersécurité. Elle fournit dix outils de sécurité et treize
          applications écrites pour le projet.
        </p>

        <div class="hero__actions">
          <a class="btn btn--solid" href="#download">
            <span>Télécharger</span>
            <span class="hero__size">{release.size}</span>
          </a>
          <a
            class="btn btn--ghost"
            href="https://github.com/MiracLight/CarotOS"
            target="_blank"
            rel="noopener noreferrer">Code source</a
          >
        </div>
      </div>

      <div class="hero__art" aria-hidden="true">
        <span class="ripple ripple--1"></span>
        <span class="ripple ripple--2"></span>
        <span class="ripple ripple--3"></span>
        <div class="hero__turtle" data-minigame-trigger>
          <Turtle shell="#378ADA" body="#185FA5" />
        </div>
      </div>
    </div>

    <div class="wrap">
      <dl class="facts">
        {
          facts.map((f) => (
            <div class="facts__item">
              <dt class="facts__num">{f.num}</dt>
              <dd class="facts__label">{f.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <Wave from="#f4f9fd" to="#deedf8" />

  {/* ============================================================
      PHILOSOPHY
      ============================================================ */}
  <section id="philosophy" class="band band--shallow">
    <div class="wrap">
      <p class="eyebrow">Démarche</p>
      <h2 class="sec__title">Périmètre et principes de conception</h2>
      <p class="lede sec__lede">
        CarotOS n’est pas une alternative aux distributions qui livrent de
        grands catalogues d’outils. Il ajoute dix outils et les interfaces pour
        les utiliser à une installation Debian. L’objectif n’est pas un plus
        grand nombre d’outils, mais une base qui fonctionne en classe.
      </p>

      <div class="grid grid--2 sec__grid">
        {
          philosophy.map((p) => (
            <article class="card">
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <Wave from="#deedf8" to="#a9cfea" />

  {/* ============================================================
      WHAT'S INSIDE
      ============================================================ */}
  <section id="inside" class="band band--tide">
    <div class="wrap">
      <p class="eyebrow">Applications</p>
      <h2 class="sec__title">Applications et outils</h2>
      <p class="lede sec__lede">
        Treize applications écrites pour ce projet en Python et GTK3,
        distribuées sous licence GPL-3.0.
      </p>

      <div class="grid grid--2 sec__grid">
        {
          apps.map((a, i) => (
            <article class="card app">
              {a.icon ? (
                <img
                  class="app__logo"
                  src={a.icon}
                  alt=""
                  width="44"
                  height="44"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <span class="app__no">{String(i + 1).padStart(2, "0")}</span>
              )}
              <div>
                <h3>
                  {a.title}
                  {a.yeni && <span class="app__tag">{a.yeni}</span>}
                </h3>
                <p>{a.text}</p>
                {a.links && (
                  <p class="app__links">
                    {a.links.map((l) => (
                      <a href={l.url} rel="noopener">{l.label}</a>
                    ))}
                  </p>
                )}
              </div>
            </article>
          ))
        }
      </div>

      <div class="tools">
        <h3 class="tools__title">Outils installés</h3>
        <ul class="tools__list">
          {
            tools.map((t) => (
              <li class="tool">
                <span class="tool__hex" aria-hidden="true" />
                <span class="tool__name">{t.name}</span>
                <span class="tool__job">{t.job}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="gorseller">
        <h3 class="tools__title">Captures d’écran</h3>
        <Slayt lang="fr" slaytlar={slides} />
      </div>

      <div class="poligon">
        <h3 class="tools__title">CarotOS Poligon</h3>
        <p class="lede poligon__lede">
          Un environnement de tests d’intrusion isolé et sûr pour les élèves et
          les enseignants. L’enseignant crée une salle de classe ; les élèves
          réalisent les exercices avec de vrais outils sur leur propre machine.
          Aucun composant n’est exposé au réseau. Toutes les opérations
          s’exécutent sur la machine locale.
        </p>
        <div class="grid grid--2 poligon__grid">
          {
            poligonApps.map((p) => (
              <article class="card poligon__card">
                <div class="poligon__head">
                  <img src={p.icon} alt="" class="poligon__ikon" width="40" height="40" />
                  <h4>{p.title}</h4>
                </div>
                <p>{p.text}</p>
                <div class="poligon__ekran-cerceve">
                  <img
                    src={p.screenshot}
                    alt={p.alt}
                    class="poligon__ekran"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              </article>
            ))
          }
        </div>
      </div>

      <div class="poligon">
        <h3 class="tools__title">CarotPot et Carotene</h3>
        <p class="lede poligon__lede">
          Deux applications pour la sécurité du réseau et des fichiers.
          CarotPot repère les analyses et les tentatives de connexion sur le
          réseau local grâce à de faux services. Carotene analyse les fichiers
          avec ClamAV. Aucune des deux ne tourne en arrière-plan tant que vous
          ne la lancez pas.
        </p>
        <div class="grid grid--2 poligon__grid">
          {
            securityApps.map((p) => (
              <article class="card poligon__card">
                <div class="poligon__head">
                  <img src={p.icon} alt="" class="poligon__ikon" width="40" height="40" />
                  <h4>{p.title}</h4>
                </div>
                <p>{p.text}</p>
                <div class="poligon__ekran-cerceve" style={`aspect-ratio: ${p.ratio}`}>
                  <img
                    src={p.screenshot}
                    alt={p.alt}
                    class="poligon__ekran"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <Wave from="#a9cfea" to="#185fa5" />

  {/* ============================================================
      DOWNLOAD
      ============================================================ */}
  <section id="download" class="band band--deep">
    <div class="wrap">
      <p class="eyebrow">Téléchargement</p>
      <h2 class="sec__title">Version {release.tag} « {release.codename} »</h2>
      <p class="lede sec__lede">
        Installez directement depuis le bureau live avec l’icône « Installer
        CarotOS ». Les installations en BIOS et en UEFI sont toutes deux
        testées. Un shim signé est inclus dans l’ISO pour Secure Boot. Les
        paquets de microprogrammes pour le Wi-Fi, le son et les cartes
        graphiques sont inclus.
      </p>

      <div class="dl">
        <article class="dl__card">
          <div class="dl__head">
            <div>
              <p class="dl__arch">Bureau</p>
              <p class="dl__isa mono">x86_64</p>
            </div>
            <span class="dl__badge">Stable · {release.codename}</span>
          </div>

          <ul class="dl__meta">
            <li><span>Fichier</span><span class="mono">{release.file}</span></li>
            <li><span>Taille</span><span class="mono">{release.size}</span></li>
            <li><span>Bureau</span><span>XFCE</span></li>
            <li><span>Publiée le</span><span>{release.date}</span></li>
          </ul>

          <a class="btn btn--light dl__btn" href={release.url}>
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M12 3v13m0 0 5-5m-5 5-5-5M4 20h16"
                stroke="currentColor"
                stroke-width="2.1"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
            <span>Télécharger l’ISO</span>
          </a>

          <div class="verify">
            <p class="verify__hash">
              <span class="verify__hash-label">SHA-256</span>
              <code>{release.sha256}</code>
            </p>
            <a class="verify__link" href={release.shaUrl}
              >{release.file}.sha256</a
            >
          </div>
        </article>

        <div class="dl__yan">
          <div class="req">
            <p class="dl__soon-title">Configuration requise</p>
            <ul class="req__list">
              {
                requirements.map((r) => (
                  <li>
                    <span>{r.name}</span>
                    <span>{r.value}</span>
                  </li>
                ))
              }
            </ul>
            <p class="req__not">
              Minimums recommandés pour une installation de bureau Debian 13
              « trixie ». XFCE consomme moins de ressources que GNOME ou KDE
              Plasma. Debian 13 ne prend pas en charge l’architecture i386.
            </p>
          </div>

          <div class="dl__soon">
          <p class="dl__soon-title">Projets prévus</p>

          <article class="soon">
            <div>
              <p class="soon__arch">CarotOS AUL</p>
              <p class="soon__isa mono">arm64</p>
            </div>
            <p class="soon__note">
              Une version légère basée sur Armbian (Armbian Ultra Light). Elle fonctionne avec IceWM sur des cartes arm64 comme l’Orange Pi 5. Objectif : 200 Mo de mémoire au repos.
            </p>
            <span class="soon__tag">En développement</span>
          </article>

            <p class="dl__soon-foot">
              CarotDeck, un projet de matériel portable, viendra plus tard.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Wave from="#185fa5" to="#0b2e52" />

  {/* ============================================================
      RELEASES / NEWSLETTER
      ============================================================ */}
  <section id="releases" class="band band--abyss news">
    <div class="wrap">
      <p class="eyebrow">Versions</p>
      <h2 class="sec__title">Notifications de publication</h2>
      <p class="lede sec__lede">
        Les notes de version sont publiées sur GitHub : outils ajoutés, bogues
        corrigés, changements non rétrocompatibles.
      </p>

      <div class="news__grid">
        <div class="news__card news__card--wide">
          <h3>Lettre d’information par e-mail</h3>
          <p>
            Les notes de version envoyées par e-mail. Les adresses ne sont
            utilisées à aucune autre fin.
          </p>

          <form class="sub" id="newsletter">
            <label class="visually-hidden" for="email">Votre adresse e-mail</label
            >
            <input
              id="email"
              name="email"
              type="email"
              required
              placeholder="vous@exemple.fr"
              autocomplete="email"
            />
            <button class="btn btn--light" type="submit">S’inscrire</button>
          </form>
          <p class="sub__note">
            « S’inscrire » ouvre l’application de messagerie avec un message
            préparé.
          </p>
        </div>

        <div class="news__card">
          <h3>GitHub</h3>
          <p>
            Choisir <strong>Watch → Custom → Releases</strong> sur le dépôt
            envoie une notification à chaque publication.
          </p>
          <a
            class="btn btn--outline-light news__btn"
            href="https://github.com/MiracLight/CarotOS/releases"
            target="_blank"
            rel="noopener noreferrer">Versions</a
          >
        </div>

        <div class="news__card">
          <h3>RSS / Atom</h3>
          <p>
            Le flux des versions peut être ajouté directement à un lecteur.
            Aucune inscription n’est nécessaire.
          </p>
          <a
            class="btn btn--outline-light news__btn"
            href="https://github.com/MiracLight/CarotOS/releases.atom"
            target="_blank"
            rel="noopener noreferrer">Adresse du flux</a
          >
        </div>
      </div>

      <p class="news__last">
        Dernière version <strong>{release.tag}</strong> — {release.date}
      </p>
    </div>
  </section>
  <Minigame lang="fr" />
</Base>

<script>
  /* Newsletter form.
     Not wired to an email service yet; on submit it opens the visitor's
     mail app with a prepared message. Once you move to Buttondown,
     Mailchimp or similar, delete this block and give the form an
     action + method instead. */
  const form = document.getElementById("newsletter") as HTMLFormElement | null;
  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const field = document.getElementById("email") as HTMLInputElement;
    if (!field.checkValidity()) {
      field.reportValidity();
      return;
    }
    const subject = encodeURIComponent("Inscription à la lettre d’information");
    const body = encodeURIComponent(
      `Bonjour,\n\nJe souhaite m’inscrire à la lettre d’information des versions de CarotOS.\nMon adresse e-mail : ${field.value}\n`,
    );
    window.location.href = `mailto:carotosproject@gmail.com?subject=${subject}&body=${body}`;
  });
</script>

