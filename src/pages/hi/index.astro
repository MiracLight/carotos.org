    text: "स्थानीय नेटवर्क पर उन डिवाइसों का पता लगाता है जो इस कंप्यूटर को स्कैन करते हैं या इसमें लॉग इन करने की कोशिश करते हैं। यह आठ नकली सेवाएँ खोलता है: SSH, वेब पैनल, Telnet, FTP, VNC, RDP, MySQL और Redis। डैशबोर्ड पिछले 24 घंटों की गतिविधि और सबसे सक्रिय हमलावरों को दिखाता है। एक हमलावर प्रोफ़ाइल में उपयोग किए गए यूजरनेम, मास्क किए गए पासवर्ड और एक रिस्क स्कोर की सूची होती है। डिवाइस ब्लॉक करने के लिए आपकी पुष्टि की आवश्यकता होती है।",
  },
  {
    title: "Carotene",
    icon: "/ikonlar/ikon-carotene.webp",
    screenshot: "/ekranlar/carotene.webp",
    ratio: "1040 / 700",
    alt: "Carotene: दो खतरों के साथ एक स्कैन परिणाम, वायरस परिभाषाओं की आयु और स्कैन विकल्प",
    text: "ClamAV के साथ होम फोल्डर और कस्टम फोल्डर की तेज़ स्कैनिंग करता है। स्कैन के दौरान, स्कैन की गई फाइलों की संख्या और परिणाम लाइव अपडेट होते हैं। मिली हुई फाइलों को क्वारंटाइन, डिलीट या इग्नोर किया जा सकता है। वायरस डेफिनिशन की उम्र मुख्य स्क्रीन पर दिखाई देती है, और उन्हें एप्लिकेशन से अपडेट किया जा सकता है। क्लीन परिणाम का मतलब यह नहीं है कि फाइलें सुरक्षित हैं, यह केवल दिखाता है कि कोई ज्ञात सिग्नेचर नहीं मिला।",
  },
];

const tools = [
  { name: "nmap", job: "नेटवर्क और पोर्ट स्कैनिंग" },
  { name: "tcpdump", job: "पैकेट कैप्चर" },
  { name: "tshark", job: "ट्रैफिक विश्लेषण" },
  { name: "aircrack-ng", job: "वायरलेस नेटवर्क टेस्टिंग" },
  { name: "nikto", job: "वेब सर्वर स्कैनिंग" },
  { name: "sqlmap", job: "SQL इंजेक्शन टेस्टिंग" },
  { name: "john", job: "पासवर्ड स्ट्रेंथ विश्लेषण" },
  { name: "hydra", job: "ऑथेंटिकेशन टेस्टिंग" },
  { name: "ufw", job: "फ़ायरवॉल" },
  { name: "fail2ban", job: "इंट्रूजन प्रिवेंशन" },
];
---

<Base
  lang="hi"
  title="CarotOS | साइबर सिक्योरिटी सीखने के लिए एक Linux डिस्ट्रीब्यूशन"
  description="Debian 13 पर आधारित, शिक्षा-केंद्रित Linux डिस्ट्रीब्यूशन जिसमें दस सिक्योरिटी टूल्स और तेरह ओरिजिनल एप्लिकेशन हैं।"
>
  {/* ============================================================
      HERO
      ============================================================ */}
  <section class="band band--foam hero">
    <div class="wrap hero__inner">
      <div class="hero__text">
        <p class="eyebrow">Debian 13 · XFCE · amd64</p>
        <h1>कम, लेकिन अच्छी तरह से समझाए गए।</h1>
        <p class="lede hero__lede">
          CarotOS एक Linux डिस्ट्रीब्यूशन है जिसे साइबर सुरक्षा शिक्षा के लिए बनाया गया है। इसमें प्रोजेक्ट के लिए लिखे गए दस सुरक्षा टूल और तेरह एप्लिकेशन शामिल हैं।
        </p>

        <div class="hero__actions">
          <a class="btn btn--solid" href="#download">
            <span>डाउनलोड करें</span>
            <span class="hero__size">{release.size}</span>
          </a> <a class="btn btn--ghost" href="https://github.com/MiracLight/CarotOS" target="_blank" rel="noopener noreferrer">सोर्स कोड</a >
        </div>
      </div>

      <div class="hero__art" aria-hidden="true">
        <span class="ripple ripple--1"></span>
        <span class="ripple ripple--2"></span>
        <span class="ripple ripple--3"></span>
        <div class="hero__turtle" data-minigame-trigger>
          <Turtle shell="#378ADA" body="#185FA5" />
        </div>
      </div>
    </div>

    <div class="wrap">
      <dl class="facts">
        {
          facts.map((f) => (
            <div class="facts__item">
              <dt class="facts__num">{f.num}</dt>
              <dd class="facts__label">{f.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <Wave from="#f4f9fd" to="#deedf8" />

  {/* ============================================================
      PHILOSOPHY
      ============================================================ */}
  <section id="philosophy" class="band band--shallow">
    <div class="wrap">
      <p class="eyebrow">दृष्टिकोण</p>
      <h2 class="sec__title">दायरा और डिज़ाइन सिद्धांत</h2>
      <p class="lede sec__lede">
        CarotOS उन डिस्ट्रीब्यूशन का विकल्प नहीं है जो बड़े टूल सेट प्रदान करते हैं। यह Debian इंस्टॉलेशन के ऊपर दस टूल और उन्हें चलाने के लिए इंटरफेस जोड़ता है। लक्ष्य अधिक टूल की संख्या नहीं बल्कि एक ऐसा आधार है जो क्लासरूम में काम कर सके।
      </p>

      <div class="grid grid--2 sec__grid">
        {
          philosophy.map((p) => (
            <article class="card">
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <Wave from="#deedf8" to="#a9cfea" />

  {/* ============================================================
      WHAT'S INSIDE
      ============================================================ */}
  <section id="inside" class="band band--tide">
    <div class="wrap">
      <p class="eyebrow">एप्लिकेशन</p>
      <h2 class="sec__title">एप्लिकेशन और टूल</h2>
      <p class="lede sec__lede">
        इस प्रोजेक्ट के लिए Python और GTK3 में लिखे गए तेरह एप्लिकेशन, जो GPL-3.0 के तहत वितरित किए गए हैं।
      </p>

      <div class="grid grid--2 sec__grid">
        {
          apps.map((a, i) => (
            <article class="card app">
              {a.icon ? (
                <img
                  class="app__logo"
                  src={a.icon}
                  alt=""
                  width="44"
                  height="44"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <span class="app__no">{String(i + 1).padStart(2, "0")}</span>
              )}
              <div>
                <h3>
                  {a.title}
                  {a.yeni && <span class="app__tag">{a.yeni}</span>}
                </h3>
                <p>{a.text}</p>
                {a.links && (
                  <p class="app__links">
                    {a.links.map((l) => (
                      <a href={l.url} rel="noopener">{l.label}</a>
                    ))}
                  </p>
                )}
              </div>
            </article>
          ))
        }
      </div>

      <div class="tools">
        <h3 class="tools__title">इंस्टॉल्ड टूल</h3>
        <ul class="tools__list">
          {
            tools.map((t) => (
              <li class="tool">
                <span class="tool__hex" aria-hidden="true" />
                <span class="tool__name">{t.name}</span>
                <span class="tool__job">{t.job}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="gorseller">
        <h3 class="tools__title">स्क्रीनशॉट्स</h3>
        <Slayt lang="hi" slaytlar={slides} />
      </div>

      <div class="poligon">
        <h3 class="tools__title">CarotOS Poligon</h3>
        <p class="lede poligon__lede">
          छात्रों और शिक्षकों के लिए एक अलग और सुरक्षित penetration-testing वातावरण। शिक्षक एक क्लासरूम रूम बनाता है; छात्र अपने स्वयं के मशीनों पर वास्तविक टूल्स के साथ कार्य पूरे करते हैं। इसमें कोई भी नेटवर्क-एक्सपोज़्ड कंपोनेंट नहीं है। सभी ऑपरेशंस लोकल मशीन पर चलते हैं।
        </p>
        <div class="grid grid--2 poligon__grid">
          {
            poligonApps.map((p) => (
              <article class="card poligon__card">
                <div class="poligon__head">
                  <img src={p.icon} alt="" class="poligon__ikon" width="40" height="40" />
                  <h4>{p.title}</h4>
                </div>
                <p>{p.text}</p>
                <div class="poligon__ekran-cerceve">
                  <img
                    src={p.screenshot}
                    alt={p.alt}
                    class="poligon__ekran"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              </article>
            ))
          }
        </div>
      </div>

      <div class="poligon">
        <h3 class="tools__title">CarotPot और Carotene</h3>
        <p class="lede poligon__lede">
          नेटवर्क और फाइल सुरक्षा के लिए दो एप्लिकेशन। CarotPot फेक सर्विसेज के साथ लोकल नेटवर्क पर स्कैन और लॉगिन प्रयासों को पकड़ता है। Carotene ClamAV के साथ फाइलों को स्कैन करता है। जब तक आप इन्हें शुरू नहीं करते, ये बैकग्राउंड में नहीं चलते।
        </p>
        <div class="grid grid--2 poligon__grid">
          {
            securityApps.map((p) => (
              <article class="card poligon__card">
                <div class="poligon__head">
                  <img src={p.icon} alt="" class="poligon__ikon" width="40" height="40" />
                  <h4>{p.title}</h4>
                </div>
                <p>{p.text}</p>
                <div class="poligon__ekran-cerceve" style={`aspect-ratio: ${p.ratio}`}>
                  <img
                    src={p.screenshot}
                    alt={p.alt}
                    class="poligon__ekran"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <Wave from="#a9cfea" to="#185fa5" />

  {/* ============================================================
      DOWNLOAD
      ============================================================ */}
  <section id="download" class="band band--deep">
    <div class="wrap">
      <p class="eyebrow">डाउनलोड करें</p>
      <h2 class="sec__title">Release {release.tag} “{release.codename}”</h2>
      <p class="lede sec__lede">
        लाइव डेस्कटॉप से “Install CarotOS” आइकन के साथ सीधे इंस्टॉल करें। BIOS और UEFI दोनों इंस्टॉल्स टेस्ट किए गए हैं। Secure Boot के लिए ISO में एक signed shim शामिल है। Wi-Fi, ऑडियो और ग्राफिक्स हार्डवेयर के लिए Firmware पैकेज शामिल हैं।
      </p>

      <div class="dl">
        <article class="dl__card">
          <div class="dl__head">
            <div>
              <p class="dl__arch">डेस्कटॉप</p>
              <p class="dl__isa mono">x86_64</p>
            </div>
            <span class="dl__badge">Stable · {release.codename}</span>
          </div>

          <ul class="dl__meta">
            <li><span>File</span><span class="mono">{release.file}</span></li>
            <li><span>आकार</span><span class="mono">{release.size}</span></li>
            <li><span>डेस्कटॉप</span><span>XFCE</span></li>
            <li><span>रिलीज़</span><span>{release.date}</span></li>
          </ul>

          <a class="btn btn--light dl__btn" href={release.url}>
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M12 3v13m0 0 5-5m-5 5-5-5M4 20h16"
                stroke="currentColor"
                stroke-width="2.1"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
            <span>ISO डाउनलोड करें</span>
          </a>

          <div class="verify">
            <p class="verify__hash">
              <span class="verify__hash-label">SHA-256</span>
              <code>{release.sha256}</code>
            </p>
            <a class="verify__link" href={release.shaUrl}
              >{release.file}.sha256</a
            >
          </div>
        </article>

        <div class="dl__yan">
          <div class="req">
            <p class="dl__soon-title">सिस्टम आवश्यकताएँ</p>
            <ul class="req__list">
              {
                requirements.map((r) => (
                  <li>
                    <span>{r.name}</span>
                    <span>{r.value}</span>
                  </li>
                ))
              }
            </ul>
            <p class="req__not">
              Debian 13 “trixie” डेस्कटॉप इंस्टॉलेशन के लिए अनुशंसित न्यूनतम आवश्यकताएं। XFCE, GNOME या KDE Plasma की तुलना में कम संसाधनों का उपयोग करता है। Debian 13 i386 आर्किटेक्चर को सपोर्ट नहीं करता है।
            </p>
          </div>

          <div class="dl__soon">
          <p class="dl__soon-title">योजनाबद्ध प्रोजेक्ट्स</p>

          <article class="soon">
            <div>
              <p class="soon__arch">CarotOS AUL</p>
              <p class="soon__isa mono">arm64</p>
            </div>
            <p class="soon__note">
              Armbian पर आधारित एक हल्का बिल्ड (Armbian Ultra Light)। यह Orange Pi 5 जैसे arm64 बोर्डों पर IceWM चलाता है। टारगेट आइडल मेमोरी उपयोग 200 MB है।
            </p>
            <span class="soon__tag">विकास के अधीन</span>
          </article>

            <p class="dl__soon-foot">
              CarotDeck, एक पोर्टेबल हार्डवेयर प्रोजेक्ट, बाद में आएगा।
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Wave from="#185fa5" to="#0b2e52" />

  {/* ============================================================
      RELEASES / NEWSLETTER
      ============================================================ */}
  <section id="releases" class="band band--abyss news">
    <div class="wrap">
      <p class="eyebrow">Releases</p>
      <h2 class="sec__title">रिलीज़ सूचनाएं</h2>
      <p class="lede sec__lede">
        रिलीज़ नोट्स GitHub पर प्रकाशित होते हैं: जोड़े गए टूल्स, फिक्स किए गए बग, बैकवर्ड्स-इनकम्पैटिबल बदलाव।
      </p>

      <div class="news__grid">
        <div class="news__card news__card--wide">
          <h3>ईमेल न्यूज़लेटर</h3>
          <p>
            ईमेल द्वारा रिलीज़ नोट्स भेजे जाते हैं। पतों का उपयोग किसी अन्य उद्देश्य के लिए नहीं किया जाता है।
          </p>

          <form class="sub" id="newsletter">
            <label class="visually-hidden" for="email">आपका ईमेल पता</label
            >
            <input
              id="email"
              name="email"
              type="email"
              required
              placeholder="you@example.com"
              autocomplete="email"
            />
            <button class="btn btn--light" type="submit">जुड़ें</button>
          </form>
          <p class="sub__note">
            Join मेल एप्लिकेशन को एक तैयार संदेश के साथ खोलता है।
          </p>
        </div>

        <div class="news__card">
          <h3>GitHub</h3>
          <p>
            रिपॉजिटरी पर <strong>Watch → Custom → Releases</strong> चुनने पर हर रिलीज़ के लिए एक सूचना भेजी जाती है।
          </p>
          <a class="btn btn--outline-light news__btn" href="https://github.com/MiracLight/CarotOS/releases" target="_blank" rel="noopener noreferrer">रिलीज़</a >
        </div>

        <div class="news__card">
          <h3>RSS / Atom</h3>
          <p>
            रिलीज़ फीड को सीधे रीडर में जोड़ा जा सकता है। साइन-अप की आवश्यकता नहीं है।
          </p>
          <a class="btn btn--outline-light news__btn" href="https://github.com/MiracLight/CarotOS/releases.atom" target="_blank" rel="noopener noreferrer">फ़ीड address</a >
        </div>
      </div>

      <p class="news__last">
        लेटेस्ट रिलीज़ <strong>{release.tag}</strong> — {release.date}
      </p>
    </div>
  </section>
  <Minigame lang="hi" />
</Base>

<script>
  /* Newsletter form.
     Not wired to an email service yet; on submit it opens the visitor's
     mail app with a prepared message. Once you move to Buttondown,
     Mailchimp or similar, delete this block and give the form an
     action + method instead. */
  const form = document.getElementById("newsletter") as HTMLFormElement | null;
  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const field = document.getElementById("email") as HTMLInputElement;
    if (!field.checkValidity()) {
      field.reportValidity();
      return;
    }
    const subject = encodeURIComponent("न्यूज़लेटर साइनअप");
    const body = encodeURIComponent(
      `Hello,\n\nI'd like to join the CarotOS release newsletter.\nMy email address: ${field.value}\n`,
    );
    window.location.href = `mailto:carotosproject@gmail.com?subject=${subject}&body=${body}`;
  });
</script>

