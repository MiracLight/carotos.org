  description="Debian 13 tabanlı, Türkçe arayüzlü, eğitim odaklı Linux dağıtımı. On güvenlik aracı ve on iki özgün uygulama içerir."
>
  {/* ============================================================
      KAHRAMAN
      ============================================================ */}
  <section class="band band--foam hero">
    <div class="wrap hero__inner">
      <div class="hero__text">
        <p class="eyebrow">Debian 13 · XFCE · amd64</p>
        <h1>Az ve öz.</h1>
        <p class="lede hero__lede">
          CarotOS, siber güvenlik eğitimi için hazırlanmış bir Linux
          dağıtımıdır. On güvenlik aracı ve proje için yazılmış on iki uygulama
          içerir.
        </p>

        <div class="hero__actions">
          <a class="btn btn--solid" href="#indir">
            <span>İndir</span>
            <span class="hero__size">{surum.boyut}</span>
          </a>
          <a
            class="btn btn--ghost"
            href="https://github.com/MiracLight/CarotOS"
            target="_blank"
            rel="noopener noreferrer">Kaynak kod</a
          >
        </div>
      </div>

      {/* Su yüzüne çıkan kaplumbağa — halkalar dalga izi */}
      <div class="hero__art" aria-hidden="true">
        <span class="ripple ripple--1"></span>
        <span class="ripple ripple--2"></span>
        <span class="ripple ripple--3"></span>
        <div class="hero__turtle" data-minigame-trigger>
          <Turtle shell="#378ADA" body="#185FA5" />
        </div>
      </div>
    </div>

    <div class="wrap">
      <dl class="facts">
        {
          gercekler.map((g) => (
            <div class="facts__item">
              <dt class="facts__num">{g.sayi}</dt>
              <dd class="facts__label">{g.etiket}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <Wave from="#f4f9fd" to="#deedf8" />

  {/* ============================================================
      FELSEFE
      ============================================================ */}
  <section id="felsefe" class="band band--shallow">
    <div class="wrap">
      <p class="eyebrow">Yaklaşım</p>
      <h2 class="sec__title">Kapsam ve tasarım ilkeleri</h2>
      <p class="lede sec__lede">
        CarotOS, geniş araç setleri sunan dağıtımların alternatifi değildir.
        Debian kurulumunun üzerine on araç ve bunları kullanmayı kolaylaştıran
        arayüzler ekler. Amaç, araç sayısını artırmak değil, eğitim ortamında
        kullanılabilir bir taban sunmaktır.
      </p>

      <div class="grid grid--2 sec__grid">
        {
          felsefe.map((f) => (
            <article class="card">
              <h3>{f.baslik}</h3>
              <p>{f.metin}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <Wave from="#deedf8" to="#a9cfea" />

  {/* ============================================================
      İÇİNDE NE VAR
      ============================================================ */}
  <section id="icinde" class="band band--tide">
    <div class="wrap">
      <p class="eyebrow">Uygulamalar</p>
      <h2 class="sec__title">Uygulamalar ve araçlar</h2>
      <p class="lede sec__lede">
        Bu proje için yazılan on iki uygulama. Python ve GTK3 ile geliştirildi,
        GPL-3.0 ile dağıtılıyor.
      </p>

      <div class="grid grid--2 sec__grid">
        {
          uygulamalar.map((u, i) => (
            <article class="card app">
              {u.ikon ? (
                <img
                  class="app__logo"
                  src={u.ikon}
                  alt=""
                  width="44"
                  height="44"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <span class="app__no">{String(i + 1).padStart(2, "0")}</span>
              )}
              <div>
                <h3>
                  {u.baslik}
                  {u.yeni && <span class="app__tag">{u.yeni}</span>}
                </h3>
                <p>{u.metin}</p>
              </div>
            </article>
          ))
        }
      </div>

      <div class="tools">
        <h3 class="tools__title">Kurulu araçlar</h3>
        <ul class="tools__list">
          {
            araclar.map((a) => (
              <li class="tool">
                <span class="tool__hex" aria-hidden="true" />
                <span class="tool__name">{a.ad}</span>
                <span class="tool__job">{a.is}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="gorseller">
        <h3 class="tools__title">Ekran görüntüleri</h3>
        <Slayt lang="tr" slaytlar={slaytlar} />
      </div>

      <div class="poligon">
        <h3 class="tools__title">CarotOS Poligon</h3>
        <p class="lede poligon__lede">
          Öğrenciler ve öğretmenler için izole ve güvenli sızma testi
          uygulama ortamı. Öğretmen sınıf odası oluşturur, öğrenciler
          görevleri kendi bilgisayarlarında gerçek araçlarla tamamlar. Ağa
          açık bileşen yoktur. Tüm işlemler yerel makinede yapılır.
        </p>
        <div class="grid grid--2 poligon__grid">
          {
            poligonUygulamalari.map((p) => (
              <article class="card poligon__card">
                <div class="poligon__head">
                  <img src={p.ikon} alt="" class="poligon__ikon" width="40" height="40" />
                  <h4>{p.baslik}</h4>
                </div>
                <p>{p.metin}</p>
                <div class="poligon__ekran-cerceve">
                  <img
                    src={p.ekran}
                    alt={p.alt}
                    class="poligon__ekran"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              </article>
            ))
          }
        </div>
      </div>

      <div class="poligon">
        <h3 class="tools__title">CarotPot ve Carotene</h3>
        <p class="lede poligon__lede">
          Ağ ve dosya güvenliği için iki uygulama. CarotPot, yerel ağdaki tarama
          ve giriş denemelerini sahte hizmetlerle yakalar. Carotene ise
          dosyaları ClamAV ile tarar. İkisi de siz başlatmadıkça arka planda
          çalışmaz.
        </p>
        <div class="grid grid--2 poligon__grid">
          {
            guvenlikUygulamalari.map((p) => (
              <article class="card poligon__card">
                <div class="poligon__head">
                  <img src={p.ikon} alt="" class="poligon__ikon" width="40" height="40" />
                  <h4>{p.baslik}</h4>
                </div>
                <p>{p.metin}</p>
                <div class="poligon__ekran-cerceve" style={`aspect-ratio: ${p.oran}`}>
                  <img
                    src={p.ekran}
                    alt={p.alt}
                    class="poligon__ekran"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <Wave from="#a9cfea" to="#185fa5" />

  {/* ============================================================
      İNDİRME
      ============================================================ */}
  <section id="indir" class="band band--deep">
    <div class="wrap">
      <p class="eyebrow">İndirme</p>
      <h2 class="sec__title">Sürüm {surum.etiket} “{surum.kodAdi}”</h2>
      <p class="lede sec__lede">
        BIOS ve UEFI kurulumu test edildi. Secure Boot için imzalı shim ISO'da
        bulunur. Wi-Fi, ses ve grafik donanımı için firmware paketleri dahildir.
      </p>

      <div class="dl">
        {/* --- Mevcut sürüm --- */}
        <article class="dl__card">
          <div class="dl__head">
            <div>
              <p class="dl__arch">Masaüstü</p>
              <p class="dl__isa mono">x86_64</p>
            </div>
            <span class="dl__badge">Kararlı · {surum.kodAdi}</span>
          </div>

          <ul class="dl__meta">
            <li><span>Dosya</span><span class="mono">{surum.dosya}</span></li>
            <li><span>Boyut</span><span class="mono">{surum.boyut}</span></li>
            <li><span>Masaüstü</span><span>XFCE</span></li>
            <li><span>Yayın</span><span>{surum.tarih}</span></li>
          </ul>

          <a class="btn btn--light dl__btn" href={surum.url}>
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M12 3v13m0 0 5-5m-5 5-5-5M4 20h16"
                stroke="currentColor"
                stroke-width="2.1"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
            <span>ISO dosyasını indir</span>
          </a>

          <div class="verify">
            <p class="verify__hash">
              <span class="verify__hash-label">SHA-256</span>
              <code>{surum.sha256}</code>
            </p>
            <a class="verify__link" href={surum.shaUrl}
              >{surum.dosya}.sha256</a
            >
          </div>
        </article>

        <div class="dl__yan">
          <div class="req">
            <p class="dl__soon-title">Sistem gereksinimleri</p>
            <ul class="req__list">
              {
                gereksinim.map((g) => (
                  <li>
                    <span>{g.ad}</span>
                    <span>{g.deger}</span>
                  </li>
                ))
              }
            </ul>
            <p class="req__not">
              Debian 13 “trixie” masaüstü kurulumu için önerilen asgari
              değerler. XFCE, GNOME ve KDE Plasma'dan daha az kaynak kullanır.
              Debian 13 i386 mimarisini desteklemez.
            </p>
          </div>

          <div class="dl__soon">
          <p class="dl__soon-title">Planlanan sürümler</p>

          <article class="soon">
            <div>
              <p class="soon__arch">CarotDeck</p>
              <p class="soon__isa mono">arm64</p>
            </div>
            <p class="soon__note">
              Orange Pi 5 üzerinde i3wm ile çalışan taşınabilir sürüm.
              Hedeflenen boşta bellek kullanımı 200 MB.
            </p>
            <span class="soon__tag">Geliştiriliyor</span>
          </article>

            <p class="dl__soon-foot">
              Farklı masaüstü ortamları için sürümler planlanıyor.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Wave from="#185fa5" to="#0b2e52" />

  {/* ============================================================
      SÜRÜMLER / BÜLTEN
      ============================================================ */}
  <section id="surumler" class="band band--abyss news">
    <div class="wrap">
      <p class="eyebrow">Sürümler</p>
      <h2 class="sec__title">Sürüm bildirimleri</h2>
      <p class="lede sec__lede">
        Sürüm notları GitHub üzerinde yayımlanır: eklenen araçlar, düzeltilen
        hatalar, geriye dönük uyumsuzluklar.
      </p>

      <div class="news__grid">
        {/* E-posta */}
        <div class="news__card news__card--wide">
          <h3>E-posta bülteni</h3>
          <p>
            Sürüm notları e-posta ile gönderilir. Adresler başka bir amaçla
            kullanılmaz.
          </p>

          <form class="sub" id="bulten">
            <label class="visually-hidden" for="eposta">E-posta adresin</label>
            <input
              id="eposta"
              name="eposta"
              type="email"
              required
              placeholder="ornek@eposta.com"
              autocomplete="email"
            />
            <button class="btn btn--light" type="submit">Katıl</button>
          </form>
          <p class="sub__note" id="bulten-not">
            Katıl, hazır bir mesajla e-posta uygulamasını açar.
          </p>
        </div>

        {/* GitHub */}
        <div class="news__card">
          <h3>GitHub</h3>
          <p>
            Depoda <strong>Watch → Custom → Releases</strong> seçildiğinde her
            sürüm için bildirim gönderilir.
          </p>
          <a
            class="btn btn--outline-light news__btn"
            href="https://github.com/MiracLight/CarotOS/releases"
            target="_blank"
            rel="noopener noreferrer">Sürümler</a
          >
        </div>

        {/* RSS */}
        <div class="news__card">
          <h3>RSS / Atom</h3>
          <p>
            Sürüm beslemesi doğrudan bir okuyucuya eklenebilir. Kayıt
            gerektirmez.
          </p>
          <a
            class="btn btn--outline-light news__btn"
            href="https://github.com/MiracLight/CarotOS/releases.atom"
            target="_blank"
            rel="noopener noreferrer">Besleme adresi</a
          >
        </div>
      </div>

      <p class="news__last">
        Son sürüm <strong>{surum.etiket}</strong> — {surum.tarih}
      </p>
    </div>
  </section>
  <Minigame lang="tr" />
</Base>

<script>
  /* Bülten formu.
     Şu an bir e-posta servisine bağlı değil; form gönderildiğinde
     kullanıcının e-posta uygulamasını hazır bir mesajla açıyor.
     Buttondown/Mailchimp gibi bir servise geçtiğinizde bu bloğu silip
     forma action + method vermek yeterli. */
  const form = document.getElementById("bulten") as HTMLFormElement | null;
  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const alan = document.getElementById("eposta") as HTMLInputElement;
    if (!alan.checkValidity()) {
      alan.reportValidity();
      return;
    }
    const konu = encodeURIComponent("Bülten aboneliği");
    const govde = encodeURIComponent(
      `Merhaba,\n\nCarotOS sürüm bültenine katılmak istiyorum.\nE-posta adresim: ${alan.value}\n`,
    );
    window.location.href = `mailto:carotosproject@gmail.com?subject=${konu}&body=${govde}`;
  });
</script>

