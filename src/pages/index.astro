    aciklama: "On araç, hepsi panel üzerinden kullanılabilir.",
  },
  {
    src: "/ekranlar/guvenlik-paneli.webp",
    kucuk: "/ekranlar/kucuk/guvenlik-paneli.webp",
    alt: "CarotOS Güvenlik Paneli: solda araç listesi, sağda nmap formu",
    grup: "Uygulama",
    baslik: "Güvenlik Paneli",
