---
import Base from "../layouts/Base.astro";
import Wave from "../components/Wave.astro";
import Turtle from "../components/Turtle.astro";
import Slayt from "../components/Slayt.astro";
import "../styles/anasayfa.css";

/* ------------------------------------------------------------------
   Sürüm bilgileri — yeni sürüm çıktığında SADECE burayı güncelle.
   ------------------------------------------------------------------ */
const surum = {
  etiket: "1.2",
  kodAdi: "Eggshell",
  tarih: "12 Ekim 2026",
  dosya: "carotos-1.2-amd64.iso",
  boyut: "2,25 GB",
  bayt: "2.253.864.960",
  sha256: "cb8753bb0bb41abbb7e79daf483248f8ecdc9b1e54187602e86504a1d8a41a78",
  url: "https://download.carotos.org/carotos-1.2-amd64.iso",
  shaUrl: "https://download.carotos.org/carotos-1.2-amd64.iso.sha256",
};

/* Debian 13 "trixie" amd64 kurulum kılavuzu, Tablo 3.2 —
   masaüstü kurulumu için önerilen asgari değerler. */
const gereksinim = [
  { ad: "İşlemci", deger: "64 bit (amd64), 1 GHz" },
  { ad: "Bellek", deger: "En az 1 GB, önerilen 2 GB" },
  { ad: "Disk", deger: "10 GB" },
  { ad: "Önyükleme", deger: "BIOS veya UEFI" },
];

const slaytlar = [
  {
    src: "/ekranlar/masaustu.webp",
    kucuk: "/ekranlar/kucuk/masaustu.webp",
    alt: "CarotOS masaüstü: XFCE üst paneli, altta uygulama çubuğu",
    grup: "Sistem",
    baslik: "Masaüstü",
    aciklama: "XFCE 4, iki panelli düzen ve kendi duvar kâğıdı.",
  },
  {
    src: "/ekranlar/karsilama-1.webp",
    kucuk: "/ekranlar/kucuk/karsilama-1.webp",
    alt: "Karşılama Sihirbazı açılış sayfası",
    grup: "Karşılama Sihirbazı",
    baslik: "CarotOS 1.0 “Eggshell”",
    aciklama: "İlk oturumda açılır. Linux'u ilk kez kullananlar için kısa bir tanıtım.",
  },
  {
    src: "/ekranlar/karsilama-2.webp",
    kucuk: "/ekranlar/kucuk/karsilama-2.webp",
    alt: "Karşılama Sihirbazı görünüm ve dil seçim sayfası",
    grup: "Karşılama Sihirbazı",
    baslik: "Görünüm ve dil",
    aciklama: "Açık veya koyu tema ve sistem dili. Seçimler çıkışta uygulanır.",
  },
  {
    src: "/ekranlar/karsilama-duvar.webp",
    kucuk: "/ekranlar/kucuk/karsilama-duvar.webp",
    alt: "Karşılama Sihirbazı: üç seçenekli masaüstü arka planı sayfası",
    grup: "Karşılama Sihirbazı · 1.2",
    baslik: "Masaüstü arka planı",
    aciklama: "Üç CarotOS arka planından biri seçilir; seçim çıkışta masaüstüne uygulanır.",
  },
  {
    src: "/ekranlar/karsilama-3.webp",
    kucuk: "/ekranlar/kucuk/karsilama-3.webp",
    alt: "Karşılama Sihirbazı: Linux ve dağıtımlar sayfası",
    grup: "Karşılama Sihirbazı",
    baslik: "Linux ve dağıtımlar",
    aciklama: "CarotOS nedir, neyin üzerine kurulu? Debian 13, Xfce ve APT.",
  },
  {
    src: "/ekranlar/karsilama-4.webp",
    kucuk: "/ekranlar/kucuk/karsilama-4.webp",
    alt: "Karşılama Sihirbazı: masaüstü düzeni sayfası",
    grup: "Karşılama Sihirbazı",
    baslik: "Masaüstü",
    aciklama: "İki panelli düzenin nasıl kullanıldığı.",
  },
  {
    src: "/ekranlar/karsilama-5.webp",
    kucuk: "/ekranlar/kucuk/karsilama-5.webp",
    alt: "Karşılama Sihirbazı: dosya sistemi sayfası",
    grup: "Karşılama Sihirbazı",
    baslik: "Dosya sistemi",
    aciklama: "Linux'ta sürücü harfi yoktur; her şey tek bir ağaçtadır.",
  },
  {
    src: "/ekranlar/karsilama-6.webp",
    kucuk: "/ekranlar/kucuk/karsilama-6.webp",
    alt: "Karşılama Sihirbazı: ev klasörü sayfası",
    grup: "Karşılama Sihirbazı",
    baslik: "Ev klasörünüz",
    aciklama: "Kişisel dosyalarınızın bulunduğu yer.",
  },
  {
    src: "/ekranlar/karsilama-7.webp",
    kucuk: "/ekranlar/kucuk/karsilama-7.webp",
    alt: "Karşılama Sihirbazı: yazılım kurma sayfası",
    grup: "Karşılama Sihirbazı",
    baslik: "Yazılım kurmak",
    aciklama: "Depolar: güvenli ve merkezî kurulum. İnternetten .exe indirilmez.",
  },
  {
    src: "/ekranlar/karsilama-8.webp",
    kucuk: "/ekranlar/kucuk/karsilama-8.webp",
    alt: "Karşılama Sihirbazı: Güvenlik Paneli tanıtım sayfası",
    grup: "Karşılama Sihirbazı",
    baslik: "CarotOS Güvenlik Paneli",
    aciklama: "Komut satırı bilmeden güvenlik araçlarını kullanın.",
  },
  {
    src: "/ekranlar/karsilama-9.webp",
    kucuk: "/ekranlar/kucuk/karsilama-9.webp",
    alt: "Karşılama Sihirbazı: kurulu güvenlik araçları listesi",
    grup: "Karşılama Sihirbazı",
    baslik: "Kurulu güvenlik araçları",
    aciklama: "On araç, hepsi panel üzerinden kullanılabilir.",
  },
  {
    src: "/ekranlar/guvenlik-paneli.webp",
    kucuk: "/ekranlar/kucuk/guvenlik-paneli.webp",
    alt: "CarotOS Güvenlik Paneli: solda araç listesi, sağda nmap formu",
    grup: "Uygulama",
    baslik: "Güvenlik Paneli",
    aciklama: "Her alanın işlevi yanında açıklanır, komut çıktısı canlı akar.",
  },
  {
    src: "/ekranlar/sistem-sagligi.webp",
    kucuk: "/ekranlar/kucuk/sistem-sagligi.webp",
    alt: "CarotOS Sistem Sağlığı: yüzde 88 sağlık puanı ve denetim listesi",
    grup: "Uygulama",
    baslik: "Sistem Sağlığı",
    aciklama: "Altı kategoride yirmi denetim, sağlık puanı ve tek tık düzeltmeler.",
  },
  {
    src: "/ekranlar/usb-denetimi.webp",
    kucuk: "/ekranlar/kucuk/usb-denetimi.webp",
    alt: "CarotOS USB Denetimi: bir bellekte dört şüpheli bulgu, önem derecesine göre listelenmiş",
    grup: "Uygulama",
    baslik: "USB Denetimi",
    aciklama: "Bulgular önem derecesine göre sıralanır; her bulgunun nedeni ve dosya yolu gösterilir.",
  },
  {
    src: "/ekranlar/magaza.webp",
    kucuk: "/ekranlar/kucuk/magaza.webp",
    alt: "CarotOS Mağaza: solda kategoriler, sağda uygulama kartları ve Kur düğmeleri",
    grup: "Uygulama · 1.2",
    baslik: "CarotOS Mağaza",
    aciklama: "Yedi kategoride 51 uygulama. Kurulum ve kaldırma apt üzerinden yapılır.",
  },
];

const gercekler = [
  { sayi: "10", etiket: "seçilmiş güvenlik aracı" },
  { sayi: "7", etiket: "özgün uygulama" },
  { sayi: "~600 MB", etiket: "boşta bellek kullanımı" },
  { sayi: "13", etiket: "Debian sürümü — trixie" },
];

const felsefe = [
  {
    baslik: "Araç seçimi",
    metin:
      "Kurulu araçlar ağ taraması, trafik çözümleme, web ve parola testleri ile güvenlik duvarı yapılandırmasını kapsar. Sayı bilinçli olarak düşük tutuldu; her araç için arayüz ve açıklama yazmak gerekiyor.",
  },
  {
    baslik: "Varsayılan dil",
    metin:
      "Sistem Türkçe kurulur. İngilizce, karşılama sihirbazından veya oturum ayarlarından seçilebilir. Uygulama arayüzleri iki dilde hazırlandı.",
  },
  {
    baslik: "Debian 13 tabanı",
    metin:
      "Güncel depo, araç sürümlerinin öğrenme kaynaklarıyla uyumlu kalmasını sağlar. Sürüm farkı, yeni kullanıcılar için en sık takılma noktalarından biri.",
  },
  {
    baslik: "Açık kaynak",
    metin:
      "Bu proje için yazılan uygulamalar Python ve GTK3 ile geliştirildi ve GPL-3.0 lisansıyla dağıtılıyor. Kaynak kod ve ISO yapılandırması GitHub'da herkese açık.",
  },
];

const uygulamalar = [
  {
    baslik: "Güvenlik Paneli",
    metin:
      "On aracın grafik arayüzü. Her alanın işlevi yanında açıklanır, komut çıktısı canlı akar, yetki gerektiren işlemler pkexec üzerinden yürütülür.",
  },
  {
    baslik: "Karşılama Sihirbazı",
    metin:
      "İlk oturumda açılan iki dilli tanıtım. Tema, dil ve masaüstü arka planı ilk sayfalarda seçilir, çıkışta sisteme uygulanır. 1.2 sürümünde sayfa sayısı on birden on beşe çıktı.",
  },
  {
    baslik: "Sistem Sağlığı",
    metin:
      "Altı kategoride yirmi denetim. Sağlık puanı üretir, on iki sorunu tek tıkla düzeltir, sonucu rapor olarak kaydeder.",
  },
  {
    baslik: "USB Denetimi",
    metin:
      "Bağlanan aygıtı otomatik denetler: autorun.inf, çift uzantı, gizlenmiş uzantı, klasör görünümlü kısayol. Dosya içeriği okunmaz; yalnızca ad, uzantı ve konum incelenir. 1.2 sürümünden itibaren oturum açılışında arka planda başlar.",
  },
  {
    baslik: "CarotOS Poligon",
    metin:
      "Öğrenci uygulaması. İzole bir ortamda hydra, nmap, john, sqlmap ve tshark ile gerçek görevler çözülür; ufw ve fail2ban ile savunma pratiği de yapılır.",
  },
  {
    baslik: "CarotOS Poligon Öğretmen",
    metin:
      "Öğretmen uygulaması. Tek tıkla bir sınıf odası açar, öğrencilerin ilerlemesini gösterir, göreve yönlendirir ve ihtiyacı olana özel ipucu gönderir.",
  },
  {
    baslik: "CarotOS Mağaza",
    yeni: "1.2",
    metin:
      "Debian depolarındaki 51 uygulamayı yedi kategoride sunan grafik mağaza. Kurulum ve kaldırma apt üzerinden yürütülür, yetki pkexec ile istenir. Açık ve koyu tema, Türkçe ve İngilizce arayüz.",
  },
];

const poligonUygulamalari = [
  {
    baslik: "CarotOS Poligon",
    ikon: "/ikonlar/ikon-poligon-ogrenci.webp",
    ekran: "/ekranlar/poligon-ogrenci.webp",
    alt: "CarotOS Poligon öğrenci uygulaması: misafir girişi, kullanıcı oluşturma ve kullanıcı girişi seçenekleri",
    metin:
      "Misafir olarak hesap açmadan başlanabilir ya da kullanıcı hesabıyla giriş yapılır. Hesapla girişte ilerleme kaydedilir; görevler bireysel olarak veya bir sınıf odasına katılarak çözülür.",
  },
  {
    baslik: "CarotOS Poligon Öğretmen",
    ikon: "/ikonlar/ikon-poligon-ogretmen.webp",
    ekran: "/ekranlar/poligon-ogretmen.webp",
    alt: "CarotOS Poligon öğretmen uygulaması: oda kodu, oda şifresi, öğrenci listesi ve ipucu alanı",
    metin:
      "Oda kodu ve şifresi tek tıkla üretilir. Öğrenci ve sınıf görünümleri, soru oluşturma ve kaydedilmiş sorular ayrı sekmelerdedir. İpucu tek öğrenciye ya da tüm sınıfa gönderilebilir.",
  },
];

const araclar = [
  { ad: "nmap", is: "Ağ ve port taraması" },
  { ad: "tcpdump", is: "Paket yakalama" },
  { ad: "tshark", is: "Trafik çözümleme" },
  { ad: "aircrack-ng", is: "Kablosuz ağ testi" },
  { ad: "nikto", is: "Web sunucu taraması" },
  { ad: "sqlmap", is: "SQL enjeksiyon testi" },
  { ad: "john", is: "Parola gücü analizi" },
  { ad: "hydra", is: "Kimlik doğrulama testi" },
  { ad: "ufw", is: "Güvenlik duvarı" },
  { ad: "fail2ban", is: "Saldırı engelleme" },
];
---

<Base
  lang="tr"
  title="CarotOS — Siber güvenlik öğrenmek için bir Linux dağıtımı"
  description="Debian 13 tabanlı, Türkçe, eğitim odaklı bir Linux dağıtımı. Altı yüz araç yerine on tanesini iyi anlatır."
>
  {/* ============================================================
      KAHRAMAN
      ============================================================ */}
  <section class="band band--foam hero">
    <div class="wrap hero__inner">
      <div class="hero__text">
        <p class="eyebrow">Debian 13 · XFCE · amd64</p>
        <h1>Az ve öz.</h1>
        <p class="lede hero__lede">
          CarotOS, siber güvenlik eğitimi için hazırlanmış bir Linux
          dağıtımıdır. On güvenlik aracı ve bu araçları kullanmak için yazılmış
          yedi uygulama içerir.
        </p>

        <div class="hero__actions">
          <a class="btn btn--solid" href="#indir">
            <span>İndir</span>
            <span class="hero__size">{surum.boyut}</span>
          </a>
          <a
            class="btn btn--ghost"
            href="https://github.com/MiracLight/CarotOS"
            target="_blank"
            rel="noopener noreferrer">Kaynak kod</a
          >
        </div>
      </div>

      {/* Su yüzüne çıkan kaplumbağa — halkalar dalga izi */}
      <div class="hero__art" aria-hidden="true">
        <span class="ripple ripple--1"></span>
        <span class="ripple ripple--2"></span>
        <span class="ripple ripple--3"></span>
        <div class="hero__turtle">
          <Turtle shell="#378ADA" body="#185FA5" />
        </div>
      </div>
    </div>

    <div class="wrap">
      <dl class="facts">
        {
          gercekler.map((g) => (
            <div class="facts__item">
              <dt class="facts__num">{g.sayi}</dt>
              <dd class="facts__label">{g.etiket}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <Wave from="#f4f9fd" to="#deedf8" />

  {/* ============================================================
      FELSEFE
      ============================================================ */}
  <section id="felsefe" class="band band--shallow">
    <div class="wrap">
      <p class="eyebrow">Yaklaşım</p>
      <h2 class="sec__title">Ne yapar, ne yapmaz.</h2>
      <p class="lede sec__lede">
        CarotOS, geniş araç setleri sunan dağıtımların alternatifi değildir.
        Debian kurulumunun üzerine on araç ve bunları kullanmayı kolaylaştıran
        arayüzler ekler. Amaç, araç sayısını artırmak değil, eğitim ortamında
        kullanılabilir bir taban sunmaktır.
      </p>

      <div class="grid grid--2 sec__grid">
        {
          felsefe.map((f) => (
            <article class="card">
              <h3>{f.baslik}</h3>
              <p>{f.metin}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <Wave from="#deedf8" to="#a9cfea" />

  {/* ============================================================
      İÇİNDE NE VAR
      ============================================================ */}
  <section id="icinde" class="band band--tide">
    <div class="wrap">
      <p class="eyebrow">Uygulamalar</p>
      <h2 class="sec__title">Size sunduklarımız.</h2>
      <p class="lede sec__lede">
        Bu proje için yazılan yedi uygulama. Python ve GTK3 ile geliştirildi,
        GPL-3.0 ile dağıtılıyor.
      </p>

      <div class="grid grid--2 sec__grid">
        {
          uygulamalar.map((u, i) => (
            <article class="card app">
              <span class="app__no">{String(i + 1).padStart(2, "0")}</span>
              <div>
                <h3>
                  {u.baslik}
                  {u.yeni && <span class="app__tag">{u.yeni}</span>}
                </h3>
                <p>{u.metin}</p>
              </div>
            </article>
          ))
        }
      </div>

      <div class="tools">
        <h3 class="tools__title">Kurulu araçlar</h3>
        <ul class="tools__list">
          {
            araclar.map((a) => (
              <li class="tool">
                <span class="tool__hex" aria-hidden="true" />
                <span class="tool__name">{a.ad}</span>
                <span class="tool__job">{a.is}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="gorseller">
        <h3 class="tools__title">Ekran görüntüleri</h3>
        <Slayt lang="tr" slaytlar={slaytlar} />
      </div>

      <div class="poligon">
        <h3 class="tools__title">CarotOS Poligon</h3>
        <p class="lede poligon__lede">
          Öğrenciler ve öğretmenler için izole, güvenli bir sızma testi
          pratik alanı. Öğretmen bir sınıf açar, öğrenciler kendi
          bilgisayarlarında gerçek araçlarla pratik yapar — hiçbir şey ağa
          açılmaz, her şey kendi makinesinde kalır.
        </p>
        <div class="grid grid--2 poligon__grid">
          {
            poligonUygulamalari.map((p) => (
              <article class="card poligon__card">
                <div class="poligon__head">
                  <img src={p.ikon} alt="" class="poligon__ikon" width="40" height="40" />
                  <h4>{p.baslik}</h4>
                </div>
                <p>{p.metin}</p>
                <div class="poligon__ekran-cerceve">
                  <img
                    src={p.ekran}
                    alt={p.alt}
                    class="poligon__ekran"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <Wave from="#a9cfea" to="#185fa5" />

  {/* ============================================================
      İNDİRME
      ============================================================ */}
  <section id="indir" class="band band--deep">
    <div class="wrap">
      <p class="eyebrow">İndirme</p>
      <h2 class="sec__title">Sürüm {surum.etiket} “{surum.kodAdi}”</h2>
      <p class="lede sec__lede">
        BIOS ve UEFI kurulumu test edildi. Secure Boot için imzalı shim ISO'da
        bulunur. Wi-Fi, ses ve grafik donanımı için firmware paketleri dahildir.
      </p>

      <div class="dl">
        {/* --- Mevcut sürüm --- */}
        <article class="dl__card">
          <div class="dl__head">
            <div>
              <p class="dl__arch">Masaüstü</p>
              <p class="dl__isa mono">x86_64</p>
            </div>
            <span class="dl__badge">Kararlı · {surum.kodAdi}</span>
          </div>

          <ul class="dl__meta">
            <li><span>Dosya</span><span class="mono">{surum.dosya}</span></li>
            <li><span>Boyut</span><span class="mono">{surum.boyut}</span></li>
            <li><span>Masaüstü</span><span>XFCE</span></li>
            <li><span>Yayın</span><span>{surum.tarih}</span></li>
          </ul>

          <a class="btn btn--light dl__btn" href={surum.url}>
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M12 3v13m0 0 5-5m-5 5-5-5M4 20h16"
                stroke="currentColor"
                stroke-width="2.1"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
            <span>ISO dosyasını indir</span>
          </a>

          <div class="verify">
            <p class="verify__hash">
              <span class="verify__hash-label">SHA-256</span>
              <code>{surum.sha256}</code>
            </p>
            <a class="verify__link" href={surum.shaUrl}
              >{surum.dosya}.sha256</a
            >
          </div>
        </article>

        <div class="dl__yan">
          <div class="req">
            <p class="dl__soon-title">Sistem gereksinimleri</p>
            <ul class="req__list">
              {
                gereksinim.map((g) => (
                  <li>
                    <span>{g.ad}</span>
                    <span>{g.deger}</span>
                  </li>
                ))
              }
            </ul>
            <p class="req__not">
              Debian 13 “trixie” masaüstü kurulumu için önerilen asgari
              değerler. XFCE, GNOME ve KDE Plasma'dan daha az kaynak kullanır.
              Debian 13 i386 mimarisini desteklemez.
            </p>
          </div>

          <div class="dl__soon">
          <p class="dl__soon-title">Yolda</p>

          <article class="soon">
            <div>
              <p class="soon__arch">CarotDeck</p>
              <p class="soon__isa mono">arm64</p>
            </div>
            <p class="soon__note">
              Orange Pi 5 üzerinde i3wm ile çalışan taşınabilir sürüm.
              Hedeflenen boşta bellek kullanımı 200 MB.
            </p>
            <span class="soon__tag">Geliştiriliyor</span>
          </article>

            <p class="dl__soon-foot">
              Farklı masaüstü ortamları için sürümler planlanıyor.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Wave from="#185fa5" to="#0b2e52" />

  {/* ============================================================
      SÜRÜMLER / BÜLTEN
      ============================================================ */}
  <section id="surumler" class="band band--abyss news">
    <div class="wrap">
      <p class="eyebrow">Sürümler</p>
      <h2 class="sec__title">Sürüm bildirimleri</h2>
      <p class="lede sec__lede">
        Sürüm notları GitHub üzerinde yayımlanır: eklenen araçlar, düzeltilen
        hatalar, geriye dönük uyumsuzluklar.
      </p>

      <div class="news__grid">
        {/* E-posta */}
        <div class="news__card news__card--wide">
          <h3>E-posta bülteni</h3>
          <p>
            Sürüm notları e-posta ile gönderilir. Adresler başka bir amaçla
            kullanılmaz.
          </p>

          <form class="sub" id="bulten">
            <label class="visually-hidden" for="eposta">E-posta adresin</label>
            <input
              id="eposta"
              name="eposta"
              type="email"
              required
              placeholder="ornek@eposta.com"
              autocomplete="email"
            />
            <button class="btn btn--light" type="submit">Katıl</button>
          </form>
          <p class="sub__note" id="bulten-not">
            Katıl, hazır bir mesajla e-posta uygulamasını açar.
          </p>
        </div>

        {/* GitHub */}
        <div class="news__card">
          <h3>GitHub</h3>
          <p>
            Depoda <strong>Watch → Custom → Releases</strong> seçildiğinde her
            sürüm için bildirim gönderilir.
          </p>
          <a
            class="btn btn--outline-light news__btn"
            href="https://github.com/MiracLight/CarotOS/releases"
            target="_blank"
            rel="noopener noreferrer">Sürümler</a
          >
        </div>

        {/* RSS */}
        <div class="news__card">
          <h3>RSS / Atom</h3>
          <p>
            Sürüm beslemesi doğrudan bir okuyucuya eklenebilir. Kayıt
            gerektirmez.
          </p>
          <a
            class="btn btn--outline-light news__btn"
            href="https://github.com/MiracLight/CarotOS/releases.atom"
            target="_blank"
            rel="noopener noreferrer">Besleme adresi</a
          >
        </div>
      </div>

      <p class="news__last">
        Son sürüm <strong>{surum.etiket}</strong> — {surum.tarih}
      </p>
    </div>
  </section>
</Base>

<script>
  /* Bülten formu.
     Şu an bir e-posta servisine bağlı değil; form gönderildiğinde
     kullanıcının e-posta uygulamasını hazır bir mesajla açıyor.
     Buttondown/Mailchimp gibi bir servise geçtiğinizde bu bloğu silip
     forma action + method vermek yeterli. */
  const form = document.getElementById("bulten") as HTMLFormElement | null;
  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const alan = document.getElementById("eposta") as HTMLInputElement;
    if (!alan.checkValidity()) {
      alan.reportValidity();
      return;
    }
    const konu = encodeURIComponent("Bülten aboneliği");
    const govde = encodeURIComponent(
      `Merhaba,\n\nCarotOS sürüm bültenine katılmak istiyorum.\nE-posta adresim: ${alan.value}\n`,
    );
    window.location.href = `mailto:carotosproject@gmail.com?subject=${konu}&body=${govde}`;
  });
</script>

