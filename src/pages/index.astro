];

const uygulamalar = [
  {
    baslik: "Güvenlik Paneli",
    metin:
      "On aracın grafik arayüzü. Her alanın işlevi yanında açıklanır, komut çıktısı canlı akar, yetki gerektiren işlemler pkexec üzerinden yürütülür.",
  },
