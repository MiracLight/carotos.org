    text: "学生が安全な環境でペネトレーションテストを学ぶためのアプリケーションです。課題は hydra、nmap、john、sqlmap、tshark で解き、ufw と fail2ban で防御の練習もできます。クラスで CTF 大会を開くこともでき、学生ごとに専用のフラグが割り当てられ、スコアはライブのスコアボードに表示されます。ディフェンダービューでは、偽のサービスへの攻撃と、ufw・fail2ban の状態を確認できます。すべて自分のコンピューターの中で完結します。",
  },
  {
    title: "CarotOS Poligon 教師用",
    icon: "/ikonlar/ikon-poligon-ogretmen.webp",
    text: "教師向けの授業管理アプリケーションです。ワンクリックで教室のルームを開き、各学生の進み具合を確認し、課題を割り当て、選んだ学生にヒントを送れます。CTF 大会の開始と終了、ライブスコアの確認、結果の CSV 保存もできます。",
  },
  {
    title: "CarotOSストア",
    icon: "/ikonlar/ikon-magaza.webp",
    yeni: "1.2",
    text: "Debian のリポジトリにある220個のアプリケーションを、10カテゴリーで一覧できるソフトウェアストアです。アプリケーションはワンクリックでインストール・削除できます。ライトテーマとダークテーマがあり、画面はトルコ語と英語に対応しています。",
  },
  {
    title: "Carotene",
    icon: "/ikonlar/ikon-carotene.webp",
    yeni: "1.3",
    text: "ClamAV をベースにしたアンチウイルスアプリケーションです。クイックスキャン、ホームフォルダーのスキャン、選んだフォルダーのスキャンができます。感染したファイルは隔離に移され、ウイルス定義はアプリケーションから更新でき、過去のスキャンは履歴に残ります。バックグラウンドのサービスはインストールされず、自分で開始したときだけスキャンします。問題なくスキャンが完了した場合にだけ、「クリーン」という結果を表示します。",
  },
  {
    title: "CarotPot",
    icon: "/ikonlar/ikon-carotpot.webp",
    yeni: "1.3",
    text: "ローカルネットワーク上の不審な動きを捉えるトラップシステムです。SSH、Telnet、FTP、MySQL などの偽のサービスを開き、接続してきたデバイスを記録して警告します。実際にログインできる人はいません。おとりのファイルが開かれたり変更されたりしたときにも警告し、起動時に自動では始まりません。攻撃者ごとにリスクスコアとタイムラインが付き、ブロック、一定時間のブロック、メモの追加ができます。",
  },
  {
    title: "Filenor",
    icon: "/ikonlar/ikon-filenor.webp",
    yeni: "1.3",
    text: "画像、音声、動画、文書、表計算、プレゼンテーション、フォントのファイルを、ひとつの画面から変換できるコンバーターです。PDF の結合、分割、回転、縮小、ロックや、スキャンした文書の文字認識(OCR)もできます。既存のファイルを上書きすることはなく、コマンドライン版もあります。CarotOS にはあらかじめインストールされており、Debian、Ubuntu、Windows 向けもダウンロードできます。",
    links: [
      { label: "Filenor のダウンロード(.deb と Windows の .exe)", url: "https://github.com/MiracLight/filenor/releases/latest" },
      { label: "ソースコード", url: "https://github.com/MiracLight/filenor" },
    ],
  },
  {
    title: "CarotOS Former",
    icon: "/ikonlar/ikon-former.webp",
    yeni: "1.3",
    text: "セキュリティツールをアニメーションで教えるガイドです。セキュリティパネルの各ツールと、CarotPot、Carotene に、解説、再生できるアニメーション、「自分で試す」セクションがあります。CTF 大会、コマンド解説、倫理、ディスク暗号化、ISO の検証、ディフェンダービューのトピックも収録しています。トルコ語と英語で利用できます。",
  },
  {
    title: "CarotOS GSD",
    icon: "/ikonlar/ikon-gsd.webp",
    yeni: "1.3",
    text: "総合システム辞典(General System Dictionary)です。Linux、ネットワーク、サイバーセキュリティ、暗号、コンピューターサイエンスの197語を収録しています。用語の検索、コマンド例の表示、関連用語へのジャンプができます。トルコ語と英語で利用できます。",
  },
];

const poligonApps = [
  {
    title: "CarotOS Poligon",
    icon: "/ikonlar/ikon-poligon-ogrenci.webp",
    screenshot: "/ekranlar/poligon-ogrenci.webp",
    alt: "ゲスト、アカウント作成、サインインの選択肢を表示した CarotOS Poligon の学生用アプリケーション",
    text: "アカウントなしのゲストとして使うことも、ユーザーアカウントでサインインして使うこともできます。進み具合はサインインしたアカウントに保存されます。課題は、ひとりで解くか、教室のルームに参加して解きます。",
  },
  {
    title: "CarotOS Poligon 教師用",
    icon: "/ikonlar/ikon-poligon-ogretmen.webp",
    screenshot: "/ekranlar/poligon-ogretmen.webp",
    alt: "ルームコード、ルームのパスワード、学生一覧、ヒント欄を表示した CarotOS Poligon の教師用アプリケーション",
    text: "ルームコードとパスワードは、ワンクリックで生成されます。学生ごとの表示とクラスの表示、問題の作成、保存した問題は、それぞれ別のタブにあります。ヒントは、ひとりの学生にもクラス全体にも送れます。",
  },
];

const securityApps = [
  {
    title: "CarotPot",
    icon: "/ikonlar/ikon-carotpot.webp",
    screenshot: "/ekranlar/carotpot.webp",
    ratio: "1280 / 820",
    alt: "CarotPot のダッシュボード: トラップがオン、1時間ごとのアクティビティのグラフ、トラップ別のイベント数、最も活発な攻撃者、ライブフィード",
    text: "ローカルネットワーク上で、このコンピューターをスキャンしたりログインを試みたりするデバイスを検出します。SSH、Web パネル、Telnet、FTP、VNC、RDP、MySQL、Redis の8つの偽のサービスを開きます。ダッシュボードには、直近24時間のアクティビティと、最も活発な攻撃者が表示されます。攻撃者プロフィールには、試行されたユーザー名、マスクされたパスワード、リスクスコアが並びます。デバイスをブロックするときは、確認を求められます。",
  },
  {
    title: "Carotene",
    icon: "/ikonlar/ikon-carotene.webp",
    screenshot: "/ekranlar/carotene.webp",
    ratio: "1040 / 700",
    alt: "Carotene: 2件の脅威が見つかったスキャン結果、ウイルス定義の経過日数、スキャンのオプション",
    text: "ClamAV で、クイックスキャン、ホームフォルダーのスキャン、カスタムフォルダーのスキャンを実行します。スキャン中は、スキャン済みファイル数と検出結果がリアルタイムで更新されます。見つかったファイルは、隔離、削除、無視のいずれかを選べます。ウイルス定義の経過日数はメイン画面に表示され、アプリケーションから更新できます。クリーンという結果はファイルの安全を保証するものではなく、既知のシグネチャが見つからなかったことを示すだけです。",
  },
];

const tools = [
  { name: "nmap", job: "ネットワークとポートのスキャン" },
  { name: "tcpdump", job: "パケットキャプチャ" },
  { name: "tshark", job: "トラフィック解析" },
  { name: "aircrack-ng", job: "無線ネットワークのテスト" },
  { name: "nikto", job: "Web サーバーのスキャン" },
  { name: "sqlmap", job: "SQL インジェクションのテスト" },
  { name: "john", job: "パスワード強度の解析" },
  { name: "hydra", job: "認証のテスト" },
  { name: "ufw", job: "ファイアウォール" },
  { name: "fail2ban", job: "侵入防止" },
];
---

<Base
  lang="ja"
  title="CarotOS — サイバーセキュリティを学ぶための Linux ディストリビューション"
  description="Debian 13 ベースの教育向け Linux ディストリビューション。10個のセキュリティツールと13個のオリジナルアプリケーションを収録しています。"
>
  {/* ============================================================
      HERO
      ============================================================ */}
  <section class="band band--foam hero">
    <div class="wrap hero__inner">
      <div class="hero__text">
        <p class="eyebrow">Debian 13 · XFCE · amd64</p>
        <h1>少数精鋭、しっかり解説。</h1>
        <p class="lede hero__lede">
          CarotOS は、サイバーセキュリティ教育のために作られた Linux
          ディストリビューションです。10個のセキュリティツールと、このプロジェクトのために書かれた13個のアプリケーションを収録しています。
        </p>

        <div class="hero__actions">
          <a class="btn btn--solid" href="#download">
            <span>ダウンロード</span>
            <span class="hero__size">{release.size}</span>
          </a>
          <a
            class="btn btn--ghost"
            href="https://github.com/MiracLight/CarotOS"
            target="_blank"
            rel="noopener noreferrer">ソースコード</a
          >
        </div>
      </div>

      <div class="hero__art" aria-hidden="true">
        <span class="ripple ripple--1"></span>
        <span class="ripple ripple--2"></span>
        <span class="ripple ripple--3"></span>
        <div class="hero__turtle" data-minigame-trigger>
          <Turtle shell="#378ADA" body="#185FA5" />
        </div>
      </div>
    </div>

    <div class="wrap">
      <dl class="facts">
        {
          facts.map((f) => (
            <div class="facts__item">
              <dt class="facts__num">{f.num}</dt>
              <dd class="facts__label">{f.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <Wave from="#f4f9fd" to="#deedf8" />

  {/* ============================================================
      PHILOSOPHY
      ============================================================ */}
  <section id="philosophy" class="band band--shallow">
    <div class="wrap">
      <p class="eyebrow">方針</p>
      <h2 class="sec__title">範囲と設計の原則</h2>
      <p class="lede sec__lede">
        CarotOS は、大量のツールを収録するディストリビューションの代わりを目指すものではありません。Debian
        のインストールの上に、10個のツールと、それを操作するための画面を加えたものです。目指しているのはツールの数ではなく、教室で実際に使える土台です。
      </p>

      <div class="grid grid--2 sec__grid">
        {
          philosophy.map((p) => (
            <article class="card">
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <Wave from="#deedf8" to="#a9cfea" />

  {/* ============================================================
      WHAT'S INSIDE
      ============================================================ */}
  <section id="inside" class="band band--tide">
    <div class="wrap">
      <p class="eyebrow">アプリケーション</p>
      <h2 class="sec__title">アプリケーションとツール</h2>
      <p class="lede sec__lede">
        このプロジェクトのために Python と GTK3 で書かれた13個のアプリケーションを、GPL-3.0 で配布しています。
      </p>

      <div class="grid grid--2 sec__grid">
        {
          apps.map((a, i) => (
            <article class="card app">
              {a.icon ? (
                <img
                  class="app__logo"
                  src={a.icon}
                  alt=""
                  width="44"
                  height="44"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <span class="app__no">{String(i + 1).padStart(2, "0")}</span>
              )}
              <div>
                <h3>
                  {a.title}
                  {a.yeni && <span class="app__tag">{a.yeni}</span>}
                </h3>
                <p>{a.text}</p>
                {a.links && (
                  <p class="app__links">
                    {a.links.map((l) => (
                      <a href={l.url} rel="noopener">{l.label}</a>
                    ))}
                  </p>
                )}
              </div>
            </article>
          ))
        }
      </div>

      <div class="tools">
        <h3 class="tools__title">インストール済みのツール</h3>
        <ul class="tools__list">
          {
            tools.map((t) => (
              <li class="tool">
                <span class="tool__hex" aria-hidden="true" />
                <span class="tool__name">{t.name}</span>
                <span class="tool__job">{t.job}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="gorseller">
        <h3 class="tools__title">スクリーンショット</h3>
        <Slayt lang="ja" slaytlar={slides} />
      </div>

      <div class="poligon">
        <h3 class="tools__title">CarotOS Poligon</h3>
        <p class="lede poligon__lede">
          学生と教師のための、隔離された安全なペネトレーションテスト環境です。教師が教室のルームを作り、学生は自分のコンピューターで本物のツールを使って課題を解きます。ネットワークに公開されるコンポーネントはありません。すべての処理はローカルのコンピューター上で動きます。
        </p>
        <div class="grid grid--2 poligon__grid">
          {
            poligonApps.map((p) => (
              <article class="card poligon__card">
                <div class="poligon__head">
                  <img src={p.icon} alt="" class="poligon__ikon" width="40" height="40" />
                  <h4>{p.title}</h4>
                </div>
                <p>{p.text}</p>
                <div class="poligon__ekran-cerceve">
                  <img
                    src={p.screenshot}
                    alt={p.alt}
                    class="poligon__ekran"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              </article>
            ))
          }
        </div>
      </div>

      <div class="poligon">
        <h3 class="tools__title">CarotPot と Carotene</h3>
        <p class="lede poligon__lede">
          ネットワークとファイルのセキュリティのための2つのアプリケーションです。CarotPot は、偽のサービスでローカルネットワーク上のスキャンやログイン試行を捉えます。Carotene は
          ClamAV でファイルをスキャンします。どちらも、自分で起動しない限りバックグラウンドでは動きません。
        </p>
        <div class="grid grid--2 poligon__grid">
          {
            securityApps.map((p) => (
              <article class="card poligon__card">
                <div class="poligon__head">
                  <img src={p.icon} alt="" class="poligon__ikon" width="40" height="40" />
                  <h4>{p.title}</h4>
                </div>
                <p>{p.text}</p>
                <div class="poligon__ekran-cerceve" style={`aspect-ratio: ${p.ratio}`}>
                  <img
                    src={p.screenshot}
                    alt={p.alt}
                    class="poligon__ekran"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <Wave from="#a9cfea" to="#185fa5" />

  {/* ============================================================
      DOWNLOAD
      ============================================================ */}
  <section id="download" class="band band--deep">
    <div class="wrap">
      <p class="eyebrow">ダウンロード</p>
      <h2 class="sec__title">リリース {release.tag} “{release.codename}”</h2>
      <p class="lede sec__lede">
        ライブデスクトップの「CarotOS をインストール」アイコンから、そのままインストールできます。BIOS と UEFI
        のどちらのインストールもテスト済みです。ISO には、セキュアブート用の署名付き shim が含まれています。Wi-Fi、オーディオ、グラフィックス用のファームウェアパッケージも収録しています。
      </p>

      <div class="dl">
        <article class="dl__card">
          <div class="dl__head">
            <div>
              <p class="dl__arch">デスクトップ</p>
              <p class="dl__isa mono">x86_64</p>
            </div>
            <span class="dl__badge">安定版 · {release.codename}</span>
          </div>

          <ul class="dl__meta">
            <li><span>ファイル</span><span class="mono">{release.file}</span></li>
            <li><span>サイズ</span><span class="mono">{release.size}</span></li>
            <li><span>デスクトップ</span><span>XFCE</span></li>
            <li><span>公開日</span><span>{release.date}</span></li>
          </ul>

          <a class="btn btn--light dl__btn" href={release.url}>
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M12 3v13m0 0 5-5m-5 5-5-5M4 20h16"
                stroke="currentColor"
                stroke-width="2.1"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
            <span>ISO をダウンロード</span>
          </a>

          <div class="verify">
            <p class="verify__hash">
              <span class="verify__hash-label">SHA-256</span>
              <code>{release.sha256}</code>
            </p>
            <a class="verify__link" href={release.shaUrl}
              >{release.file}.sha256</a
            >
          </div>
        </article>

        <div class="dl__yan">
          <div class="req">
            <p class="dl__soon-title">システム要件</p>
            <ul class="req__list">
              {
                requirements.map((r) => (
                  <li>
                    <span>{r.name}</span>
                    <span>{r.value}</span>
                  </li>
                ))
              }
            </ul>
            <p class="req__not">
              Debian 13 “trixie” のデスクトップインストールで推奨される最小要件です。XFCE は GNOME や KDE Plasma よりも少ないリソースで動作します。Debian 13 は i386 アーキテクチャーをサポートしていません。
            </p>
          </div>

          <div class="dl__soon">
          <p class="dl__soon-title">今後のリリース予定</p>

          <article class="soon">
            <div>
              <p class="soon__arch">CarotDeck</p>
              <p class="soon__isa mono">arm64</p>
            </div>
            <p class="soon__note">
              Orange Pi 5 で i3wm を動かす、持ち運べるビルドです。アイドル時のメモリー使用量は 200 MB を目標としています。
            </p>
            <span class="soon__tag">開発中</span>
          </article>

            <p class="dl__soon-foot">
              ほかのデスクトップ環境向けのビルドも計画しています。
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Wave from="#185fa5" to="#0b2e52" />

  {/* ============================================================
      RELEASES / NEWSLETTER
      ============================================================ */}
  <section id="releases" class="band band--abyss news">
    <div class="wrap">
      <p class="eyebrow">リリース</p>
      <h2 class="sec__title">リリースの通知</h2>
      <p class="lede sec__lede">
        リリースノートは GitHub で公開しています。追加したツール、修正した不具合、互換性のない変更を掲載しています。
      </p>

      <div class="news__grid">
        <div class="news__card news__card--wide">
          <h3>メールニュースレター</h3>
          <p>
            リリースノートをメールでお届けします。メールアドレスはほかの目的には使いません。
          </p>

          <form class="sub" id="newsletter">
            <label class="visually-hidden" for="email">メールアドレス</label
            >
            <input
              id="email"
              name="email"
              type="email"
              required
              placeholder="you@example.com"
              autocomplete="email"
            />
            <button class="btn btn--light" type="submit">登録</button>
          </form>
          <p class="sub__note">
            「登録」を押すと、文面が入力済みのメールアプリが開きます。
          </p>
        </div>

        <div class="news__card">
          <h3>GitHub</h3>
          <p>
            リポジトリで <strong>Watch → Custom → Releases</strong> を選ぶと、リリースのたびに通知が届きます。
          </p>
          <a
            class="btn btn--outline-light news__btn"
            href="https://github.com/MiracLight/CarotOS/releases"
            target="_blank"
            rel="noopener noreferrer">リリース</a
          >
        </div>

        <div class="news__card">
          <h3>RSS / Atom</h3>
          <p>
            リリースフィードをリーダーに直接追加できます。登録は不要です。
          </p>
          <a
            class="btn btn--outline-light news__btn"
            href="https://github.com/MiracLight/CarotOS/releases.atom"
            target="_blank"
            rel="noopener noreferrer">フィードのアドレス</a
          >
        </div>
      </div>

      <p class="news__last">
        最新のリリース <strong>{release.tag}</strong> — {release.date}
      </p>
    </div>
  </section>
  <Minigame lang="ja" />
</Base>

<script>
  /* Newsletter form.
     Not wired to an email service yet; on submit it opens the visitor's
     mail app with a prepared message. Once you move to Buttondown,
     Mailchimp or similar, delete this block and give the form an
     action + method instead. */
  const form = document.getElementById("newsletter") as HTMLFormElement | null;
  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const field = document.getElementById("email") as HTMLInputElement;
    if (!field.checkValidity()) {
      field.reportValidity();
      return;
    }
