    text: "Um guia que ensina as ferramentas de segurança com animações. Cada ferramenta do Painel de Segurança, assim como o CarotPot e o Carotene, tem uma explicação, uma animação interativa e uma seção “experimente você mesmo”. Há tópicos sobre a competição CTF, o Explicador de comandos, a ética, a criptografia de disco, a verificação da ISO e a visão do defensor. Funciona em turco e inglês.",
  },
  {
    title: "CarotOS GSD",
    icon: "/ikonlar/ikon-gsd.webp",
    yeni: "1.3",
    text: "O Dicionário Geral de Sistemas (GSD), com 197 termos de Linux, redes, segurança cibernética, criptografia e ciência da computação. Você pode pesquisar os termos, ver comandos de exemplo e ir para termos relacionados. Está disponível em turco e inglês.",
  },
];

const poligonApps = [
  {
    title: "CarotOS Poligon",
    icon: "/ikonlar/ikon-poligon-ogrenci.webp",
    screenshot: "/ekranlar/poligon-ogrenci.webp",
    alt: "Aplicativo do aluno do CarotOS Poligon: opções de convidado, criar conta e entrar",
    text: "Você pode usar como convidado, sem conta, ou entrar com uma conta de usuário. O progresso é salvo para quem entra com uma conta. As tarefas são feitas sozinho ou entrando em uma sala de aula.",
  },
  {
    title: "CarotOS Poligon Professor",
    icon: "/ikonlar/ikon-poligon-ogretmen.webp",
    screenshot: "/ekranlar/poligon-ogretmen.webp",
    alt: "Aplicativo do professor do CarotOS Poligon: código da sala, senha da sala, lista de alunos e campo de dica",
    text: "Um código e uma senha de sala são gerados com um clique. As visões de alunos e da turma, a criação de perguntas e as perguntas salvas ficam em abas separadas. Uma dica pode ser enviada a um aluno ou a toda a turma.",
  },
];

const securityApps = [
  {
    title: "CarotPot",
    icon: "/ikonlar/ikon-carotpot.webp",
    screenshot: "/ekranlar/carotpot.webp",
    ratio: "1280 / 820",
    alt: "Painel do CarotPot: armadilhas ligadas, um gráfico de atividade por hora, eventos por armadilha, os atacantes mais ativos e um feed ao vivo",
    text: "Detecta dispositivos da rede local que fazem varredura neste computador ou tentam fazer login nele. Abre oito serviços falsos: SSH, painel web, Telnet, FTP, VNC, RDP, MySQL e Redis. O painel mostra a atividade das últimas 24 horas e os atacantes mais ativos. O perfil de um atacante lista os nomes de usuário tentados, as senhas mascaradas e uma pontuação de risco. Bloquear um dispositivo exige a sua confirmação.",
  },
  {
    title: "Carotene",
    icon: "/ikonlar/ikon-carotene.webp",
    screenshot: "/ekranlar/carotene.webp",
    ratio: "1040 / 700",
    alt: "Carotene: resultado de uma verificação com duas ameaças encontradas, a idade das definições de vírus e as opções de verificação",
    text: "Executa verificações rápidas, da pasta pessoal e de pastas personalizadas com o ClamAV. Enquanto a verificação roda, o número de arquivos verificados e os itens encontrados são atualizados ao vivo. Os arquivos encontrados podem ser colocados em quarentena, excluídos ou ignorados. A idade das definições de vírus aparece na tela principal, e elas são atualizadas pelo aplicativo. Um resultado limpo não garante que os arquivos sejam seguros; mostra apenas que nenhuma assinatura conhecida foi encontrada.",
  },
];

const tools = [
  { name: "nmap", job: "Varredura de rede e de portas" },
  { name: "tcpdump", job: "Captura de pacotes" },
  { name: "tshark", job: "Análise de tráfego" },
  { name: "aircrack-ng", job: "Testes de redes sem fio" },
  { name: "nikto", job: "Varredura de servidores web" },
  { name: "sqlmap", job: "Testes de injeção de SQL" },
  { name: "john", job: "Análise da força de senhas" },
  { name: "hydra", job: "Testes de autenticação" },
  { name: "ufw", job: "Firewall" },
  { name: "fail2ban", job: "Prevenção de intrusões" },
];
---

<Base
  lang="pt"
  title="CarotOS | Uma distribuição Linux para aprender segurança cibernética"
  description="Uma distribuição Linux baseada no Debian 13, voltada ao ensino, com dez ferramentas de segurança e treze aplicativos originais."
>
  {/* ============================================================
      HERO
      ============================================================ */}
  <section class="band band--foam hero">
    <div class="wrap hero__inner">
      <div class="hero__text">
        <p class="eyebrow">Debian 13 · XFCE · amd64</p>
        <h1>Poucas, bem explicadas.</h1>
        <p class="lede hero__lede">
          O CarotOS é uma distribuição Linux criada para o ensino de segurança
          cibernética. Ele traz dez ferramentas de segurança e treze aplicativos
          escritos para o projeto.
        </p>

        <div class="hero__actions">
          <a class="btn btn--solid" href="#download">
            <span>Baixar</span>
            <span class="hero__size">{release.size}</span>
          </a>
          <a
            class="btn btn--ghost"
            href="https://github.com/MiracLight/CarotOS"
            target="_blank"
            rel="noopener noreferrer">Código-fonte</a
          >
        </div>
      </div>

      <div class="hero__art" aria-hidden="true">
        <span class="ripple ripple--1"></span>
        <span class="ripple ripple--2"></span>
        <span class="ripple ripple--3"></span>
        <div class="hero__turtle" data-minigame-trigger>
          <Turtle shell="#378ADA" body="#185FA5" />
        </div>
      </div>
    </div>

    <div class="wrap">
      <dl class="facts">
        {
          facts.map((f) => (
            <div class="facts__item">
              <dt class="facts__num">{f.num}</dt>
              <dd class="facts__label">{f.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <Wave from="#f4f9fd" to="#deedf8" />

  {/* ============================================================
      PHILOSOPHY
      ============================================================ */}
  <section id="philosophy" class="band band--shallow">
    <div class="wrap">
      <p class="eyebrow">Abordagem</p>
      <h2 class="sec__title">Escopo e princípios de projeto</h2>
      <p class="lede sec__lede">
        O CarotOS não é uma alternativa às distribuições que trazem grandes
        conjuntos de ferramentas. Ele acrescenta dez ferramentas e as interfaces
        para usá-las sobre uma instalação do Debian. O objetivo não é ter mais
        ferramentas, e sim uma base que funcione em sala de aula.
      </p>

      <div class="grid grid--2 sec__grid">
        {
          philosophy.map((p) => (
            <article class="card">
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <Wave from="#deedf8" to="#a9cfea" />

  {/* ============================================================
      WHAT'S INSIDE
      ============================================================ */}
  <section id="inside" class="band band--tide">
    <div class="wrap">
      <p class="eyebrow">Aplicativos</p>
      <h2 class="sec__title">Aplicativos e ferramentas</h2>
      <p class="lede sec__lede">
        Treze aplicativos escritos para este projeto em Python e GTK3,
        distribuídos sob a GPL-3.0.
      </p>

      <div class="grid grid--2 sec__grid">
        {
          apps.map((a, i) => (
            <article class="card app">
              {a.icon ? (
                <img
                  class="app__logo"
                  src={a.icon}
                  alt=""
                  width="44"
                  height="44"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <span class="app__no">{String(i + 1).padStart(2, "0")}</span>
              )}
              <div>
                <h3>
                  {a.title}
                  {a.yeni && <span class="app__tag">{a.yeni}</span>}
                </h3>
                <p>{a.text}</p>
                {a.links && (
                  <p class="app__links">
                    {a.links.map((l) => (
                      <a href={l.url} rel="noopener">{l.label}</a>
                    ))}
                  </p>
                )}
              </div>
            </article>
          ))
        }
      </div>

      <div class="tools">
        <h3 class="tools__title">Ferramentas instaladas</h3>
        <ul class="tools__list">
          {
            tools.map((t) => (
              <li class="tool">
                <span class="tool__hex" aria-hidden="true" />
                <span class="tool__name">{t.name}</span>
                <span class="tool__job">{t.job}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="gorseller">
        <h3 class="tools__title">Capturas de tela</h3>
        <Slayt lang="pt" slaytlar={slides} />
      </div>

      <div class="poligon">
        <h3 class="tools__title">CarotOS Poligon</h3>
        <p class="lede poligon__lede">
          Um ambiente de testes de invasão isolado e seguro para alunos e
          professores. O professor cria uma sala de aula; os alunos fazem as
          tarefas com ferramentas reais em suas próprias máquinas. Não há
          componentes expostos à rede. Todas as operações rodam na máquina
          local.
        </p>
        <div class="grid grid--2 poligon__grid">
          {
            poligonApps.map((p) => (
              <article class="card poligon__card">
                <div class="poligon__head">
                  <img src={p.icon} alt="" class="poligon__ikon" width="40" height="40" />
                  <h4>{p.title}</h4>
                </div>
                <p>{p.text}</p>
                <div class="poligon__ekran-cerceve">
                  <img
                    src={p.screenshot}
                    alt={p.alt}
                    class="poligon__ekran"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              </article>
            ))
          }
        </div>
      </div>

      <div class="poligon">
        <h3 class="tools__title">CarotPot e Carotene</h3>
        <p class="lede poligon__lede">
          Dois aplicativos para a segurança de rede e de arquivos. O CarotPot
          detecta varreduras e tentativas de login na rede local com serviços
          falsos. O Carotene verifica arquivos com o ClamAV. Nenhum dos dois
          roda em segundo plano se você não o iniciar.
        </p>
        <div class="grid grid--2 poligon__grid">
          {
            securityApps.map((p) => (
              <article class="card poligon__card">
                <div class="poligon__head">
                  <img src={p.icon} alt="" class="poligon__ikon" width="40" height="40" />
                  <h4>{p.title}</h4>
                </div>
                <p>{p.text}</p>
                <div class="poligon__ekran-cerceve" style={`aspect-ratio: ${p.ratio}`}>
                  <img
                    src={p.screenshot}
                    alt={p.alt}
                    class="poligon__ekran"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <Wave from="#a9cfea" to="#185fa5" />

  {/* ============================================================
      DOWNLOAD
      ============================================================ */}
  <section id="download" class="band band--deep">
    <div class="wrap">
      <p class="eyebrow">Download</p>
      <h2 class="sec__title">Versão {release.tag} “{release.codename}”</h2>
      <p class="lede sec__lede">
        Instale direto da área de trabalho live, com o ícone “Instalar o
        CarotOS”. As instalações em BIOS e em UEFI foram testadas. A ISO inclui
        um shim assinado para o Secure Boot. Os pacotes de firmware para
        hardware de Wi-Fi, áudio e vídeo estão incluídos.
      </p>

      <div class="dl">
        <article class="dl__card">
          <div class="dl__head">
            <div>
              <p class="dl__arch">Desktop</p>
              <p class="dl__isa mono">x86_64</p>
            </div>
            <span class="dl__badge">Estável · {release.codename}</span>
          </div>

          <ul class="dl__meta">
            <li><span>Arquivo</span><span class="mono">{release.file}</span></li>
            <li><span>Tamanho</span><span class="mono">{release.size}</span></li>
            <li><span>Ambiente</span><span>XFCE</span></li>
            <li><span>Lançamento</span><span>{release.date}</span></li>
          </ul>

          <a class="btn btn--light dl__btn" href={release.url}>
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M12 3v13m0 0 5-5m-5 5-5-5M4 20h16"
                stroke="currentColor"
                stroke-width="2.1"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
            <span>Baixar a ISO</span>
          </a>

          <div class="verify">
            <p class="verify__hash">
              <span class="verify__hash-label">SHA-256</span>
              <code>{release.sha256}</code>
            </p>
            <a class="verify__link" href={release.shaUrl}
              >{release.file}.sha256</a
            >
          </div>
        </article>

        <div class="dl__yan">
          <div class="req">
            <p class="dl__soon-title">Requisitos do sistema</p>
            <ul class="req__list">
              {
                requirements.map((r) => (
                  <li>
                    <span>{r.name}</span>
                    <span>{r.value}</span>
                  </li>
                ))
              }
            </ul>
            <p class="req__not">
              Mínimos recomendados para uma instalação desktop do Debian 13
              “trixie”. O XFCE usa menos recursos que o GNOME ou o KDE Plasma.
              O Debian 13 não oferece suporte à arquitetura i386.
            </p>
          </div>

          <div class="dl__soon">
          <p class="dl__soon-title">Projetos planejados</p>

          <article class="soon">
            <div>
              <p class="soon__arch">CarotOS AUL</p>
              <p class="soon__isa mono">arm64</p>
            </div>
            <p class="soon__note">
              Uma versão leve baseada no Armbian (Armbian Ultra Light). Roda com IceWM em placas arm64 como a Orange Pi 5. A meta de uso de memória em repouso é de 200 MB.
            </p>
            <span class="soon__tag">Em desenvolvimento</span>
          </article>

            <p class="dl__soon-foot">
              O CarotDeck, um projeto de hardware portátil, virá depois.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Wave from="#185fa5" to="#0b2e52" />

  {/* ============================================================
      RELEASES / NEWSLETTER
      ============================================================ */}
  <section id="releases" class="band band--abyss news">
    <div class="wrap">
      <p class="eyebrow">Versões</p>
      <h2 class="sec__title">Avisos de novas versões</h2>
      <p class="lede sec__lede">
        As notas de versão são publicadas no GitHub: ferramentas adicionadas,
        erros corrigidos e mudanças que quebram a compatibilidade.
      </p>

      <div class="news__grid">
        <div class="news__card news__card--wide">
          <h3>Boletim por e-mail</h3>
          <p>
            Notas de versão enviadas por e-mail. Os endereços não são usados
            para nenhum outro fim.
          </p>

          <form class="sub" id="newsletter">
            <label class="visually-hidden" for="email">Seu endereço de e-mail</label
            >
            <input
              id="email"
              name="email"
              type="email"
              required
              placeholder="voce@exemplo.com"
              autocomplete="email"
            />
            <button class="btn btn--light" type="submit">Participar</button>
          </form>
          <p class="sub__note">
            “Participar” abre o aplicativo de e-mail com uma mensagem pronta.
          </p>
        </div>

        <div class="news__card">
          <h3>GitHub</h3>
          <p>
            Ao escolher <strong>Watch → Custom → Releases</strong> no
            repositório, você recebe uma notificação a cada nova versão.
          </p>
          <a
            class="btn btn--outline-light news__btn"
            href="https://github.com/MiracLight/CarotOS/releases"
            target="_blank"
            rel="noopener noreferrer">Versões</a
          >
        </div>

        <div class="news__card">
          <h3>RSS / Atom</h3>
          <p>
            O feed de versões pode ser adicionado diretamente a um leitor. Não é
            preciso se cadastrar.
          </p>
          <a
            class="btn btn--outline-light news__btn"
            href="https://github.com/MiracLight/CarotOS/releases.atom"
            target="_blank"
            rel="noopener noreferrer">Endereço do feed</a
          >
        </div>
      </div>

      <p class="news__last">
        Última versão <strong>{release.tag}</strong> — {release.date}
      </p>
    </div>
  </section>
  <Minigame lang="pt" />
</Base>

<script>
  /* Newsletter form.
     Not wired to an email service yet; on submit it opens the visitor's
     mail app with a prepared message. Once you move to Buttondown,
     Mailchimp or similar, delete this block and give the form an
     action + method instead. */
  const form = document.getElementById("newsletter") as HTMLFormElement | null;
  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const field = document.getElementById("email") as HTMLInputElement;
    if (!field.checkValidity()) {
      field.reportValidity();
      return;
    }
    const subject = encodeURIComponent("Inscrição no boletim");
    const body = encodeURIComponent(
      `Olá,\n\nGostaria de receber o boletim de versões do CarotOS.\nMeu endereço de e-mail: ${field.value}\n`,
    );
    window.location.href = `mailto:carotosproject@gmail.com?subject=${subject}&body=${body}`;
  });
</script>

