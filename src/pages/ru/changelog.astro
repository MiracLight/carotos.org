      { tur: "eklendi", metin: "Задания по защите в Poligon с использованием ufw и fail2ban" },
      { tur: "duzeltildi", metin: "tshark завершался с ошибкой доступа под обычной учётной записью; группа wireshark теперь добавляется автоматически" },
      { tur: "duzeltildi", metin: "Имя пользователя, показываемое при загрузке в режиме «Try Live», отображалось как «Debian Live User»" },
    ],
  },
  {
    etiket: "1.0",
    kodAdi: "Eggshell",
    tarih: "19 августа 2026",
    tarihISO: "2026-08-19",
    ozet:
      "Первый стабильный выпуск. Основа Debian 13 «trixie», рабочий стол XFCE, десять инструментов безопасности и четыре оригинальных приложения.",
    degisiklikler: [
      { tur: "eklendi", metin: "Security Panel: графический интерфейс для десяти инструментов с документацией по полям и выводом в реальном времени" },
      { tur: "eklendi", metin: "Добро пожаловать: двуязычное введение из одиннадцати страниц с выбором темы и языка" },
      { tur: "eklendi", metin: "Здоровье системы: двадцать проверок в шести категориях, оценка состояния, двенадцать исправлений одним щелчком" },
      { tur: "eklendi", metin: "USB Check: проверяет подключённые устройства на autorun.inf, двойные и скрытые расширения" },
      { tur: "eklendi", metin: "Установка в режимах BIOS и UEFI с подписанным shim для Secure Boot" },
      { tur: "eklendi", metin: "Полный набор микропрограмм для Wi-Fi, звука и графики" },
      { tur: "eklendi", metin: "Турецкий как язык по умолчанию, английский доступен" },
      { tur: "duzeltildi", metin: "nikto не запускался в установленной системе; добавлена недостающая зависимость" },
      { tur: "duzeltildi", metin: "Язык, выбранный в мастере, не применялся после перезапуска сеанса" },
      { tur: "duzeltildi", metin: "Значки панели и меню отсутствовали в некоторых темах" },
    ],
  },
];

const etiketler: Record<string, string> = {
  eklendi: "Добавлено",
  duzeltildi: "Исправлено",
  degisti: "Изменено",
  kaldirildi: "Удалено",
};
---

<Base
  lang="ru"
  title="История изменений | CarotOS"
  description="Что изменилось в каждом выпуске CarotOS: добавленные инструменты, исправленные ошибки, изменения, нарушающие обратную совместимость."
>
  <section class="band band--foam log__intro">
    <div class="wrap">
      <p class="eyebrow">История изменений</p>
      <h1 class="log__h1">Что изменилось</h1>
      <p class="lede">
        Для каждого выпуска здесь перечислены добавленные инструменты,
        исправленные ошибки и изменения, нарушающие обратную совместимость.
        Те же примечания публикуются на странице выпусков GitHub.
      </p>
      <div class="log__links">
        <a class="btn btn--ghost" href="/ru#download">Скачать</a>
        <a
          class="btn btn--ghost"
          href="https://github.com/MiracLight/CarotOS/releases"
          target="_blank"
          rel="noopener noreferrer">Выпуски на GitHub</a
        >
      </div>
    </div>
  </section>

  <Wave from="#f4f9fd" to="#deedf8" />

  <section class="band band--shallow">
    <div class="wrap">
      {
        surumler.map((s) => (
          <article class="rel">
            <header class="rel__head">
              <h2 class="rel__tag">
                {s.etiket} <span class="rel__code">“{s.kodAdi}”</span>
              </h2>
              <time class="rel__date mono" datetime={s.tarihISO}>
                {s.tarih}
              </time>
            </header>

            <p class="rel__ozet">{s.ozet}</p>

            <ul class="rel__list">
              {s.degisiklikler.map((d) => (
                <li class="rel__item">
                  <span class={`tag tag--${d.tur}`}>{etiketler[d.tur]}</span>
                  <span class="rel__text">{d.metin}</span>
                </li>
              ))}
            </ul>
          </article>
        ))
      }

      <p class="log__son">
        Более ранних выпусков нет — 1.0 стал первым стабильным. Промежуточные
        сборки из процесса разработки не публиковались.
      </p>
    </div>
  </section>
</Base>

<style>
  .log__intro {
    padding-bottom: clamp(3rem, 6vw, 4rem);
  }

  .log__h1 {
    font-size: clamp(2.4rem, 6vw, 4rem);
    margin-bottom: 1.1rem;
  }

  .log__links {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
    margin-top: 2rem;
  }

  .rel {
    max-width: 78ch;
  }

  .rel + .rel {
    margin-top: 3.5rem;
    padding-top: 3.5rem;
    border-top: 1.5px solid rgba(24, 95, 165, 0.2);
  }

  .rel__head {
    display: flex;
    align-items: baseline;
    gap: 1rem 1.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.9rem;
  }

  .rel__tag {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    margin: 0;
  }

  .rel__code {
    color: var(--current);
    font-weight: 700;
  }

  .rel__date {
    color: var(--ink-faint);
    font-size: 0.85rem;
  }

  .rel__ozet {
    color: var(--ink-soft);
    font-size: 1.02rem;
    margin-bottom: 1.8rem;
    max-width: var(--w-text);
  }

  .rel__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.7rem;
  }

  .rel__item {
    display: grid;
    grid-template-columns: 92px 1fr;
    gap: 0.9rem;
    align-items: baseline;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid rgba(24, 95, 165, 0.13);
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-align: center;
    padding: 0.24rem 0.4rem;
    border-radius: 4px;
    white-space: nowrap;
  }

  .tag--eklendi {
    background: rgba(74, 156, 120, 0.16);
    color: #2f6f52;
  }

  .tag--duzeltildi {
    background: rgba(55, 138, 218, 0.16);
    color: var(--deep);
  }

  .tag--degisti {
    background: rgba(24, 95, 165, 0.1);
    color: var(--ink-soft);
  }

  .tag--kaldirildi {
    background: rgba(160, 90, 90, 0.14);
    color: #8a4646;
  }

  .rel__text {
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .log__son {
    margin-top: 3rem;
    font-size: 0.88rem;
    color: var(--ink-faint);
  }

  @media (max-width: 560px) {
    .rel__item {
      grid-template-columns: 1fr;
      gap: 0.3rem;
    }

    .tag {
      justify-self: start;
    }
  }
</style>
