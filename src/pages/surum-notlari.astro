---
import Base from "../layouts/Base.astro";
import Wave from "../components/Wave.astro";

/* ------------------------------------------------------------------
   SÜRÜM NOTLARI

   Yeni sürüm çıktığında bu dizinin BAŞINA yeni bir nesne ekle.
   Aynısını src/pages/en/changelog.astro içine de ekle.

   tur: "eklendi" | "duzeltildi" | "degisti" | "kaldirildi"
   ------------------------------------------------------------------ */
const surumler = [
  {
    etiket: "1.4",
    kodAdi: "Eggshell",
    tarih: "15 Kasım 2026",
    tarihISO: "2026-11-15",
    ozet:
      "Poligon'a CTF yarışması ve savunmacı görünümü, Komut Açıklayıcı, etik koruma, ISO imza doğrulama ve isteğe bağlı Carot Sleek masaüstü teması geldi. Karşılama 29 sayfaya, Mağaza 220 uygulamaya, GSD 197 terime çıktı; açılış ekranı yenilendi ve tüm uygulamalar güvenlik açısından gözden geçirildi.",
    degisiklikler: [
      { tur: "eklendi", metin: "Poligon CTF yarışması: öğretmen paneli (başlat, bitir, canlı skor, CSV), 12 görevlik paket, öğrenciye özel bayraklar, dinamik puan, ilk çözüm bonusu, ipucu cezası ve skoru dondurma" },
      { tur: "eklendi", metin: "Poligon savunmacı görünümü: sahte servislere gelen saldırıların olay günlüğü, bulgu analizi ve ufw ile fail2ban durumu" },
      { tur: "eklendi", metin: "Komut Açıklayıcı: bir komutu çalıştırmadan önce parçalarını sade dille anlatır; terminalde Alt+E ile açılır, Güvenlik Paneli'nde her aracın yanında “Açıkla” düğmesi vardır" },
      { tur: "eklendi", metin: "Etik koruma: Güvenlik Paneli taramadan önce hedef için onay ister ve onaylanan ağları hatırlar; Ayarlar'dan sıfırlanabilir" },
      { tur: "eklendi", metin: "Karşılama Sihirbazı: Ağ ve gizlilik, Güvenlik duvarı, Disk şifreleme ve swap, Terminal, Komut Açıklayıcı, Etik ve sorumluluk, Windows ile birlikte ve İndirdiğini doğrula sayfaları; konular seçilebilir; sayfa sayısı 29" },
      { tur: "eklendi", metin: "ISO doğrulama: SHA256SUMS ve ayrık imza ile indirilen dosyanın gerçekten CarotOS'tan geldiği doğrulanabilir; Karşılama ve Former'da adım adım anlatım" },
      { tur: "eklendi", metin: "Former: CTF yarışması, Komut Açıklayıcı, Etik, Disk şifreleme, ISO doğrulama ve savunmacı görünümü konuları; konu sayısı 20" },
      { tur: "eklendi", metin: "Carot Sleek: isteğe bağlı modern masaüstü teması, yuvarlak köşeler, gölge ve bulanıklık, alt dock ve kenardan kayarak çıkan CarotOS Yan Paneli; Karşılama'dan açılır, kapatınca önceki görünüm geri gelir" },
      { tur: "eklendi", metin: "Sistem Sağlığı: ağ keşfi (mDNS) tek düğmeyle kapatılıp açılabilir; DHCP ve mDNS gibi beklenen masaüstü dinleyicileri “Dinlenen portlar” puanını düşürmez" },
      { tur: "eklendi", metin: "Ağ ve gizlilik: isteğe bağlı sahte MAC anahtarı (varsayılan kapalı); apt.carotos.org imzalı deposu için anahtar halkası paketi ISO'da gelir" },
      { tur: "eklendi", metin: "Pil göstergesi: dizüstü bilgisayarlarda pil seviyesi sağ üstte, saatin yanında görünür; masaüstü bilgisayarlarda görünmez" },
      { tur: "eklendi", metin: "Yedi dilde arayüz çevirisi: Almanca, Fransızca, İspanyolca, Portekizce, Rusça, Japonca ve Çince" },
      { tur: "degisti", metin: "Açılış: CarotOS Plymouth teması, GRUB 5/30 saniye menü süresi ve os-prober, sessiz açılış, Intel ekranlarda i915.fastboot" },
      { tur: "degisti", metin: "Mağaza kataloğu 153'ten 220 uygulamaya çıktı ve çevirisi yapıldı; yetki gerektiren adımlar ayrı bir yardımcıyla çalışır, indirme aşamasında güvenli iptal edilebilir" },
      { tur: "degisti", metin: "CarotOS GSD 197 terime, Sistem Sağlığı 24 denetime çıktı; uygulama simgeleri yenilendi" },
      { tur: "duzeltildi", metin: "Kapsamlı güvenlik denetimi: Poligon (öğrenciye özel anahtar, bağlantı sınırları, doğrulama), Mağaza, CarotPot, Güvenlik Paneli, Carotene, USB Denetimi, Filenor, Sistem Sağlığı ve kurulum betikleri tek tek gözden geçirilip düzeltildi" },
      { tur: "duzeltildi", metin: "fastfetch çıktısı uzun donanım adında satır sarıp hizayı bozuyordu; değerler kısaltıldı, dar terminalde logosuz açılır" },
      { tur: "duzeltildi", metin: "Former ve diğer uygulamalarda sol menü kendi kaydırma alanına alındı; düşük çözünürlüklü ekranlarda alt kısım kesilmez" },
    ],
  },
  {
    etiket: "1.3",
    kodAdi: "Eggshell",
    tarih: "29 Ekim 2026",
    tarihISO: "2026-10-29",
    ozet:
      "Carotene, CarotPot, Filenor, CarotOS Former ve CarotOS GSD eklendi. Sistem Sağlığı ve USB Denetimi ClamAV ve AppArmor denetimleriyle genişletildi, Mağaza kataloğu 153 uygulamaya çıktı.",
    degisiklikler: [
      { tur: "eklendi", metin: "Carotene: ClamAV ile hızlı, ana klasör ve özel tarama, karantina, virüs tanımı güncelleme ve tarama geçmişi; arka planda hizmet çalıştırmaz" },
      { tur: "eklendi", metin: "CarotPot: yerel ağ için sahte SSH, Telnet, web paneli, FTP, VNC, RDP, MySQL ve Redis tuzakları; saldırgan listesi, kanarya dosyaları ve onaylı engelleme" },
      { tur: "eklendi", metin: "Filenor: görsel, ses, video, belge, tablo, sunum ve yazı tipi dönüştürme; PDF birleştirme, bölme, döndürme, küçültme ve kilitleme; OCR" },
      { tur: "eklendi", metin: "CarotOS Former: güvenlik araçlarını, CarotPot ve Carotene'i canlandırmalarla adım adım anlatan iki dilli rehber" },
      { tur: "eklendi", metin: "CarotOS GSD: Linux, ağ, siber güvenlik, kriptografi, algoritma ve genel bilgisayar bilimi alanlarında 161 terimlik, aranabilir ve iki dilli sözlük" },
      { tur: "eklendi", metin: "Sistem Sağlığı: Koruma katmanları kategorisi (AppArmor, AppArmor profilleri, virüs tanımlarının güncelliği) ve debsums ile rkhunter kullanan ayrıntılı taramalar; denetim sayısı 20'den 23'e, kategori sayısı altıdan yediye çıktı" },
      { tur: "eklendi", metin: "USB Denetimi: yalnızca kullanıcı pencereden başlattığında çalışan ayrıntılı ClamAV taraması; bulunan dosyalara dokunulmaz, yalnızca raporlanır" },
      { tur: "eklendi", metin: "Karşılama Sihirbazı: yeni uygulamalar için sayfalar eklendi; sayfa sayısı 21" },
      { tur: "degisti", metin: "Mağaza kataloğu 51 uygulamadan 153 uygulamaya, yedi kategoriden on kategoriye çıktı; pencere başlığı “CarotOS Mağaza” oldu" },
      { tur: "degisti", metin: "USB Denetimi, Sistem Sağlığı ve Mağaza için yeni simgeler; menüde, panelde ve pencerelerde kullanılıyor" },
      { tur: "eklendi", metin: "Carotene: ClamAV kurulu değilse, tek düğmeyle Mağaza'da ClamAV sayfasını açan \"Mağaza'da ClamAV'ı kur\" düğmesi" },
      { tur: "degisti", metin: "Bilgisayar adı artık \"carotos\" (kullanici@carotos); Karşılama Sihirbazı'nda Carotene, CarotPot ve Filenor başlıklarındaki gereksiz \"CarotOS\" öneki kaldırıldı; Poligon görseli gerçek arayüzle yenilendi" },
      { tur: "duzeltildi", metin: "Simge önbelleği eksik ya da eski olduğunda boşta bellek kullanımı 1 GB'ın üzerine çıkabiliyordu; önbellek her açılışta denetlenip gerekirse yenileniyor" },
      { tur: "duzeltildi", metin: "fastfetch çıktısı dar terminal pencerelerinde bozuluyordu; satırlar kısaltıldı, terminal varsayılan olarak 100×30 açılıyor" },
      { tur: "eklendi", metin: "Mağaza: sepet; birden fazla uygulama tek seferde, tek parola istemiyle kurulabilir" },
      { tur: "eklendi", metin: "Japonca desteği: Noto CJK yazı tipleri ve ja_JP yerel ayarı eklendi; sistem dili Japonca seçildiğinde karakterler kutu olarak görünmez" },
      { tur: "eklendi", metin: "Kurulum sırasında bilgisayar adı sorulur (önerilen ad: carotos)" },
      { tur: "degisti", metin: "Karşılama Sihirbazı: uygulama sayfalarındaki görseller gerçek ekran görüntüleriyle değiştirildi; Dosya sistemi ve Ev dizini görselleri iki dilli olarak yeniden çizildi" },
      { tur: "degisti", metin: "ISO etiketi ve disk bilgisi Debian yerine CarotOS gösterir; GRUB menü girişleri “CarotOS GNU/Linux” olarak görünür" },
      { tur: "degisti", metin: "Kurulu sistemde açılış mesajları azaltıldı; başarısız bir servis yine görünür" },
      { tur: "duzeltildi", metin: "Mağaza: Türkçe sistem dilinde rkhunter gibi bazı paketlerin kurulumu başarısız oluyordu; apt artık dil ayarından bağımsız çalışıyor" },
      { tur: "duzeltildi", metin: "tshark normal kullanıcı hesabında dumpcap erişim hatası verebiliyordu; wireshark grubu ve dumpcap yetkileri kurulumda hazır geliyor" },
      { tur: "duzeltildi", metin: "Kurulum sırasında GRUB için “yerel değişiklik” sorusu çıkıyordu; GRUB ayarları ayrı bir parçaya taşındı" },
      { tur: "duzeltildi", metin: "Canlı oturumda saatin saat kısmı 3 saat geri görünüyordu; saat dilimi Europe/Istanbul oldu" },
      { tur: "duzeltildi", metin: "Poligon: adında boşluk ya da Türkçe karakter olan öğrencilerin sohbeti ve durum bilgisi çalışmıyordu" },
      { tur: "duzeltildi", metin: "Poligon: sınıf ağındaki herhangi bir cihaz öğretmen adına öğrencilere mesaj yazabiliyordu; sohbet artık oda şifresi ister, yanlış şifre denemeleri ve istek boyutu sınırlandı" },
      { tur: "duzeltildi", metin: "Güvenlik Paneli: yönetici yetkisiyle çalıştırırken alanlara yapıştırılan “-” ile başlayan seçenekler reddedilir" },
      { tur: "duzeltildi", metin: "CarotPot: engel listesi, bal küpü hesabının yazabildiği dizinden root'a ait dizine taşındı; engel süresi birimi ek kısıtlamalarla çalışır" },
    ],
  },
  {
    etiket: "1.2",
    kodAdi: "Eggshell",
    tarih: "12 Ekim 2026",
    tarihISO: "2026-10-12",
    ozet:
      "CarotOS Mağaza eklendi, masaüstü teması Arc ve Papirus olarak yenilendi, karşılama sihirbazına arka plan seçimi geldi.",
    degisiklikler: [
      { tur: "eklendi", metin: "CarotOS Mağaza: yedi kategoride 51 uygulama, apt üzerinden kurulum ve kaldırma, açık/koyu tema, Türkçe ve İngilizce arayüz" },
      { tur: "eklendi", metin: "Karşılama Sihirbazı: üç seçenekli masaüstü arka planı sayfası, USB Denetimi ve Mağaza tanıtım sayfaları; sayfa sayısı on beşe çıktı" },
      { tur: "eklendi", metin: "USB Denetimi: oturum açılışında arka planda başlar" },
      { tur: "eklendi", metin: "Poligon: misafir, kullanıcı oluşturma ve kullanıcı girişi seçenekleri" },
      { tur: "eklendi", metin: "Oturum açma ekranı ve masaüstü için yeni CarotOS arka planları; açılış ekranında sürüm numarası 1.2" },
      { tur: "degisti", metin: "Masaüstü teması Arc, simge teması Papirus oldu; açık veya koyu seçim karşılama sihirbazında yapılır, varsayılan koyudur" },
      { tur: "degisti", metin: "Yeni kurulumda varsayılan masaüstü arka planı yeni CarotOS arka planlarından biridir" },
    ],
  },
  {
    etiket: "1.1",
    kodAdi: "Eggshell",
    tarih: "2 Eylül 2026",
    tarihISO: "2026-09-02",
    ozet:
      "CarotOS Poligon eklendi: öğrenci ve öğretmen uygulamalarıyla izole bir ortamda sızma testi pratiği.",
    degisiklikler: [
      { tur: "eklendi", metin: "CarotOS Poligon: hydra, nmap, john, sqlmap ve tshark ile pratik yapılan öğrenci/öğretmen uygulamaları" },
      { tur: "eklendi", metin: "Poligon'da ufw ve fail2ban ile savunma görevleri" },
      { tur: "duzeltildi", metin: "tshark normal kullanıcı hesabında erişim hatası veriyordu; wireshark grubu otomatik ekleniyor" },
      { tur: "duzeltildi", metin: "\"Dene\" modunda oturum açan kullanıcının adı \"Debian Live User\" olarak görünüyordu" },
    ],
  },
  {
    etiket: "1.0",
    kodAdi: "Eggshell",
    tarih: "19 Ağustos 2026",
    tarihISO: "2026-08-19",
    ozet:
      "İlk kararlı sürüm. Debian 13 “trixie” tabanı, XFCE masaüstü, on güvenlik aracı ve dört özgün uygulama.",
    degisiklikler: [
      { tur: "eklendi", metin: "Güvenlik Paneli: on aracın grafik arayüzü, alan açıklamaları ve canlı çıktı" },
      { tur: "eklendi", metin: "Karşılama Sihirbazı: on bir sayfalık iki dilli tanıtım, tema ve dil seçimi" },
      { tur: "eklendi", metin: "Sistem Sağlığı: altı kategoride yirmi denetim, sağlık puanı, on iki tek tık düzeltme" },
      { tur: "eklendi", metin: "USB Denetimi: bağlanan aygıtta autorun.inf, çift uzantı ve gizlenmiş uzantı denetimi" },
      { tur: "eklendi", metin: "BIOS ve UEFI kurulumu, Secure Boot için imzalı shim" },
      { tur: "eklendi", metin: "Wi-Fi, ses ve grafik donanımı için tam firmware paketi" },
      { tur: "eklendi", metin: "Türkçe varsayılan dil, İngilizce seçeneği" },
      { tur: "duzeltildi", metin: "nikto kurulumda çalışmıyordu; bağımlılık eksikliği giderildi" },
      { tur: "duzeltildi", metin: "Sihirbazda seçilen dil oturum sonrası uygulanmıyordu" },
      { tur: "duzeltildi", metin: "Panel ve menü simgeleri bazı temalarda görünmüyordu" },
    ],
  },
];

const etiketler: Record<string, string> = {
  eklendi: "Eklendi",
  duzeltildi: "Düzeltildi",
  degisti: "Değişti",
  kaldirildi: "Kaldırıldı",
};
---

<Base
  lang="tr"
  title="Sürüm notları — CarotOS"
  description="CarotOS sürümlerinde neyin değiştiği: eklenen araçlar, düzeltilen hatalar, geriye dönük uyumsuzluklar."
>
  <section class="band band--foam log__intro">
    <div class="wrap">
      <p class="eyebrow">Sürüm notları</p>
      <h1 class="log__h1">Neler değişti</h1>
      <p class="lede">
        Her sürümde eklenen araçlar, düzeltilen hatalar ve geriye dönük
        uyumsuzluklar burada listelenir. Aynı notlar GitHub sürüm sayfasında da
        yayımlanır.
      </p>
      <div class="log__links">
        <a class="btn btn--ghost" href="/#indir">İndirme</a>
        <a
          class="btn btn--ghost"
          href="https://github.com/MiracLight/CarotOS/releases"
          target="_blank"
          rel="noopener noreferrer">GitHub sürümleri</a
        >
      </div>
    </div>
  </section>

  <Wave from="#f4f9fd" to="#deedf8" />

  <section class="band band--shallow">
    <div class="wrap">
      {
        surumler.map((s) => (
          <article class="rel">
            <header class="rel__head">
              <h2 class="rel__tag">
                {s.etiket} <span class="rel__code">“{s.kodAdi}”</span>
              </h2>
              <time class="rel__date mono" datetime={s.tarihISO}>
                {s.tarih}
              </time>
            </header>

            <p class="rel__ozet">{s.ozet}</p>

            <ul class="rel__list">
              {s.degisiklikler.map((d) => (
                <li class="rel__item">
                  <span class={`tag tag--${d.tur}`}>{etiketler[d.tur]}</span>
                  <span class="rel__text">{d.metin}</span>
                </li>
              ))}
            </ul>
          </article>
        ))
      }

      <p class="log__son">
        Daha eski sürüm yok — 1.0 ilk kararlı yayın. Geliştirme sürecindeki
        ara yapılar yayımlanmadı.
      </p>
    </div>
  </section>
</Base>

<style>
  .log__intro {
    padding-bottom: clamp(3rem, 6vw, 4rem);
  }

  .log__h1 {
    font-size: clamp(2.4rem, 6vw, 4rem);
    margin-bottom: 1.1rem;
  }

  .log__links {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
    margin-top: 2rem;
  }

  .rel {
    max-width: 78ch;
  }

  .rel + .rel {
    margin-top: 3.5rem;
    padding-top: 3.5rem;
    border-top: 1.5px solid rgba(24, 95, 165, 0.2);
  }

  .rel__head {
    display: flex;
    align-items: baseline;
    gap: 1rem 1.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.9rem;
  }

  .rel__tag {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    margin: 0;
  }

  .rel__code {
    color: var(--current);
    font-weight: 700;
  }

  .rel__date {
    color: var(--ink-faint);
    font-size: 0.85rem;
  }

  .rel__ozet {
    color: var(--ink-soft);
    font-size: 1.02rem;
    margin-bottom: 1.8rem;
    max-width: var(--w-text);
  }

  .rel__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.7rem;
  }

  .rel__item {
    display: grid;
    grid-template-columns: 92px 1fr;
    gap: 0.9rem;
    align-items: baseline;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid rgba(24, 95, 165, 0.13);
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-align: center;
    padding: 0.24rem 0.4rem;
    border-radius: 4px;
    white-space: nowrap;
  }

  .tag--eklendi {
    background: rgba(74, 156, 120, 0.16);
    color: #2f6f52;
  }

  .tag--duzeltildi {
    background: rgba(55, 138, 218, 0.16);
    color: var(--deep);
  }

  .tag--degisti {
    background: rgba(24, 95, 165, 0.1);
    color: var(--ink-soft);
  }

  .tag--kaldirildi {
    background: rgba(160, 90, 90, 0.14);
    color: #8a4646;
  }

  .rel__text {
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .log__son {
    margin-top: 3rem;
    font-size: 0.88rem;
    color: var(--ink-faint);
  }

  @media (max-width: 560px) {
    .rel__item {
      grid-template-columns: 1fr;
      gap: 0.3rem;
    }

    .tag {
      justify-self: start;
    }
  }
</style>
