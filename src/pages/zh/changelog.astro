const etiketler: Record<string, string> = {
  eklendi: "新增",
  duzeltildi: "修复",
  degisti: "变更",
  kaldirildi: "移除",
};
---

<Base
  lang="zh"
  title="更新日志 | CarotOS"
  description="CarotOS 每个版本的变化：新增的工具、修复的错误、不向后兼容的变更。"
>
  <section class="band band--foam log__intro">
    <div class="wrap">
      <p class="eyebrow">更新日志</p>
      <h1 class="log__h1">有什么变化</h1>
      <p class="lede">
        这里列出每个版本新增的工具、修复的错误和不向后兼容的变更。相同的说明也发布在 GitHub 的发布页面上。
      </p>
      <div class="log__links">
        <a class="btn btn--ghost" href="/zh#download">下载</a>
        <a
          class="btn btn--ghost"
          href="https://github.com/MiracLight/CarotOS/releases"
          target="_blank"
          rel="noopener noreferrer">GitHub 发布页面</a
        >
      </div>
    </div>
  </section>

  <Wave from="#f4f9fd" to="#deedf8" />

  <section class="band band--shallow">
    <div class="wrap">
      {
        surumler.map((s) => (
          <article class="rel">
            <header class="rel__head">
              <h2 class="rel__tag">
                {s.etiket} <span class="rel__code">“{s.kodAdi}”</span>
              </h2>
              <time class="rel__date mono" datetime={s.tarihISO}>
                {s.tarih}
              </time>
            </header>

            <p class="rel__ozet">{s.ozet}</p>

            <ul class="rel__list">
              {s.degisiklikler.map((d) => (
                <li class="rel__item">
                  <span class={`tag tag--${d.tur}`}>{etiketler[d.tur]}</span>
                  <span class="rel__text">{d.metin}</span>
                </li>
