    icon: "/ikonlar/ikon-filenor.webp",
    yeni: "1.3",
    text: "一个转换器，在同一个界面中转换图片、音频、视频、文档、电子表格、演示文稿和字体文件。它可以合并、拆分、旋转、压缩和加密 PDF 文件，并对扫描文档进行文字识别（OCR）。它绝不会覆盖已有文件，并提供命令行版本。CarotOS 已预装它，也可以下载用于 Debian、Ubuntu 和 Windows 的版本。",
    links: [
      { label: "下载 Filenor（.deb 和 Windows .exe）", url: "https://github.com/MiracLight/filenor/releases/latest" },
      { label: "源代码", url: "https://github.com/MiracLight/filenor" },
    ],
  },
  {
    title: "CarotOS Former",
    icon: "/ikonlar/ikon-former.webp",
    yeni: "1.3",
    text: "用动画讲解安全工具的指南。安全面板中的每个工具，以及 CarotPot 和 Carotene，都配有说明、可播放的动画和“自己动手试试”部分。其中包含 CTF 比赛、命令解释器、道德、磁盘加密、ISO 验证和防守视角等主题。支持十一种语言。",
  },
  {
    title: "CarotOS GSD",
    icon: "/ikonlar/ikon-gsd.webp",
    yeni: "1.3",
    text: "通用系统词典（General System Dictionary），收录 197 个关于 Linux、网络、网络安全、密码学和计算机科学的术语。可以搜索术语、查看示例命令并跳转到相关术语。提供十一种语言。",
  },
];

const poligonApps = [
  {
    title: "CarotOS Poligon",
    icon: "/ikonlar/ikon-poligon-ogrenci.webp",
    screenshot: "/ekranlar/poligon-ogrenci.webp",
    alt: "CarotOS Poligon 学生端应用：访客、创建账户和登录选项",
    text: "可以不需要账户，以访客身份使用，也可以用用户账户登录。登录账户的进度会被保存。任务可以单独完成，也可以加入课堂房间一起完成。",
  },
  {
    title: "CarotOS Poligon 教师版",
    icon: "/ikonlar/ikon-poligon-ogretmen.webp",
    screenshot: "/ekranlar/poligon-ogretmen.webp",
    alt: "CarotOS Poligon 教师端应用：房间代码、房间密码、学生列表和提示输入框",
    text: "一键生成房间代码和密码。学生和班级视图、出题以及已保存的题目位于不同的标签页。提示可以发给单个学生，也可以发给全班。",
  },
];

const securityApps = [
  {
    title: "CarotPot",
    icon: "/ikonlar/ikon-carotpot.webp",
    screenshot: "/ekranlar/carotpot.webp",
    ratio: "1280 / 820",
    alt: "CarotPot 仪表板：陷阱已开启、每小时活动图表、各陷阱的事件数、最活跃的攻击者和实时动态",
    text: "检测本地网络中扫描这台电脑或尝试登录它的设备。它开放八个虚假服务：SSH、Web 面板、Telnet、FTP、VNC、RDP、MySQL 和 Redis。仪表板显示最近 24 小时的活动和最活跃的攻击者。攻击者档案列出尝试过的用户名、已遮蔽的密码和风险评分。封锁设备前会征求你的确认。",
  },
  {
    title: "Carotene",
    icon: "/ikonlar/ikon-carotene.webp",
    screenshot: "/ekranlar/carotene.webp",
    ratio: "1040 / 700",
    alt: "Carotene：扫描结果，发现两个威胁，并显示病毒库的更新时间和扫描选项",
    text: "使用 ClamAV 运行快速扫描、主文件夹扫描和自定义文件夹扫描。扫描进行时，已扫描文件数和发现会实时更新。发现的文件可以隔离、删除或忽略。病毒库的更新时间显示在主界面上，可在应用内更新。结果干净并不保证文件安全，只表示没有发现已知特征。",
  },
];

const tools = [
  { name: "nmap", job: "网络和端口扫描" },
  { name: "tcpdump", job: "数据包捕获" },
  { name: "tshark", job: "流量分析" },
  { name: "aircrack-ng", job: "无线网络测试" },
  { name: "nikto", job: "Web 服务器扫描" },
  { name: "sqlmap", job: "SQL 注入测试" },
  { name: "john", job: "密码强度分析" },
  { name: "hydra", job: "认证测试" },
  { name: "ufw", job: "防火墙" },
  { name: "fail2ban", job: "入侵防御" },
];
---

<Base
  lang="zh"
  title="CarotOS | 学习网络安全的 Linux 发行版"
  description="基于 Debian 13、面向教学的 Linux 发行版，内置十款安全工具和十三个原创应用。"
>
  {/* ============================================================
      HERO
      ============================================================ */}
  <section class="band band--foam hero">
    <div class="wrap hero__inner">
      <div class="hero__text">
        <p class="eyebrow">Debian 13 · XFCE · amd64</p>
        <h1>少而精，讲透彻。</h1>
        <p class="lede hero__lede">
          CarotOS 是为网络安全教学打造的 Linux 发行版，内置十款安全工具和十三个为本项目编写的应用。
        </p>

        <div class="hero__actions">
          <a class="btn btn--solid" href="#download">
            <span>下载</span>
            <span class="hero__size">{release.size}</span>
          </a>
          <a
            class="btn btn--ghost"
            href="https://github.com/MiracLight/CarotOS"
            target="_blank"
            rel="noopener noreferrer">源代码</a
          >
        </div>
      </div>

      <div class="hero__art" aria-hidden="true">
        <span class="ripple ripple--1"></span>
        <span class="ripple ripple--2"></span>
        <span class="ripple ripple--3"></span>
        <div class="hero__turtle" data-minigame-trigger>
          <Turtle shell="#378ADA" body="#185FA5" />
        </div>
      </div>
    </div>

    <div class="wrap">
      <dl class="facts">
        {
          facts.map((f) => (
            <div class="facts__item">
              <dt class="facts__num">{f.num}</dt>
              <dd class="facts__label">{f.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <Wave from="#f4f9fd" to="#deedf8" />

  {/* ============================================================
      PHILOSOPHY
      ============================================================ */}
  <section id="philosophy" class="band band--shallow">
    <div class="wrap">
      <p class="eyebrow">理念</p>
      <h2 class="sec__title">范围与设计原则</h2>
      <p class="lede sec__lede">
        CarotOS 不是那些自带庞大工具集的发行版的替代品。它在 Debian 安装的基础上增加十款工具和操作它们的界面。目标不是堆高工具数量，而是打造一个能在课堂上正常使用的基础系统。
      </p>

      <div class="grid grid--2 sec__grid">
        {
          philosophy.map((p) => (
            <article class="card">
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <Wave from="#deedf8" to="#a9cfea" />

  {/* ============================================================
      WHAT'S INSIDE
      ============================================================ */}
  <section id="inside" class="band band--tide">
    <div class="wrap">
      <p class="eyebrow">应用</p>
      <h2 class="sec__title">应用与工具</h2>
      <p class="lede sec__lede">
        为本项目用 Python 和 GTK3 编写的十三个应用，以 GPL-3.0 协议发布。
      </p>

      <div class="grid grid--2 sec__grid">
        {
          apps.map((a, i) => (
            <article class="card app">
              {a.icon ? (
                <img
                  class="app__logo"
                  src={a.icon}
                  alt=""
                  width="44"
                  height="44"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <span class="app__no">{String(i + 1).padStart(2, "0")}</span>
              )}
              <div>
                <h3>
                  {a.title}
                  {a.yeni && <span class="app__tag">{a.yeni}</span>}
                </h3>
                <p>{a.text}</p>
                {a.links && (
                  <p class="app__links">
                    {a.links.map((l) => (
                      <a href={l.url} rel="noopener">{l.label}</a>
                    ))}
                  </p>
                )}
              </div>
            </article>
          ))
        }
      </div>

      <div class="tools">
        <h3 class="tools__title">预装工具</h3>
        <ul class="tools__list">
          {
            tools.map((t) => (
              <li class="tool">
                <span class="tool__hex" aria-hidden="true" />
                <span class="tool__name">{t.name}</span>
                <span class="tool__job">{t.job}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="gorseller">
        <h3 class="tools__title">截图</h3>
        <Slayt lang="zh" slaytlar={slides} />
      </div>

      <div class="poligon">
        <h3 class="tools__title">CarotOS Poligon</h3>
        <p class="lede poligon__lede">
          为学生和教师提供的隔离、安全的渗透测试环境。教师创建课堂房间，学生在自己的电脑上用真实工具完成任务。没有暴露在网络上的组件，所有操作都在本机运行。
        </p>
        <div class="grid grid--2 poligon__grid">
          {
            poligonApps.map((p) => (
              <article class="card poligon__card">
                <div class="poligon__head">
                  <img src={p.icon} alt="" class="poligon__ikon" width="40" height="40" />
                  <h4>{p.title}</h4>
                </div>
                <p>{p.text}</p>
                <div class="poligon__ekran-cerceve">
                  <img
                    src={p.screenshot}
                    alt={p.alt}
                    class="poligon__ekran"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              </article>
            ))
          }
        </div>
      </div>

      <div class="poligon">
        <h3 class="tools__title">CarotPot 与 Carotene</h3>
        <p class="lede poligon__lede">
          两个用于网络和文件安全的应用。CarotPot 用虚假服务捕捉本地网络中的扫描和登录尝试。Carotene 用 ClamAV 扫描文件。除非你启动，否则两者都不会在后台运行。
        </p>
        <div class="grid grid--2 poligon__grid">
          {
            securityApps.map((p) => (
              <article class="card poligon__card">
                <div class="poligon__head">
                  <img src={p.icon} alt="" class="poligon__ikon" width="40" height="40" />
                  <h4>{p.title}</h4>
                </div>
                <p>{p.text}</p>
                <div class="poligon__ekran-cerceve" style={`aspect-ratio: ${p.ratio}`}>
                  <img
                    src={p.screenshot}
                    alt={p.alt}
                    class="poligon__ekran"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <Wave from="#a9cfea" to="#185fa5" />

  {/* ============================================================
      DOWNLOAD
      ============================================================ */}
  <section id="download" class="band band--deep">
    <div class="wrap">
      <p class="eyebrow">下载</p>
      <h2 class="sec__title">版本 {release.tag} “{release.codename}”</h2>
      <p class="lede sec__lede">
        直接在 Live 桌面上点击“安装 CarotOS”图标即可安装。BIOS 和 UEFI 安装均已测试。ISO 中附带已签名的 shim，支持安全启动（Secure Boot）。还包含 Wi-Fi、音频和显卡硬件所需的固件包。
      </p>

      <div class="dl">
        <article class="dl__card">
          <div class="dl__head">
            <div>
              <p class="dl__arch">桌面版</p>
              <p class="dl__isa mono">x86_64</p>
            </div>
            <span class="dl__badge">稳定版 · {release.codename}</span>
          </div>

          <ul class="dl__meta">
            <li><span>文件</span><span class="mono">{release.file}</span></li>
            <li><span>大小</span><span class="mono">{release.size}</span></li>
            <li><span>桌面环境</span><span>XFCE</span></li>
            <li><span>发布日期</span><span>{release.date}</span></li>
          </ul>

          <a class="btn btn--light dl__btn" href={release.url}>
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M12 3v13m0 0 5-5m-5 5-5-5M4 20h16"
                stroke="currentColor"
                stroke-width="2.1"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
            <span>下载 ISO</span>
          </a>

          <div class="verify">
            <p class="verify__hash">
              <span class="verify__hash-label">SHA-256</span>
              <code>{release.sha256}</code>
            </p>
            <a class="verify__link" href={release.shaUrl}
              >{release.file}.sha256</a
            >
          </div>
        </article>

        <div class="dl__yan">
          <div class="req">
            <p class="dl__soon-title">系统要求</p>
            <ul class="req__list">
              {
                requirements.map((r) => (
                  <li>
                    <span>{r.name}</span>
                    <span>{r.value}</span>
                  </li>
                ))
              }
            </ul>
            <p class="req__not">
              这是 Debian 13 “trixie” 桌面安装的建议最低配置。XFCE 比 GNOME 或 KDE Plasma 占用的资源更少。Debian 13 不再支持 i386 架构。
            </p>
          </div>

          <div class="dl__soon">
          <p class="dl__soon-title">计划中的项目</p>

          <article class="soon">
            <div>
              <p class="soon__arch">CarotOS AUL</p>
              <p class="soon__isa mono">arm64</p>
            </div>
            <p class="soon__note">
              基于 Armbian 的轻量版本（Armbian Ultra Light）。在 Orange Pi 5 等 arm64 开发板上运行 IceWM。空闲内存占用目标为 200 MB。
            </p>
            <span class="soon__tag">开发中</span>
          </article>

            <p class="dl__soon-foot">
              便携硬件项目 CarotDeck 将在之后推出。
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Wave from="#185fa5" to="#0b2e52" />

  {/* ============================================================
      RELEASES / NEWSLETTER
      ============================================================ */}
  <section id="releases" class="band band--abyss news">
    <div class="wrap">
      <p class="eyebrow">版本发布</p>
      <h2 class="sec__title">版本发布通知</h2>
      <p class="lede sec__lede">
        发布说明在 GitHub 上发布：新增的工具、修复的错误、不向后兼容的变更。
      </p>

      <div class="news__grid">
        <div class="news__card news__card--wide">
          <h3>电子邮件通讯</h3>
          <p>
            通过电子邮件发送发布说明。邮箱地址不会用于其他任何用途。
          </p>

          <div class="sub__frame">
            <iframe
              src="https://67633d94.sibforms.com/v2/serve/MUIFAGmcZ6uZ8ACuV_vY5RZNYRnoRnMLIWTNt8PXoCujQnM0CA3Uf1SLr7wMqEJeSE78095pYIsM1mixN7-ftp9CVz4JEgXivRME_UO6L_0MSsc13UC0SCaD33HOpUUWlRCV-F-mHG0Y1Qug40xaa3yI0V5_S0aLMdzqXrzlXVQzY_uarxTztLRgaX_9d1MPCyOlHgaUFnaVYrSxtQ=="
              title="新闻邮件订阅表单"
              loading="lazy"
              scrolling="no"
              frameborder="0"></iframe>
          </div>
          <p class="sub__note">您的邮箱仅用于发布新闻。点击收到邮件中的链接后即完成订阅；每封邮件都附有退订链接。邮件通过 Brevo 发送。</p>
        </div>

        <div class="news__card">
          <h3>GitHub</h3>
          <p>
            在仓库中选择 <strong>Watch → Custom → Releases</strong>，每次发布都会收到通知。
          </p>
          <a
            class="btn btn--outline-light news__btn"
            href="https://github.com/MiracLight/CarotOS/releases"
            target="_blank"
            rel="noopener noreferrer">发布页面</a
          >
        </div>

        <div class="news__card">
          <h3>RSS / Atom</h3>
          <p>
            可以将发布订阅源直接添加到阅读器中，无需注册。
          </p>
          <a
            class="btn btn--outline-light news__btn"
            href="https://github.com/MiracLight/CarotOS/releases.atom"
            target="_blank"
            rel="noopener noreferrer">订阅源地址</a
          >
        </div>
      </div>

      <p class="news__last">
        最新版本 <strong>{release.tag}</strong> — {release.date}
      </p>
    </div>
  </section>
  <Minigame lang="zh" />
</Base>
